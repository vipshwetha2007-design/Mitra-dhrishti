7\215. \340\256\265\340\256\277\340\256\264\340\256\277\340\256\244\340\257\215\340\256\244\340\256\277\340\256\260\340\257\210 \340\256\252\340\256\260\340\256\277\340\256\232\340\257\213\340\256\244\340\256\251\340\257\210\340\256\257\340\257\210 \340\256\206\340\256\244\340\256\260\340\256\277\340\256\225\340\257\215\340\256\225\340\256\265\340\257\201\340\256\256\340\257\215. \340\256\244\340\257\212\340\256\237\340\256\260\340\257\215 \340\256\252\340\256\260\340\256\276\340\256\256\340\256\260\340\256\277\340\256\252\340\257\215\340\256\252\340\257\210\340\256\252\340\257\215 \340\256\252\340\256\276\340\256\244\340\257\201\340\256\225\340\256\276\340\256\225\340\257\215\340\256\225\340\256\265\340\257\201\340\256\256\340\257\215.\',\\n      exploreCta: \'\340\256\211\340\256\231\340\257\215\340\256\225\340\256\263\340\257\215 \340\256\250\340\256\262\340\256\251\340\257\210 \340\256\206\340\256\260\340\256\276\340\256\257\340\257\215\340\256\225\',\\n    },\\n    pillars: {\\n      preventTitle: \'\340\256\244\340\256\237\340\257\201\340\256\252\340\257\215\340\256\252\340\257\201 \302\267 PREVENT\',\\n      preventDesc: \'\340\256\250\340\257\200\340\256\260\340\256\277\340\256\264\340\256\277\340\256\265\340\257\201 \340\256\265\340\256\276\340\256\264\340\257\215\340\256\225\340\257\215\340\256\225\340\257\210\340\256\256\340\257\201\340\256\261\340\257\210 \340\256\205\340\256\252\340\256\276\340\256\257 \340\256\256\340\257\207\340\256\262\340\256\276\340\256\243\340\257\215\340\256\256\340\257\210\',\\n      detectTitle: \'\340\256\225\340\256\243\340\257\215\340\256\237\340\256\261\340\256\277\340\256\244\340\256\262\340\257\215 \302\267 DETECT\',\\n      detectDesc: \'AI \340\256\211\340\256\244\340\256\265\340\256\277 \340\256\265\340\256\277\340\256\264\340\256\277\340\256\244\340\257\215\340\256\244\340\256\277\340\256\260\340\257\210 \340\256\252\340\256\260\340\256\277\340\256\232\340\257\213\340\256\244\340\256\251\340\257\210\',\\n      protectTitle: \'\340\256\252\340\256\276\340\256\244\340\257\201\340\256\225\340\256\276\340\256\252\340\257\215\340\256\252\340\257\201 \302\267 PROTECT\',\\n      protectDesc: \'\340\256\256\340\256\260\340\257\201\340\256\244\340\257\215\340\256\244\340\257\201\340\256\265\340\256\260\340\257\215 \340\256\256\340\256\244\340\256\277\340\256\252\340\257\215\340\256\252\340\256\276\340\256\257\340\257\215\340\256\265\340\257\201 & \340\256\252\340\256\277\340\256\251\340\257\215\340\256\244\340\257\212\340\256\237\340\256\260\340\257\215\340\256\244\340\256\262\340\257\215\',\\n    },\\n  },\\n  // Hindi architecture ready \342\200\224 falls back cleanly to English strings until clinical Tamil/Hindi localization review completes\\n  hi: {\\n    appTagline: \'\340\244\260\340\245\213\340\244\225\340\244\245\340\244\276\340\244\256 \342\200\242 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250 \342\200\242 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\\n    clinicalBoundaryShort:\\n      \'\340\244\257\340\244\271 \340\244\225\340\245\207\340\244\265\340\244\262 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\270\340\245\215\340\244\245\340\245\215\340\244\257 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250\340\244\277\340\244\202\340\244\227 \340\244\224\340\244\260 \340\244\246\340\245\207\340\244\226\340\244\255\340\244\276\340\244\262 \340\244\270\340\244\271\340\244\276\340\244\257\340\244\244\340\244\276 \340\244\252\340\245\215\340\244\260\340\245\213\340\244\237\340\245\213\340\244\237\340\244\276\340\244\207\340\244\252 \340\244\271\340\245\210 \342\200\224 \340\244\250\340\245\210\340\244\246\340\244\276\340\244\250\340\244\277\340\244\225 \340\244\250\340\244\277\340\244\246\340\244\276\340\244\250 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\225\340\244\262\340\245\215\340\244\252 \340\244\250\340\244\271\340\245\200\340\244\202\340\245\244 (Hindi loca