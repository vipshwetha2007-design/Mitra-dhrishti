      id: "call_15114369306807100176"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nimport { useCallback, useEffect, useState } from \'react\';\\nimport { registerSW } from \'virtual:pwa-register\';\\nimport { TRANSLATIONS } from \'./i18n/translations\';\\nimport { cachePermittedSnapshot } from \'./offline/db\';\\nimport {\\n  createIdempotencyKey,\\n  enqueueOfflineAction,\\n  getPendingActions,\\n  synchronizePendingQueue,\\n} from \'./offline/syncEngine\';\\nimport { evaluateClientExperimentalRisk } from \'./utils/riskEngine\';\\nimport type {\\n  AppointmentRecord,\\n  AppNavView,\\n  BootstrapPayload,\\n  DoctorReview,\\n  FollowUpRecord,\\n  LanguageCode,\\n  LifestyleAssessment,\\n  LifestyleInput,\\n  ReferralRecord,\\n  RetinalScreening,\\n  UserRole,\\n} from \'./types/domain\';\\nimport { AuthModal } from \'./components/AuthModal\';\\nimport { Sidebar } from \'./components/Sidebar\';\\nimport { TopBar } from \'./components/TopBar\';\\nimport { AdminDashboard } from \'./views/AdminDashboard\';\\nimport { DetectModule } from \'./views/DetectModule\';\\nimport { DoctorDashboard } from \'./views/DoctorDashboard\';\\nimport { OfflineSyncView } from \'./views/OfflineSyncView\';\\nimport { PatientDashboard } from \'./views/PatientDashboard\';\\nimport { PreventModule } from \'./views/PreventModule\';\\nimport { ProtectModule } from \'./views/ProtectModule\';\\nimport { ReportsView } from \'./views/ReportsView\';\\nimport { NotificationsView, SettingsView } from \'./views/SettingsAndNotificationsView\';\\nimport { SimulinkAnalyticsView } from \'./views/SimulinkAnalyticsView\';\\n\\nexport default function App() {\\n  // Security: Bearer token stored strictly in React memory (never in localStorage/sessionStorage)\\n  const [token, setToken] = useState<string | null>(null);\\n  const [data, setData] = useState<BootstrapPayload | null>(null);\\n  const [loading, setLoading] = useState(true);\\n  const [fatalError, setFatalError] = useState<string | null>(null);\\n\\n  const [activeView, setActiveView] = useState<AppNavView>(\'dashboard\');\\n  const [selectedPatientId, setSelectedPatientId] = useState<string>(\'pat-1\');\\n  const [language, setLanguage] = useState<LanguageCode>(\'en\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);\\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\\n  const [authModalOpen, setAuthModalOpen] = useState(false);\\n\\n  // Offline-first connectivity & queue state\\n  const [browserOnline, setBrowserOnline] = useState(\\n    typeof navigator !== \'undefined\' ? navigator.onLine : true\\n  );\\n  const [simulateOffline, setSimulateOffline] = useState(false);\\n  const [pendingSyncCount, setPendingSyncCount] = useState(0);\\n  const [syncTick, setSyncTick] = useState(0);\\n  const [toast, setToast] = useState<string | null>(null);\\n\\n  const isOnline = browserOnline && !simulateOffline;\\n  const t = TRANSLATIONS[language];\\n\\n  const showToast = useCallback((message: string) => {\\n    setToast(message);\\n    window.setTimeout(() => {\\n      setToast((prev) => (prev === message ? null : prev));\\n    }, 4500);\\n  }, []);\\n\\n  // Register PWA Service Worker\\n  useEffect(() => {\\n    try {\\n      registerSW({ immediate: true });\\n    } catch {\\n      // Service worker optional in restricted preview frames\\n    }\\n  }, []);\\n\\n  // Browser online/offline event listeners\\n  useEffect(() => {\\n    const onOnline = () => setBrowserOnline(true);\\n    const onOffline = () => setBrowserOnline(false);\\n    window.addEventListener(\'online\', onOnline);\\n    window.addEventListener(\'offline\', onOffline);\\n    return () => {\\n      window.removeEventListener(\'online\', onOnline);\\n      window.removeEventListener(\'offline\', onOffline);\\n    };\\n  }, []);\\n\\n  const refreshPendingCount = useCallback(async () => {\\n    const items = await getPendingActions();\\n    setPendingSyncCount(items.length);\\n    setSyncTick((n) => n + 1);\\n  }, []);\\n\\n  const fetchBootstrap = useCallback(async (authToken: string) => {\\n    const res = await fetch(\'/api/bootstrap\', {\\n      headers: { Authorization: `Bearer ${authToken}` },\\n    });\\n    if (!res.ok) {\\n      const err = await res.json().catch(() => ({ error: \'Failed to load workspace\' }));\\n      throw new Error(err.error || \'Failed to load workspace\');\\n    }\\n    const payload = (await res.json()) as BootstrapPayload;\\n    setData(payload);\\n    if (payload.patients.length > 0) {\\n      setSelectedPatientId((prev) =>\\n        payload.patients.some((p) => p.id === prev) ? prev : payload.patients[0].id\\n      );\\n    }\\n    await cachePermittedSnapshot({\\n      patients: payload.patients,\\n      assessments: payload.assessments,\\n      habitLogs: payload.habitLogs,\\n      screenings: payload.screenings,\\n    });\\n    await refreshPendingCount();\\n    return payload;\\n  }, [refreshPendingCount]);\\n\\n  // Authenticated helper for API requests\\n  const apiFetch = useCallback(\\n    async <T,>(url: string, options?: RequestInit): Promise<T> => {\\n      if (!token) throw new Error(\'No active authenticated session.\');\\n      const res = await fetch(url, {\\n        ...options,\\n        headers: {\\n          \'Content-Type\': \'application/json\',\\n          Authorization: `Bearer ${token}`,\\n          ...(options?.headers || {}),\\n        },\\n      });\\n      const body = await res.json().catch(() => ({}));\\n      if (!res.ok) {\\n        throw new Error(body.error || `Request failed (${res.status})`);\\n      }\\n      return body as T;\\n    },\\n    [token]\\n  );\\n\\n  // Initialize default synthetic Patient demo session on startup\\n  useEffect(() => {\\n    let active = true;\\n    (async () => {\\n      setLoading(true);\\n      setFatalError(null);\\n      try {\\n        const res = await fetch(\'/api/auth/demo-session\', {\\n          method: \'POST\',\\n          headers: { \'Content-Type\': \'application/json\' },\\n          body: JSON.stringify({ role: \'patient\' }),\\n        });\\n        if (!res.ok) throw new Error(\'Unable to initialize prototype session\');\\n        const auth = (await res.json()) as { token: string };\\n        if (!active) return;\\n        setToken(auth.token);\\n        await fetchBootstrap(auth.token);\\n      } catch (err) {\\n        if (!active) return;\\n        setFatalError(err instanceof Error ? err.message : \'Unable to connect to Mritidhristi API\');\\n      } finally {\\n        if (active) setLoading(false);\\n      }\\n    })();\\n    return () => {\\n      active = false;\\n    };\\n  }, [fetchBootstrap]);\\n\\n  const handleSyncNow = useCallback(async (): Promise<string> => {\\n    if (!token) return \'Sign in required to synchronize.\';\\n    if (!isOnline) return \'Currently offline \342\200\224 pending actions remain safely queued in IndexedDB.\';\\n    const res = await synchronizePendingQueue(token);\\n    await fetchBootstrap(token);\\n    showToast(res.message);\\n    return res.message;\\n  }, [token, isOnline, fetchBootstrap, showToast]);\\n\\n  // Auto-synchronize when connectivity is restored and pending actions exist\\n  useEffect(() => {\\n    if (isOnline && token && pendingSyncCount > 0) {\\n      void handleSyncNow();\\n    }\\n  }, [isOnline, token, pendingSyncCount, handleSyncNow]);\\n\\n  // Auth handlers\\n  const handleSwitchDemoRole = async (role: UserRole) => {\\n    const res = await fetch(\'/api/auth/demo-session\', {\\n      method: \'POST\',\\n      headers: { \'Content-Type\': \'application/json\' },\\n      body: JSON.stringify({ role }),\\n    });\\n    const body = await res.json();\\n    if (!res.ok) throw new Error(body.error || \'Role switch failed\');\\n    setToken(body.token);\\n    await fetchBootstrap(body.token);\\n    setActiveView(\'dashboard\');\\n    showToast(`Switched to ${body.user.name} (${body.user.role}).`);\\n  };\\n\\n  const handleLogin = async (email: string, password: string) => {\\n    const res = await fetch(\'/api/auth/login\', {\\n      method: \'POST\',\\n      headers: { \'Content-Type\': \'application/json\' },\\n      body: JSON.stringify({ email, password }),\\n    });\\n    const body = await res.json();\\n    if (!res.ok) throw new Error(body.error || \'Login failed\');\\n    setToken(body.token);\\n    await fetchBootstrap(body.token);\\n    setActiveView(\'dashboard\');\\n    showToast(`Signed in as ${body.user.name}.`);\\n  };\\n\\n  const handleRegisterAccount = async (payload: {\\n    name: string;\\n    email: string;\\n    password: string;\\n    role: UserRole;\\n    language: LanguageCode;\\n  }) => {\\n    const res = await fetch(\'/api/auth/register\', {\\n      method: \'POST\',\\n      headers: { \'Content-Type\': \'application/json\' },\\n      body: JSON.stringify(payload),\\n    });\\n    const body = await res.json();\\n    if (!res.ok) throw new Error(body.error || \'Registration failed\');\\n    setToken(body.token);\\n    setLanguage(payload.language);\\n    await fetchBootstrap(body.token);\\n    setActiveView(\'dashboard\');\\n    showToast(`Account created for ${body.user.name}.`);\\n  };\\n\\n  // Pillar 1: Prevent handlers (Offline-capable!)\\n  const handleSubmitAssessment = async (patientId: string, inputs: LifestyleInput) => {\\n    if (!isOnline) {\\n      const idempotencyKey = createIdempotencyKey(\'asm\');\\n      const localEval = evaluateClientExperimentalRisk(inputs);\\n      await enqueueOfflineAction({\\n        idempotencyKey,\\n        type: \'LIFESTYLE_ASSESSMENT\',\\n        patientId,\\n        summary: `Lifestyle Assessment (Experimental Score ${localEval.experimentalScore}/100 \302\267 ${localEval.riskCategory})`,\\n        payload: { patientId, ...inputs },\\n        createdAt: new Date().toISOString(),\\n      });\\n      const localRecord: LifestyleAssessment = {\\n        id: `offline-${idempotencyKey}`,\\n        patientId,\\n        assessedAt: new Date().toISOString(),\\n        inputs,\\n        experimentalScore: localEval.experimentalScore,\\n        riskCategory: localEval.riskCategory,\\n        scoringModelLabel: localEval.scoringModelLabel,\\n        contributions: localEval.contributions,\\n        topModifiableFactors: localEval.topModifiableFactors,\\n        explanation: localEval.explanation,\\n        recommendations: localEval.recommendations,\\n        recordedOffline: true,\\n        syncStatus: \'pending\',\\n        idempotencyKey,\\n      };\\n      setData((prev) =>\\n        prev ? { ...prev, assessments: [localRecord, ...prev.assessments] } : prev\\n      );\\n      await refreshPendingCount();\\n      showToast(\'Saved lifestyle assessment offline to IndexedDB queue.\');\\n      return;\\n    }\\n\\n    await apiFetch(\'/api/prevent/assessments\', {\\n      method: \'POST\',\\n      body: JSON.stringify({ patientId, ...inputs }),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleSubmitHabit = async (payload: {\\n    patientId: string;\\n    date: string;\\n    healthyIndianDiet: boolean;\\n    stepsAchieved: number;\\n    sleepHours: number;\\n    weightKg?: number;\\n    waistCm?: number;\\n    barrierReported?: string;\\n  }) => {\\n    if (!isOnline) {\\n      const idempotencyKey = createIdempotencyKey(\'hab\');\\n      await enqueueOfflineAction({\\n        idempotencyKey,\\n        type: \'HABIT_LOG\',\\n        patientId: payload.patientId,\\n        summary: `Habit Check-in (${payload.date} \302\267 ${payload.stepsAchieved} steps \302\267 ${payload.sleepHours}h sleep)`,\\n        payload,\\n        createdAt: new Date().toISOString(),\\n      });\\n      setData((prev) =>\\n        prev\\n          ? {\\n              ...prev,\\n              habitLogs: [\\n                {\\n                  id: `offline-${idempotencyKey}`,\\n                  ...payload,\\n                  recordedOffline: true,\\n                  syncStatus: \'pending\',\\n                  idempotencyKey,\\n                },\\n                ...prev.habitLogs,\\n              ],\\n            }\\n          : prev\\n      );\\n      await refreshPendingCount();\\n      showToast(\'Queued daily habit log in Dexie IndexedDB.\');\\n      return;\\n    }\\n\\n    await apiFetch(\'/api/prevent/habits\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleToggleLesson = async (patientId: string, lessonId: string) => {\\n    if (!isOnline) {\\n      const idempotencyKey = createIdempotencyKey(\'les\');\\n      await enqueueOfflineAction({\\n        idempotencyKey,\\n        type: \'LESSON_COMPLETE\',\\n        patientId,\\n        summary: `Marked prevention lesson ${lessonId} complete offline`,\\n        payload: { patientId, lessonId },\\n        createdAt: new Date().toISOString(),\\n      });\\n      setData((prev) =>\\n        prev\\n          ? {\\n              ...prev,\\n              programmes: prev.programmes.map((pr) =>\\n                pr.patientId !== patientId\\n                  ? pr\\n                  : {\\n                      ...pr,\\n                      lessons: pr.lessons.map((l) =>\\n                        l.id === lessonId ? { ...l, completed: !l.completed } : l\\n                      ),\\n                    }\\n              ),\\n            }\\n          : prev\\n      );\\n      await refreshPendingCount();\\n      showToast(\'Lesson progress queued offline.\');\\n      return;\\n    }\\n\\n    await apiFetch(`/api/prevent/lessons/${lessonId}/complete`, {\\n      method: \'POST\',\\n      body: JSON.stringify({ patientId }),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleRegisterPatient = async (payload: {\\n    name: string;\\n    age: number;\\n    sex: \'Female\' | \'Male\' | \'Other\';\\n    phone: string;\\n    district: string;\\n    villageOrWard: string;\\n    language: LanguageCode;\\n    diabetesStatus: \'at_risk\' | \'prediabetes_lab\' | \'diagnosed_t2d\';\\n    screeningConsent: boolean;\\n    dataStorageConsent: boolean;\\n    offlineCacheConsent: boolean;\\n    clinicalBoundaryAcknowledged: boolean;\\n  }) => {\\n    const created = await apiFetch<{ id: string }>(\'/api/patients\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) {\\n      await fetchBootstrap(token);\\n      setSelectedPatientId(created.id);\\n    }\\n  };\\n\\n  const handleRecordLab = async (payload: {\\n    patientId: string;\\n    testedAt: string;\\n    hba1cPercent?: number;\\n    fastingGlucoseMgDl?: number;\\n    clinicalNotes: string;\\n  }) => {\\n    await apiFetch(\'/api/clinical/labs\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  // Pillar 2: Detect handler\\n  const handleSubmitScreening = async (\\n    payload: Omit<RetinalScreening, \'id\' | \'capturedAt\' | \'humanReviewStatus\' | \'summaryText\'>\\n  ) => {\\n    await apiFetch(\'/api/detect/screenings\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  // Pillar 3: Protect handlers\\n  const handleSubmitReview = async (payload: {\\n    screeningId: string;\\n    decision: DoctorReview[\'decision\'];\\n    clinicianGrade: string;\\n    triageCategory: DoctorReview[\'triageCategory\'];\\n    clinicalNotes: string;\\n    recommendedNextSteps: string;\\n  }) => {\\n    await apiFetch(\'/api/protect/reviews\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleCreateReferral = async (payload: {\\n    patientId: string;\\n    screeningId?: string;\\n    targetFacility: string;\\n    specialty: ReferralRecord[\'specialty\'];\\n    urgency: ReferralRecord[\'urgency\'];\\n    reason: string;\\n  }) => {\\n    await apiFetch(\'/api/protect/referrals\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleUpdateReferral = async (\\n    id: string,\\n    status: ReferralRecord[\'status\'],\\n    specialistFindings?: string\\n  ) => {\\n    await apiFetch(`/api/protect/referrals/${id}`, {\\n      method: \'PATCH\',\\n      body: JSON.stringify({ status, specialistFindings }),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleCreateAppointment = async (payload: {\\n    patientId: string;\\n    title: string;\\n    facility: string;\\n    clinicianName: string;\\n    scheduledDate: string;\\n    scheduledTime: string;\\n    type: AppointmentRecord[\'type\'];\\n    reminderNote: string;\\n  }) => {\\n    await apiFetch(\'/api/protect/appointments\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleUpdateAppointment = async (\\n    id: string,\\n    status: AppointmentRecord[\'status\'],\\n    escalated?: boolean\\n  ) => {\\n    await apiFetch(`/api/protect/appointments/${id}`, {\\n      method: \'PATCH\',\\n      body: JSON.stringify({ status, escalated }),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleCreateFollowUp = async (payload: {\\n    patientId: string;\\n    healthWorkerName: string;\\n    dueDate: string;\\n    channel: FollowUpRecord[\'channel\'];\\n    status: FollowUpRecord[\'status\'];\\n    outcomeNotes: string;\\n    nextScreeningDate?: string;\\n  }) => {\\n    await apiFetch(\'/api/protect/followups\', {\\n      method: \'POST\',\\n      body: JSON.stringify(payload),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleMarkNotificationRead = async (id: string) => {\\n    setData((prev) =>\\n      prev\\n        ? {\\n            ...prev,\\n            notifications: prev.notifications.map((n) =>\\n              n.id === id ? { ...n, read: true } : n\\n            ),\\n          }\\n        : prev\\n    );\\n    if (isOnline && token) {\\n      await apiFetch(`/api/notifications/${id}/read`, { method: \'POST\' }).catch(() => undefined);\\n    }\\n  };\\n\\n  const handleImportSimulinkCsv = async (csvText: string) => {\\n    await apiFetch(\'/api/admin/simulink/import\', {\\n      method: \'POST\',\\n      body: JSON.stringify({ csvText }),\\n    });\\n    if (token) await fetchBootstrap(token);\\n  };\\n\\n  const handleNavigate = (view: AppNavView, patId?: string) => {\\n    if (patId) setSelectedPatientId(patId);\\n    // Keep Appointments & Referrals smoothly accessible via Protect tabs or dedicated views\\n    setActiveView(view);\\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\\n  };\\n\\n  if (loading) {\\n    return (\\n      <div className=\\\"flex min-h-screen items-center justify-center bg-[#F4F7FA] p-6\\\">\\n        <div className=\\\"w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xs\\\">\\n          <div className=\\\"mx-auto h-10 w-10 animate-spin rounded-full border-3 border-slate-200 border-t-[#0D9488]\\\" />\\n          <h1 className=\\\"mt-4 font-display text-lg font-bold text-[#0B2540]\\\">\\n            Initializing Mritidhristi\\n          </h1>\\n          <p className=\\\"mt-1 text-xs text-slate-500\\\">\\n            Loading role-scoped healthcare records and IndexedDB offline sync engine...\\n          </p>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  if (fatalError || !data) {\\n    return (\\n      <div className=\\\"flex min-h-screen items-center justify-center bg-[#F4F7FA] p-6\\\">\\n        <div className=\\\"w-full max-w-md rounded-2xl border border-rose-200 bg-white p-8 text-center\\\">\\n          <h1 className=\\\"font-display text-lg font-bold text-rose-800\\\">\\n            Unable to Load Application\\n          </h1>\\n          <p className=\\\"mt-2 text-xs text-slate-600\\\">{fatalError || \'Unknown startup error.\'}</p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => window.location.reload()}\\n            className=\\\"mt-4 rounded-xl bg-[#0B2540] px-5 py-2 text-xs font-semibold text-white\\\"\\n          >\\n            Retry Connection\\n          </button>\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  const unreadCount = data.notifications.filter((n) => !n.read).length;\\n\\n  return (\\n    <div className=\\\"flex min-h-screen bg-[#F4F7FA] text-[#0F2438]\\\">\\n      <Sidebar\\n        activeView={activeView}\\n        onNavigate={(v) => handleNavigate(v)}\\n        role={data.user.role}\\n        t={t}\\n        collapsed={sidebarCollapsed}\\n        onToggleCollapse={() => setSidebarCollapsed((c) => !c)}\\n        mobileOpen={mobileMenuOpen}\\n        onCloseMobile={() => setMobileMenuOpen(false)}\\n        unreadCount={unreadCount}\\n        pendingSyncCount={pendingSyncCount}\\n        isOnline={isOnline}\\n      />\\n\\n      <div className=\\\"flex min-w-0 flex-1 flex-col\\\">\\n        <TopBar\\n          user={data.user}\\n          language={language}\\n          onLanguageChange={setLanguage}\\n          t={t}\\n          searchQuery={searchQuery}\\n          onSearchChange={setSearchQuery}\\n          isOnline={isOnline}\\n          simulateOffline={simulateOffline}\\n          onToggleSimulateOffline={() => {\\n            setSimulateOffline((prev) => {\\n              const next = !prev;\\n              showToast(\\n                next\\n                  ? \'Offline Test Mode enabled. Supported Prevent actions now queue in IndexedDB.\'\\n                  : \'Connectivity restored. Checking pending sync queue...\'\\n              );\\n              return next;\\n            });\\n          }}\\n          pendingSyncCount={pendingSyncCount}\\n          notifications={data.notifications}\\n          onNavigate={(v) => handleNavigate(v)}\\n          onOpenAuthModal={() => setAuthModalOpen(true)}\\n          onOpenMobileMenu={() => setMobileMenuOpen(true)}\\n          onMarkNotificationRead={(id) => void handleMarkNotificationRead(id)}\\n        />\\n\\n        {/* Main Workspace Canvas */}\\n        <main className=\\\"flex-1 px-4 py-5 lg:px-6 max-w-[1600px] w-full mx-auto\\\">\\n          {activeView === \'dashboard\' && data.user.role === \'patient\' && (\\n            <PatientDashboard\\n              data={data}\\n              t={t}\\n              isOnline={isOnline}\\n              pendingSyncCount={pendingSyncCount}\\n              onNavigate={(v) => handleNavigate(v)}\\n              onSyncNow={() => void handleSyncNow()}\\n            />\\n          )}\\n\\n          {activeView === \'dashboard\' && data.user.role === \'doctor\' && (\\n            <DoctorDashboard\\n              data={data}\\n              searchQuery={searchQuery}\\n              onNavigate={handleNavigate}\\n            />\\n          )}\\n\\n          {activeView === \'dashboard\' && data.user.role === \'admin\' && (\\n            <AdminDashboard data={data} onNavigate={(v) => handleNavigate(v)} />\\n          )}\\n\\n          {activeView === \'prevent\' && (\\n            <PreventModule\\n              data={data}\\n              selectedPatientId={selectedPatientId}\\n              onSelectPatient={setSelectedPatientId}\\n              isOnline={isOnline}\\n              onSubmitAssessment={handleSubmitAssessment}\\n              onSubmitHabit={handleSubmitHabit}\\n              onToggleLesson={handleToggleLesson}\\n              onRegisterPatient={handleRegisterPatient}\\n              onRecordLab={handleRecordLab}\\n            />\\n          )}\\n\\n          {activeView === \'detect\' && (\\n            <DetectModule\\n              data={data}\\n              selectedPatientId={selectedPatientId}\\n              onSelectPatient={setSelectedPatientId}\\n              isOnline={isOnline}\\n              onSubmitScreening={handleSubmitScreening}\\n              onNavigateProtect={() => handleNavigate(\'protect\')}\\n            />\\n          )}\\n\\n          {(activeView === \'protect\' ||\\n            activeView === \'appointments\' ||\\n            activeView === \'referrals\') && (\\n            <ProtectModule\\n              data={data}\\n              selectedPatientId={selectedPatientId}\\n              onSelectPatient={setSelectedPatientId}\\n              isOnline={isOnline}\\n              onSubmitReview={handleSubmitReview}\\n              onCreateReferral={handleCreateReferral}\\n              onUpdateReferral={handleUpdateReferral}\\n              onCreateAppointment={handleCreateAppointment}\\n              onUpdateAppointment={handleUpdateAppointment}\\n              onCreateFollowUp={handleCreateFollowUp}\\n            />\\n          )}\\n\\n          {activeView === \'reports\' && (\\n            <ReportsView data={data} searchQuery={searchQuery} />\\n          )}\\n\\n          {activeView === \'notifications\' && (\\n            <NotificationsView\\n              data={data}\\n              onMarkRead={(id) => void handleMarkNotificationRead(id)}\\n              onNavigate={(v) => handleNavigate(v)}\\n            />\\n          )}\\n\\n          {activeView === \'offline\' && (\\n            <OfflineSyncView\\n              data={data}\\n              isOnline={isOnline}\\n              simulateOffline={simulateOffline}\\n              onToggleSimulateOffline={() => setSimulateOffline((v) => !v)}\\n              onSyncNow={handleSyncNow}\\n              onNavigate={(v) => handleNavigate(v)}\\n              refreshTick={syncTick}\\n            />\\n          )}\\n\\n          {activeView === \'simulink\' && (\\n            <SimulinkAnalyticsView\\n              data={data}\\n              isOnline={isOnline}\\n              onImportCsv={handleImportSimulinkCsv}\\n            />\\n          )}\\n\\n          {activeView === \'settings\' && (\\n            <SettingsView\\n              data={data}\\n              language={language}\\n              onLanguageChange={setLanguage}\\n              token={token}\\n              onOpenAuthModal={() => setAuthModalOpen(true)}\\n            />\\n          )}\\n        </main>\\n      </div>\\n\\n      {/* Live Toast Notification */}\\n      {toast && (\\n        <div\\n          role=\\\"status\\\"\\n          className=\\\"fixed bottom-4 right-4 z-50 max-w-sm rounded-xl border border-slate-700 bg-[#0B2540] px-4 py-3 text-xs font-medium text-white shadow-xl\\\"\\n        >\\n          {toast}\\n        </div>\\n      )}\\n\\n      {/* Role Switcher & Secure Auth Modal */}\\n      <AuthModal\\n        open={authModalOpen}\\n        onClose={() => setAuthModalOpen(false)}\\n        currentUser={data.user}\\n        onSwitchDemoRole={handleSwitchDemoRole}\\n        onLogin={handleLogin}\\n        onRegister={handleRegisterAccount}\\n      />\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build integrated root App.tsx wiring authentication, RBAC, all 3 role dashboards, Prevent/Detect/Protect pillars, Offline Sync Engine, Simulink Analytics, and PWA service worker registration\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Building main App.tsx shell\", \"toolSummary\":\"Update src/App.tsx\"}"
      thinking_signature: "\022\266\r\n\263\r\001i\024}\023i\'\307\250\212\240\177\275\361*\373\033\022\234\275\245i\326\024\376Z5(/+\232\022t\343\315\265\327\353D\273t\001Ezy\030\004=\330f\347\231\360u\335\263D\332\253\217uz\213y\2029\365\314RFT>\262.Q\\\bh\370W\261O\322c7O\263y\232\257\237\231\325\354F\030\362\356\244A\311\360>\314z\030i]\003\276o\303v\367*0\371\342\217\252\270\347\350\252\f\306\250~*>\246\201_K]\217\273\235v\245\204\344\330\247\337\263e\310g\001e!\233\374\313.\227m\032\222/ v\326\253\276V\002\355\333\204T\337f`\340\232!\252S\325\027\250\343\237\331\022\275\362\262\372\346*e\223\343\266\3072\v\273\201\270?\030\213m\r\331\032\337s\004\325\317\243\030n\356\303JI\f\035\027\030X\313o5_\003\306{\303\236\303\367 \214\277\006\003\375\205{f\325?5va\365\320\f_\272\304Kz\270\361\302\354\3712\323\304\306\272F\022\022\3454\202\026^\345$\024\267\340e4\275\352\271Q\025\206\300\250hMqs\207\0024,\232@\372z\023\004\025\222\332\322\257\207\374$h\020J\350\232\201\266k\\\366\240A\2304\301\201\375\006w5C\2477\375\200\276M\227{\205\342\371\362\204\330l\fgp\317\264\325\036\315\322J\250KXf\342 L\242\032\'Q\204J\260*^\220_\205e1\006Y\177\263\233?\206l\232\241\271\251\301{\343\3324\304$IM7\200\230\375\266\313 m\274\267D=qs6`\206\346\345\276`\206\356qq\251\2028H@#\237\000\213lOg\315e\375\003\266\a(V\n\314\023g\344\033\314\307(C`\247\362\246\202R\030\341\231@O\200\r\264s`lC\335\033q\031\311\342\200:\033\260\271zX\313P\315\350\370=\001\210\324\003|\031{\325\025\034\201/\\#)\246\273q\t^T\371\257\206\312\232\022U\030%\354I\017\371\225\313\035\313\016Q\316?x|\246\341\211\032\305)(<M@\275 \244p\301\3272\241&\tV\277\365\200\372g\236\373\376\017\245D\311\304\030o\250\034\0309z\334`\321\374\244\253%\205\265\350\200\366z\360\327G\373\223\354\0061\212.c\325\177\\\\?\342\305\207\374\335Rhm.\316\335\277\365\261\333\230\022\312\032~\333\340\354:X\200&\352d\324i!\361\267\3404\251\347@\317\302\031\324\213C\262\370\367n#/O}\321f\005\241\021\373V|\0026\363sL]\257[I\211\343\232=\225\335\200\352\253\363+_\bP\210=\3665)]\244\f\216\200\b\351\310=\305\3072\364Y\320,j,%\272E\000p\"\225\322M\002H\023c\310\303\332\271\257\357\261h.aLI\341\337\\\354\031\234\324\004\253\b\317\374t\314DvP\250v \235\277\236\003\025\235\216\035\"\322j\265\255\342\364\326+\177\3679\223\275\265C\242\354\215\305\020i\034\3146\265 \\.e({gFV\232\222T.\221lD\225\237\354g\331\2341\335#\301\310\206\224d\217\222\256\343\216Z21\221\215\334\377\376b\361LI\317H\276<\307a\320\206\0003\276<\217\"\370\314\257\222r\236Y\247\252c\274un\373\031\v\203\376\032\261I#Fj\334u\235\230\215\364\036\254?kz\266H\225\211n\324\310\006\331x\207\0243\311\234\177\337\252\374\304\331f3\237\360\275c\244g\320\237\325\331\342\267\334|<s\215\fh\304r\351\000{?\n\323\216\261\332\215M\v\306Up\3740\303\375\264\357\326\300P\345\214\323\375B\317K\274%\361\177\376\367;;\364\254t4\036\371%5\nL\312\272yz\344\355\260\370>/\273\372b\016\263\204\343\360\264x\005\336\352!\b\355)w4\201\260b%\376\246*_\3471\205p\236\254\310\026\361\300\336\a\017|z\340\a\375\350\270\255\226\202-\322\312Q \336\3431\000v\027_\305\251$\270\352\305^\377sT\025j+@\2501\350\025N=az\357L\"d4\375L\036s\316e+\ai_\023enb\231\222gN\n[9\227\247\"\023\017A\271\362\353\345\256C\037\202ii\221\005\307\033J8\r2Oj\255\320\377\306\245^\326\234\016\204 j\307\335\361g\235\304@4VD\366\363\321\235\263\254\242\347\207\340\200\257#\v\330\232m\251G\201\270\257\270\020\325\257\350\364\214\024d\304q\224\250X\003\365\345\310\227\264\242 \372\210\374>\202\3454\005\242l7\275G:\264\v\214\tZ5#\230W7\025\244\344B\355K\\\277\f\364\345D\376\276\356+\370\246\330r\227\2634\361\376\27293g\371ls\244m\201y\266\t\301\373n\210V\372\257\232\335\226P\237P\341\0032:F\226\265\213j(\377\321\322\301\242q\371p\244\201\221\n\2367b\372\223\315\236\241\203\257\202\225\244\213\207\261\024\325\f\233+I\257H\207\030U\365b\330\335\331\210\230\323\244N>B\365\030\200\375k\322^\251\271\350\342\334!*-\0369.M\360\201v\225f\221+0\3171ND\037\371\364\352B\020\302\'AA\201\377\310i:k\245\237f\274\365\205~\333?\262\254\210\034\240(\343H\025\246\360\350)\317d\203r\231\332VNrC\342\355\243*C\367x\371\241\032\241\324\'f8\344\207\300\262X\312\303\226K]\253bRi\230\372\352\207#\365\242\363\226\320\357#\360\267n\352\000\205\b\313\240\362\000%\026%\331I\264\334\375\r\307\377\311!3\275\237\374@\bv\360c=\203\227X[\025\377\210\201\2333\027\373\355\365\364G`:\314[\371\005@\274\262\326x\355KB\234\260\213\302\372\372\351\352\353rs\274\036\363n\030k~\333\271c\024WW\331\210K\265\247N\264\3542b\215l\207\313\253\231C7\322\032\232z\016uy\341\337\f\024\277L\330X\206M9<\f\326F\037\303=\212a\243:\377\255\226\314\033\316\261\315r\206\337\022\203\252\004\356\001\210\253\322*rT\227\224\\\266m\365p\035\367R9X\217\363\366\343k\370\000TuU\352V\202\245\314\264n\236f\307\242\0301Y\363%ve\216vn\202l\352i\357\373\377]y\r9\356>\365Z\367\344oB\325\255\025\242[MT\207\320\367\242\n\354[.L\337\321\355\261\177\210x\220\030\267\314T\231,\261h\332p\005\344\t\377\370\333>\357\003"
