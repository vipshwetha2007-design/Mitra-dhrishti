    tool_calls {
      id: "call_831467689216051375"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Activity,\\n  AlertTriangle,\\n  ArrowLeft,\\n  ArrowRight,\\n  BookOpen,\\n  CheckCircle2,\\n  ClipboardCheck,\\n  FlaskConical,\\n  Sliders,\\n  UserPlus,\\n  WifiOff,\\n} from \'lucide-react\';\\nimport {\\n  CartesianGrid,\\n  Line,\\n  LineChart,\\n  ResponsiveContainer,\\n  Tooltip,\\n  XAxis,\\n  YAxis,\\n} from \'recharts\';\\nimport type {\\n  BootstrapPayload,\\n  LanguageCode,\\n  LifestyleInput,\\n} from \'../types/domain\';\\nimport { evaluateClientExperimentalRisk } from \'../utils/riskEngine\';\\n\\ninterface PreventModuleProps {\\n  data: BootstrapPayload;\\n  selectedPatientId: string;\\n  onSelectPatient: (id: string) => void;\\n  isOnline: boolean;\\n  onSubmitAssessment: (patientId: string, inputs: LifestyleInput) => Promise<void>;\\n  onSubmitHabit: (payload: {\\n    patientId: string;\\n    date: string;\\n    healthyIndianDiet: boolean;\\n    stepsAchieved: number;\\n    sleepHours: number;\\n    weightKg?: number;\\n    waistCm?: number;\\n    barrierReported?: string;\\n  }) => Promise<void>;\\n  onToggleLesson: (patientId: string, lessonId: string) => Promise<void>;\\n  onRegisterPatient: (payload: {\\n    name: string;\\n    age: number;\\n    sex: \'Female\' | \'Male\' | \'Other\';\\n    phone: string;\\n    district: string;\\n    villageOrWard: string;\\n    language: LanguageCode;\\n    diabetesStatus: \'at_risk\' | \'prediabetes_lab\' | \'diagnosed_t2d\';\\n    screeningConsent: boolean;\\n    dataStorageConsent: boolean;\\n    offlineCacheConsent: boolean;\\n    clinicalBoundaryAcknowledged: boolean;\\n  }) => Promise<void>;\\n  onRecordLab: (payload: {\\n    patientId: string;\\n    testedAt: string;\\n    hba1cPercent?: number;\\n    fastingGlucoseMgDl?: number;\\n    clinicalNotes: string;\\n  }) => Promise<void>;\\n}\\n\\nconst QUESTIONS = [\\n  { key: \'age\', title: \'1. Age (Years)\', desc: \'Age is a non-modifiable baseline risk factor for Type 2 diabetes.\' },\\n  { key: \'dietQuality\', title: \'2. Typical Daily Diet\', desc: \'Select the pattern closest to your regular South/North Indian meals and beverages.\' },\\n  { key: \'sleepHours\', title: \'3. Nightly Sleep Duration\', desc: \'Average hours of sleep per night over the past two weeks.\' },\\n  { key: \'dailySteps\', title: \'4. Physical Activity & Daily Steps\', desc: \'Typical daily walking steps or equivalent brisk activity.\' },\\n  { key: \'weightKg\', title: \'5. Weight & Height\', desc: \'Used to compute Body Mass Index (South Asian screening reference < 23 kg/m\302\262).\' },\\n  { key: \'waistCm\', title: \'6. Waist Circumference (cm)\', desc: \'Measured around the abdomen at navel level; central adiposity is modifiable.\' },\\n  { key: \'familyHistory\', title: \'7. Family History of Diabetes\', desc: \'History of Type 2 diabetes in parents or siblings.\' },\\n  { key: \'smokingStatus\', title: \'8. Tobacco / Smoking Status\', desc: \'Current or past smoking increases vascular and metabolic risk.\' },\\n  { key: \'alcoholUse\', title: \'9. Alcohol Consumption\', desc: \'Frequency of alcoholic beverage intake.\' },\\n] as const;\\n\\nexport const PreventModule: React.FC<PreventModuleProps> = ({\\n  data,\\n  selectedPatientId,\\n  onSelectPatient,\\n  isOnline,\\n  onSubmitAssessment,\\n  onSubmitHabit,\\n  onToggleLesson,\\n  onRegisterPatient,\\n  onRecordLab,\\n}) => {\\n  const [subTab, setSubTab] = useState<\'assessment\' | \'whatif\' | \'programme\' | \'labs\' | \'register\'>(\'assessment\');\\n  const [stepIdx, setStepIdx] = useState(0);\\n  const [submitting, setSubmitting] = useState(false);\\n  const [bannerMsg, setBannerMsg] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n\\n  const patient =\\n    data.patients.find((p) => p.id === selectedPatientId) || data.patients[0];\\n  const patientAssessments = data.assessments.filter((a) => a.patientId === patient?.id);\\n  const latestAssessment = patientAssessments[0];\\n  const programme = data.programmes.find((p) => p.patientId === patient?.id);\\n  const patientHabits = data.habitLogs.filter((h) => h.patientId === patient?.id);\\n  const patientLabs = data.labs.filter((l) => l.patientId === patient?.id);\\n  const patientInterventions = data.interventions.filter((i) => i.patientId === patient?.id);\\n\\n  const [inputs, setInputs] = useState<LifestyleInput>({\\n    age: patient?.age ?? 36,\\n    dietQuality: latestAssessment?.inputs.dietQuality ?? \'moderate_refined\',\\n    sleepHours: latestAssessment?.inputs.sleepHours ?? 7,\\n    dailySteps: latestAssessment?.inputs.dailySteps ?? 6500,\\n    weightKg: latestAssessment?.inputs.weightKg ?? 66,\\n    heightCm: latestAssessment?.inputs.heightCm ?? 164,\\n    waistCm: latestAssessment?.inputs.waistCm ?? 84,\\n    familyHistory: latestAssessment?.inputs.familyHistory ?? \'one_parent\',\\n    smokingStatus: latestAssessment?.inputs.smokingStatus ?? \'never\',\\n    alcoholUse: latestAssessment?.inputs.alcoholUse ?? \'none\',\\n  });\\n\\n  const [whatIf, setWhatIf] = useState<LifestyleInput>(inputs);\\n  const baseEval = useMemo(() => evaluateClientExperimentalRisk(inputs), [inputs]);\\n  const whatIfEval = useMemo(() => evaluateClientExperimentalRisk(whatIf), [whatIf]);\\n\\n  const [habitDate, setHabitDate] = useState(new Date().toISOString().slice(0, 10));\\n  const [habitDiet, setHabitDiet] = useState(true);\\n  const [habitSteps, setHabitSteps] = useState(7200);\\n  const [habitSleep, setHabitSleep] = useState(7.5);\\n  const [habitWeight, setHabitWeight] = useState(programme?.currentWeightKg ?? 60);\\n  const [habitWaist, setHabitWaist] = useState(programme?.currentWaistCm ?? 78);\\n  const [habitBarrier, setHabitBarrier] = useState(\'\');\\n\\n  const [labHba1c, setLabHba1c] = useState(\'\');\\n  const [labFpg, setLabFpg] = useState(\'\');\\n  const [labDate, setLabDate] = useState(new Date().toISOString().slice(0, 10));\\n  const [labNotes, setLabNotes] = useState(\'\');\\n\\n  const [regForm, setRegForm] = useState({\\n    name: \'\',\\n    age: 42,\\n    sex: \'Female\' as \'Female\' | \'Male\' | \'Other\',\\n    phone: \'+91 \',\\n    district: \'Chennai South\',\\n    villageOrWard: \'Adyar Urban PHC\',\\n    language: \'en\' as LanguageCode,\\n    diabetesStatus: \'at_risk\' as \'at_risk\' | \'prediabetes_lab\' | \'diagnosed_t2d\',\\n    screeningConsent: false,\\n    dataStorageConsent: false,\\n    offlineCacheConsent: true,\\n    clinicalBoundaryAcknowledged: false,\\n  });\\n\\n  const handleSaveAssessment = async () => {\\n    if (!patient) return;\\n    setSubmitting(true);\\n    setBannerMsg(null);\\n    try {\\n      await onSubmitAssessment(patient.id, inputs);\\n      setWhatIf(inputs);\\n      setBannerMsg({\\n        type: \'success\',\\n        text: isOnline\\n          ? \'Lifestyle assessment calculated and saved to backend records.\'\\n          : \'Offline mode: Assessment calculated locally and queued in IndexedDB for sync.\',\\n      });\\n    } catch (err) {\\n      setBannerMsg({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Unable to save assessment.\',\\n      });\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleSaveHabit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setSubmitting(true);\\n    setBannerMsg(null);\\n    try {\\n      await onSubmitHabit({\\n        patientId: patient.id,\\n        date: habitDate,\\n        healthyIndianDiet: habitDiet,\\n        stepsAchieved: Number(habitSteps),\\n        sleepHours: Number(habitSleep),\\n        weightKg: Number(habitWeight),\\n        waistCm: Number(habitWaist),\\n        barrierReported: habitBarrier.trim() || undefined,\\n      });\\n      setHabitBarrier(\'\');\\n      setBannerMsg({\\n        type: \'success\',\\n        text: isOnline\\n          ? \'Daily habit logged and adaptive intervention ladder evaluated.\'\\n          : \'Offline mode: Habit log saved to IndexedDB pending queue.\',\\n      });\\n    } catch (err) {\\n      setBannerMsg({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Unable to log habit.\',\\n      });\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleSaveLab = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setSubmitting(true);\\n    setBannerMsg(null);\\n    try {\\n      await onRecordLab({\\n        patientId: patient.id,\\n        testedAt: labDate,\\n        hba1cPercent: labHba1c ? Number(labHba1c) : undefined,\\n        fastingGlucoseMgDl: labFpg ? Number(labFpg) : undefined,\\n        clinicalNotes: labNotes,\\n      });\\n      setLabHba1c(\'\');\\n      setLabFpg(\'\');\\n      setLabNotes(\'\');\\n      setBannerMsg({\\n        type: \'success\',\\n        text: \'Laboratory result recorded and interpreted per ICMR/ADA reference thresholds.\',\\n      });\\n    } catch (err) {\\n      setBannerMsg({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Only authorised doctors/admins may record clinical lab results.\',\\n      });\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleRegister = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setSubmitting(true);\\n    setBannerMsg(null);\\n    try {\\n      await onRegisterPatient(regForm);\\n      setBannerMsg({\\n        type: \'success\',\\n        text: `Patient ${regForm.name} registered with verified informed consent.`,\\n      });\\n      setRegForm((prev) => ({\\n        ...prev,\\n        name: \'\',\\n        screeningConsent: false,\\n        dataStorageConsent: false,\\n        clinicalBoundaryAcknowledged: false,\\n      }));\\n    } catch (err) {\\n      setBannerMsg({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Patient registration failed.\',\\n      });\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const progressChartData = [...patientHabits]\\n    .reverse()\\n    .map((h) => ({\\n      date: h.date.slice(5),\\n      steps: Math.round(h.stepsAchieved / 100),\\n      weight: h.weightKg ?? programme?.currentWeightKg ?? 60,\\n      waist: h.waistCm ?? programme?.currentWaistCm ?? 78,\\n    }));\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-[#0F766E]\\\">\\n            Pillar One \302\267 Type 2 Diabetes Lifestyle Risk &amp; 12-Month Prevention\\n          </p>\\n          <h1 className=\\\"font-display text-2xl font-bold text-[#0B2540]\\\">\\n            PREVENT \342\200\224 Risk Assessment &amp; Prevention Programme\\n          </h1>\\n        </div>\\n\\n        {data.patients.length > 1 && (\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label htmlFor=\\\"prevent-patient-select\\\" className=\\\"text-xs font-semibold text-slate-600\\\">\\n              Active Patient:\\n            </label>\\n            <select\\n              id=\\\"prevent-patient-select\\\"\\n              value={patient?.id || \'\'}\\n              onChange={(e) => onSelectPatient(e.target.value)}\\n              className=\\\"rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800 focus:border-[#0D9488] focus:outline-none\\\"\\n            >\\n              {data.patients.map((p) => (\\n                <option key={p.id} value={p.id}>\\n                  {p.name} ({p.mrn})\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        )}\\n      </div>\\n\\n      <div className=\\\"flex flex-wrap gap-1.5 rounded-xl bg-slate-200/70 p-1\\\">\\n        {[\\n          { id: \'assessment\', label: \'9-Input Risk Assessment\', icon: ClipboardCheck },\\n          { id: \'whatif\', label: \'What-If Simulator\', icon: Sliders },\\n          { id: \'programme\', label: \'12-Month Programme & Habits\', icon: Activity },\\n          { id: \'labs\', label: \'Clinical Testing (HbA1c/FPG)\', icon: FlaskConical },\\n          { id: \'register\', label: \'Patient Registration & Consent\', icon: UserPlus },\\n        ].map((tab) => {\\n          const Icon = tab.icon;\\n          const active = subTab === tab.id;\\n          return (\\n            <button\\n              key={tab.id}\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSubTab(tab.id as typeof subTab);\\n                setBannerMsg(null);\\n              }}\\n              className={`inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-xs font-semibold transition-colors whitespace-nowrap ${\\n                active ? \'bg-white text-[#0B2540] shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              <Icon className=\\\"h-3.5 w-3.5 text-[#0D9488]\\\" />\\n              {tab.label}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {bannerMsg && (\\n        <div\\n          className={`rounded-xl border px-4 py-3 text-xs font-medium ${\\n            bannerMsg.type === \'success\'\\n              ? \'border-emerald-200 bg-emerald-50 text-emerald-900\'\\n              : \'border-rose-200 bg-rose-50 text-rose-900\'\\n          }`}\\n        >\\n          {bannerMsg.text}\\n        </div>\\n      )}\\n\\n      {!isOnline && (\\n        <div className=\\\"flex items-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-xs text-amber-950\\\">\\n          <WifiOff className=\\\"h-4 w-4 text-amber-700 shrink-0\\\" />\\n          <span>\\n            <strong>Offline-First Active:</strong> 9-input lifestyle assessments, What-If simulations, and daily habit logs save locally in Dexie IndexedDB and synchronize automatically once connectivity returns.\\n          </span>\\n        </div>\\n      )}\\n\\n      {subTab === \'assessment\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5 items-start\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-6\\\">\\n            <div className=\\\"flex items-center justify-between text-xs text-slate-500 mb-2\\\">\\n              <span className=\\\"font-semibold text-[#0F766E]\\\">\\n                Step {stepIdx + 1} of {QUESTIONS.length}\\n              </span>\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {Math.round(((stepIdx + 1) / QUESTIONS.length) * 100)}% complete\\n              </span>\\n            </div>\\n            <div className=\\\"h-2 w-full rounded-full bg-slate-100 overflow-hidden mb-6\\\">\\n              <div\\n                className=\\\"h-full rounded-full bg-[#0D9488] transition-all duration-200\\\"\\n                style={{ width: `${((stepIdx + 1) / QUESTIONS.length) * 100}%` }}\\n              />\\n            </div>\\n\\n            <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n              {QUESTIONS[stepIdx].title}\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-slate-600\\\">{QUESTIONS[stepIdx].desc}</p>\\n\\n            <div className=\\\"mt-6 min-h-[150px]\\\">\\n              {stepIdx === 0 && (\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-medium text-slate-600\\\">Age</span>\\n                    <span className=\\\"font-mono text-lg font-bold text-[#0B2540] tabular-nums\\\">\\n                      {inputs.age} years\\n                    </span>\\n                  </div>\\n                  <input\\n                    type=\\\"range\\\"\\n                    min={18}\\n                    max={85}\\n                    value={inputs.age}\\n                    onChange={(e) => setInputs({ ...inputs, age: Number(e.target.value) })}\\n                    className=\\\"w-full accent-[#0D9488]\\\"\\n                  />\\n                </div>\\n              )}\\n\\n              {stepIdx === 1 && (\\n                <div className=\\\"space-y-2.5\\\">\\n                  {[\\n                    {\\n                      val: \'balanced_traditional\',\\n                      label: \'Balanced Traditional Indian Meals\',\\n                      sub: \'Daily vegetables (poriyal/kootu), dal/pulses, millets or moderate whole grains, minimal sugary drinks.\',\\n                    },\\n                    {\\n                      val: \'moderate_refined\',\\n                      label: \'Moderate Refined Carbohydrates\',\\n                      sub: \'Mostly polished white rice/refined flour with occasional sweetened tea/coffee or snacks.\',\\n                    },\\n                    {\\n                      val: \'high_refined_sugars\',\\n                      label: \'High Refined Carbs / Sugary Snacks\',\\n                      sub: \'Frequent sweetened drinks, deep-fried snacks, bakery items, and low vegetable/fibre intake.\',\\n                    },\\n                  ].map((opt) => (\\n                    <button\\n                      key={opt.val}\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        setInputs({\\n                          ...inputs,\\n                          dietQuality: opt.val as LifestyleInput[\'dietQuality\'],\\n                        })\\n                      }\\n                      className={`w-full rounded-xl border p-3.5 text-left transition-colors ${\\n                        inputs.dietQuality === opt.val\\n                          ? \'border-[#0D9488] bg-teal-50/50\'\\n                          : \'border-slate-200 hover:bg-slate-50\'\\n                      }`}\\n                    >\\n                      <div className=\\\"text-sm font-semibold text-slate-900\\\">{opt.label}</div>\\n                      <div className=\\\"mt-0.5 text-xs text-slate-600\\\">{opt.sub}</div>\\n                    </button>\\n                  ))}\\n                </div>\\n              )}\\n\\n              {stepIdx === 2 && (\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-medium text-slate-600\\\">Nightly Sleep</span>\\n                    <span className=\\\"font-mono text-lg font-bold text-[#0B2540] tabular-nums\\\">\\n                      {inputs.sleepHours} hours\\n                    </span>\\n                  </div>\\n                  <input\\n                    type=\\\"range\\\"\\n                    min={4}\\n                    max={11}\\n                    step={0.5}\\n                    value={inputs.sleepHours}\\n                    onChange={(e) => setInputs({ ...inputs, sleepHours: Number(e.target.value) })}\\n                    className=\\\"w-full accent-[#0D9488]\\\"\\n                  />\\n                </div>\\n              )}\\n\\n              {stepIdx === 3 && (\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-medium text-slate-600\\\">Average Daily Steps</span>\\n                    <span className=\\\"font-mono text-lg font-bold text-[#0B2540] tabular-nums\\\">\\n                      {inputs.dailySteps.toLocaleString()} steps/day\\n                    </span>\\n                  </div>\\n                  <input\\n                    type=\\\"range\\\"\\n                    min={1000}\\n                    max={15000}\\n                    step={250}\\n                    value={inputs.dailySteps}\\n                    onChange={(e) => setInputs({ ...inputs, dailySteps: Number(e.target.value) })}\\n                    className=\\\"w-full accent-[#0D9488]\\\"\\n                  />\\n                </div>\\n              )}\\n\\n              {stepIdx === 4 && (\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Weight (kg)</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={30}\\n                      max={200}\\n                      value={inputs.weightKg}\\n                      onChange={(e) => setInputs({ ...inputs, weightKg: Number(e.target.value) })}\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono tabular-nums\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Height (cm)</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={120}\\n                      max={220}\\n                      value={inputs.heightCm}\\n                      onChange={(e) => setInputs({ ...inputs, heightCm: Number(e.target.value) })}\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono tabular-nums\\\"\\n                    />\\n                  </div>\\n                  <div className=\\\"sm:col-span-2 rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-xs text-slate-700\\\">\\n                    Calculated BMI: <strong className=\\\"font-mono tabular-nums\\\">{baseEval.bmi} kg/m\302\262</strong>\\n                  </div>\\n                </div>\\n              )}\\n\\n              {stepIdx === 5 && (\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-medium text-slate-600\\\">Waist Circumference</span>\\n                    <span className=\\\"font-mono text-lg font-bold text-[#0B2540] tabular-nums\\\">\\n                      {inputs.waistCm} cm\\n                    </span>\\n                  </div>\\n                  <input\\n                    type=\\\"range\\\"\\n                    min={60}\\n                    max={140}\\n                    value={inputs.waistCm}\\n                    onChange={(e) => setInputs({ ...inputs, waistCm: Number(e.target.value) })}\\n                    className=\\\"w-full accent-[#0D9488]\\\"\\n                  />\\n                </div>\\n              )}\\n\\n              {stepIdx === 6 && (\\n                <div className=\\\"grid grid-cols-1 gap-2.5\\\">\\n                  {[\\n                    { val: \'none\', label: \'No known family history of Type 2 diabetes\' },\\n                    { val: \'one_parent\', label: \'One parent has Type 2 diabetes\' },\\n                    { val: \'both_parents_or_sibling\', label: \'Both parents or a sibling have Type 2 diabetes\' },\\n                  ].map((opt) => (\\n                    <button\\n                      key={opt.val}\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        setInputs({\\n                          ...inputs,\\n                          familyHistory: opt.val as LifestyleInput[\'familyHistory\'],\\n                        })\\n                      }\\n                      className={`rounded-xl border p-3.5 text-left text-sm font-medium ${\\n                        inputs.familyHistory === opt.val\\n                          ? \'border-[#0D9488] bg-teal-50/50 text-[#0B2540]\'\\n                          : \'border-slate-200 text-slate-700 hover:bg-slate-50\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              )}\\n\\n              {stepIdx === 7 && (\\n                <div className=\\\"grid grid-cols-3 gap-2.5\\\">\\n                  {([\'never\', \'former\', \'current\'] as const).map((val) => (\\n                    <button\\n                      key={val}\\n                      type=\\\"button\\\"\\n                      onClick={() => setInputs({ ...inputs, smokingStatus: val })}\\n                      className={`rounded-xl border p-3.5 text-center text-sm font-semibold capitalize ${\\n                        inputs.smokingStatus === val\\n                          ? \'border-[#0D9488] bg-teal-50/50 text-[#0B2540]\'\\n                          : \'border-slate-200 text-slate-700 hover:bg-slate-50\'\\n                      }`}\\n                    >\\n                      {val}\\n                    </button>\\n                  ))}\\n                </div>\\n              )}\\n\\n              {stepIdx === 8 && (\\n                <div className=\\\"grid grid-cols-3 gap-2.5\\\">\\n                  {([\'none\', \'occasional\', \'regular\'] as const).map((val) => (\\n                    <button\\n                      key={val}\\n                      type=\\\"button\\\"\\n                      onClick={() => setInputs({ ...inputs, alcoholUse: val })}\\n                      className={`rounded-xl border p-3.5 text-center text-sm font-semibold capitalize ${\\n                        inputs.alcoholUse === val\\n                          ? \'border-[#0D9488] bg-teal-50/50 text-[#0B2540]\'\\n                          : \'border-slate-200 text-slate-700 hover:bg-slate-50\'\\n                      }`}\\n                    >\\n                      {val}\\n                    </button>\\n                  ))}\\n                </div>\\n              )}\\n            </div>\\n\\n            <div className=\\\"mt-6 flex items-center justify-between border-t border-slate-100 pt-4\\\">\\n              <button\\n                type=\\\"button\\\"\\n                disabled={stepIdx === 0}\\n                onClick={() => setStepIdx((s) => Math.max(0, s - 1))}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40\\\"\\n              >\\n                <ArrowLeft className=\\\"h-3.5 w-3.5\\\" />\\n                Previous\\n              </button>\\n\\n              {stepIdx < QUESTIONS.length - 1 ? (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setStepIdx((s) => Math.min(QUESTIONS.length - 1, s + 1))}\\n                  className=\\\"inline-flex items-center gap-1.5 rounded-lg bg-[#0B2540] px-5 py-2 text-xs font-semibold text-white hover:bg-[#113556]\\\"\\n                >\\n                  Next Question\\n                  <ArrowRight className=\\\"h-3.5 w-3.5\\\" />\\n                </button>\\n              ) : (\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={submitting}\\n                  onClick={() => void handleSaveAssessment()}\\n                  className=\\\"inline-flex items-center gap-1.5 rounded-lg bg-[#0D9488] px-5 py-2 text-xs font-semibold text-white hover:bg-[#0F766E] disabled:opacity-60\\\"\\n                >\\n                  <CheckCircle2 className=\\\"h-4 w-4\\\" />\\n                  {submitting\\n                    ? \'Saving...\'\\n                    : isOnline\\n                    ? \'Save Assessment Result\'\\n                    : \'Save Offline to Queue\'}\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 space-y-4\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <div className=\\\"text-[11px] font-semibold text-amber-800\\\">\\n                {baseEval.scoringModelLabel}\\n              </div>\\n              <div className=\\\"mt-3 flex items-baseline justify-between\\\">\\n                <div>\\n                  <div className=\\\"font-display text-3xl font-bold text-[#0B2540] tabular-nums\\\">\\n                    {baseEval.experimentalScore}\\n                    <span className=\\\"text-base font-normal text-slate-400\\\"> / 100</span>\\n                  </div>\\n                  <div className=\\\"mt-0.5 text-sm font-semibold text-[#0F766E]\\\">\\n                    {baseEval.riskCategory} Lifestyle Risk Tier\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <p className=\\\"mt-3 text-xs text-slate-600 leading-relaxed\\\">{baseEval.explanation}</p>\\n\\n              <div className=\\\"mt-4 pt-4 border-t border-slate-100\\\">\\n                <div className=\\\"text-xs font-bold text-[#0B2540] mb-2\\\">\\n                  Top 3 Modifiable Risk Factors\\n                </div>\\n                <ol className=\\\"list-decimal list-inside space-y-1 text-xs text-slate-700\\\">\\n                  {baseEval.topModifiableFactors.map((f) => (\\n                    <li key={f} className=\\\"font-medium\\\">\\n                      {f}\\n                    </li>\\n                  ))}\\n                </ol>\\n              </div>\\n\\n              <div className=\\\"mt-4 pt-4 border-t border-slate-100 space-y-2\\\">\\n                <div className=\\\"text-xs font-bold text-[#0B2540]\\\">Contributing Factor Breakdown</div>\\n                {baseEval.contributions.slice(0, 6).map((c) => (\\n                  <div key={c.factor} className=\\\"space-y-1\\\">\\n                    <div className=\\\"flex items-center justify-between text-[11px]\\\">\\n                      <span className=\\\"text-slate-700 font-medium\\\">\\n                        {c.factor} {c.modifiable ? \'(Modifiable)\' : \'(Baseline)\'}\\n                      </span>\\n                      <span className=\\\"font-mono tabular-nums text-slate-500\\\">\\n                        {c.points}/{c.maxPoints}\\n                      </span>\\n                    </div>\\n                    <div className=\\\"h-1.5 w-full rounded-full bg-slate-100\\\">\\n                      <div\\n                        className=\\\"h-full rounded-full bg-[#0D9488]\\\"\\n                        style={{ width: `${(c.points / c.maxPoints) * 100}%` }}\\n                      />\\n                    </div>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <h3 className=\\\"font-display text-sm font-bold text-[#0B2540]\\\">Recommended Next Steps</h3>\\n              <ul className=\\\"mt-2.5 space-y-2 text-xs text-slate-700\\\">\\n                {baseEval.recommendations.map((rec, idx) => (\\n                  <li key={idx} className=\\\"flex items-start gap-2\\\">\\n                    <CheckCircle2 className=\\\"h-4 w-4 text-emerald-600 shrink-0 mt-0.5\\\" />\\n                    <span>{rec}</span>\\n                  </li>\\n                ))}\\n              </ul>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'whatif\' && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-6 space-y-5\\\">\\n          <div className=\\\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-4\\\">\\n            <div>\\n              <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n                Interactive What-If Lifestyle Explorer\\n              </h2>\\n              <p className=\\\"text-xs text-slate-600 mt-0.5\\\">\\n                Illustrative scenario only \342\200\224 not a medical diagnosis or validated clinical prognosis. Adjust modifiable habits to observe experimental score changes.\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setWhatIf(inputs)}\\n              className=\\\"rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 shrink-0\\\"\\n            >\\n              Reset to Baseline\\n            </button>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\\\">\\n            <div className=\\\"lg:col-span-7 space-y-4\\\">\\n              <div>\\n                <div className=\\\"flex justify-between text-xs font-semibold text-slate-700 mb-1\\\">\\n                  <span>Daily Steps</span>\\n                  <span className=\\\"font-mono tabular-nums\\\">{whatIf.dailySteps.toLocaleString()} steps</span>\\n                </div>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={1500}\\n                  max={14000}\\n                  step={500}\\n                  value={whatIf.dailySteps}\\n                  onChange={(e) => setWhatIf({ ...whatIf, dailySteps: Number(e.target.value) })}\\n                  className=\\\"w-full accent-[#0D9488]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <div className=\\\"flex justify-between text-xs font-semibold text-slate-700 mb-1\\\">\\n                  <span>Nightly Sleep</span>\\n                  <span className=\\\"font-mono tabular-nums\\\">{whatIf.sleepHours} hrs</span>\\n                </div>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={4.5}\\n                  max={9.5}\\n                  step={0.5}\\n                  value={whatIf.sleepHours}\\n                  onChange={(e) => setWhatIf({ ...whatIf, sleepHours: Number(e.target.value) })}\\n                  className=\\\"w-full accent-[#0D9488]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <div className=\\\"flex justify-between text-xs font-semibold text-slate-700 mb-1\\\">\\n                  <span>Target Weight</span>\\n                  <span className=\\\"font-mono tabular-nums\\\">{whatIf.weightKg} kg</span>\\n                </div>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={45}\\n                  max={120}\\n                  value={whatIf.weightKg}\\n                  onChange={(e) => setWhatIf({ ...whatIf, weightKg: Number(e.target.value) })}\\n                  className=\\\"w-full accent-[#0D9488]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <div className=\\\"flex justify-between text-xs font-semibold text-slate-700 mb-1\\\">\\n                  <span>Target Waist Circumference</span>\\n                  <span className=\\\"font-mono tabular-nums\\\">{whatIf.waistCm} cm</span>\\n                </div>\\n                <input\\n                  type=\\\"range\\\"\\n                  min={65}\\n                  max={130}\\n                  value={whatIf.waistCm}\\n                  onChange={(e) => setWhatIf({ ...whatIf, waistCm: Number(e.target.value) })}\\n                  className=\\\"w-full accent-[#0D9488]\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Dietary Pattern Shift</label>\\n                <select\\n                  value={whatIf.dietQuality}\\n                  onChange={(e) =>\\n                    setWhatIf({\\n                      ...whatIf,\\n                      dietQuality: e.target.value as LifestyleInput[\'dietQuality\'],\\n                    })\\n                  }\\n                  className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium\\\"\\n                >\\n                  <option value=\\\"balanced_traditional\\\">Balanced Traditional Indian Meals (Millets, Greens, Dal)</option>\\n                  <option value=\\\"moderate_refined\\\">Moderate Refined Carbs</option>\\n                  <option value=\\\"high_refined_sugars\\\">High Refined Carbs &amp; Sugary Drinks</option>\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-slate-50 p-5 space-y-4\\\">\\n              <div className=\\\"grid grid-cols-2 gap-3 text-center\\\">\\n                <div className=\\\"rounded-xl bg-white border border-slate-200 p-4\\\">\\n                  <div className=\\\"text-[11px] font-semibold text-slate-500\\\">Current Score</div>\\n                  <div className=\\\"mt-1 font-display text-2xl font-bold text-slate-800 tabular-nums\\\">\\n                    {baseEval.experimentalScore}\\n                  </div>\\n                  <div className=\\\"text-xs text-slate-500\\\">{baseEval.riskCategory}</div>\\n                </div>\\n                <div className=\\\"rounded-xl bg-white border border-[#0D9488] p-4\\\">\\n                  <div className=\\\"text-[11px] font-semibold text-[#0F766E]\\\">Simulated Score</div>\\n                  <div className=\\\"mt-1 font-display text-2xl font-bold text-[#0F766E] tabular-nums\\\">\\n                    {whatIfEval.experimentalScore}\\n                  </div>\\n                  <div className=\\\"text-xs text-[#0F766E] font-medium\\\">{whatIfEval.riskCategory}</div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"rounded-xl bg-white border border-slate-200 p-4 text-xs text-slate-700\\\">\\n                <strong>Illustrative Change:</strong>{\' \'}\\n                <span className=\\\"font-mono font-bold tabular-nums\\\">\\n                  {whatIfEval.experimentalScore - baseEval.experimentalScore > 0 ? \'+\' : \'\'}\\n                  {whatIfEval.experimentalScore - baseEval.experimentalScore} points\\n                </span>{\' \'}\\n                (Projected BMI <span className=\\\"font-mono tabular-nums\\\">{whatIfEval.bmi}</span> kg/m\302\262).\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'programme\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5 items-start\\\">\\n          <div className=\\\"lg:col-span-7 space-y-5\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                <div>\\n                  <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                    12-Month Prevention Roadmap\\n                  </h2>\\n                  <p className=\\\"text-xs text-slate-500\\\">\\n                    Phase 1: Learning (Months 1\342\200\2236) \302\267 Phase 2: Maintenance (Months 7\342\200\22312)\\n                  </p>\\n                </div>\\n                <span className=\\\"font-mono text-xs font-bold text-[#0F766E] tabular-nums\\\">\\n                  Month {programme?.currentMonth ?? 1} / 12 \302\267 Adherence {programme?.adherencePercent ?? 50}%\\n                </span>\\n              </div>\\n\\n              <div className=\\\"mt-4 grid grid-cols-1 sm:grid-cols-5 gap-2\\\">\\n                {(programme?.checkpoints || []).map((cp) => (\\n                  <div\\n                    key={cp.day}\\n                    className={`rounded-xl border p-2.5 text-xs ${\\n                      cp.status === \'completed\'\\n                        ? \'border-emerald-200 bg-emerald-50/70\'\\n                        : cp.status === \'due\'\\n                        ? \'border-amber-300 bg-amber-50/70\'\\n                        : \'border-slate-200 bg-slate-50\'\\n                    }`}\\n                  >\\n                    <div className=\\\"font-semibold text-slate-900\\\">{cp.label}</div>\\n                    <div className=\\\"mt-0.5 text-[11px] capitalize text-slate-600\\\">{cp.status}</div>\\n                  </div>\\n                ))}\\n              </div>\\n\\n              <div className=\\\"mt-5 h-52 w-full\\\">\\n                <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                  <LineChart data={progressChartData} margin={{ top: 8, right: 12, left: -18, bottom: 0 }}>\\n                    <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E2E8F0\\\" />\\n                    <XAxis dataKey=\\\"date\\\" tick={{ fontSize: 11, fill: \'#64748B\' }} />\\n                    <YAxis tick={{ fontSize: 11, fill: \'#64748B\' }} />\\n                    <Tooltip contentStyle={{ borderRadius: \'10px\', fontSize: \'12px\' }} />\\n                    <Line type=\\\"monotone\\\" dataKey=\\\"weight\\\" name=\\\"Weight (kg)\\\" stroke=\\\"#0B2540\\\" strokeWidth={2} />\\n                    <Line type=\\\"monotone\\\" dataKey=\\\"waist\\\" name=\\\"Waist (cm)\\\" stroke=\\\"#0D9488\\\" strokeWidth={2} />\\n                  </LineChart>\\n                </ResponsiveContainer>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <div className=\\\"flex items-center gap-2 mb-3\\\">\\n                <BookOpen className=\\\"h-4 w-4 text-[#0D9488]\\\" />\\n                <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                  Weekly Indian Nutrition &amp; Lifestyle Lessons\\n                </h2>\\n              </div>\\n              <div className=\\\"divide-y divide-slate-100\\\">\\n                {(programme?.lessons || []).map((les) => (\\n                  <div key={les.id} className=\\\"flex items-start justify-between gap-4 py-3\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <div className=\\\"text-xs text-slate-500\\\">\\n                        Phase {les.phase} \302\267 Week {les.week} \302\267 {les.category} \302\267 {les.durationMinutes} min\\n                      </div>\\n                      <div className=\\\"text-sm font-semibold text-slate-900 mt-0.5\\\">{les.title}</div>\\n                      <div className=\\\"text-xs text-[#0F766E]\\\">{les.titleTa}</div>\\n                      <p className=\\\"mt-1 text-xs text-slate-600\\\">{les.summary}</p>\\n                    </div>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => patient && void onToggleLesson(patient.id, les.id)}\\n                      className={`shrink-0 rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors ${\\n                        les.completed\\n                          ? \'bg-emerald-50 text-emerald-800 border border-emerald-200\'\\n                          : \'bg-[#0B2540] text-white hover:bg-[#113556]\'\\n                      }`}\\n                    >\\n                      {les.completed ? \'Completed\' : \'Mark Done\'}\\n                    </button>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 space-y-5\\\">\\n            <form\\n              onSubmit={handleSaveHabit}\\n              className=\\\"rounded-2xl border border-slate-200 bg-white p-5 space-y-3.5\\\"\\n            >\\n              <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                Log Daily Habits &amp; Weekly Check-In\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Works offline via IndexedDB. Reporting a barrier or low steps automatically evaluates the deterministic intervention ladder.\\n              </p>\\n\\n              <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Date</label>\\n                  <input\\n                    type=\\\"date\\\"\\n                    value={habitDate}\\n                    onChange={(e) => setHabitDate(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Steps Achieved</label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    min={0}\\n                    max={40000}\\n                    value={habitSteps}\\n                    onChange={(e) => setHabitSteps(Number(e.target.value))}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono tabular-nums\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-3 gap-2.5\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Sleep (hrs)</label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    step={0.5}\\n                    min={3}\\n                    max={14}\\n                    value={habitSleep}\\n                    onChange={(e) => setHabitSleep(Number(e.target.value))}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-2.5 py-2 text-xs font-mono tabular-nums\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Weight (kg)</label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    step={0.1}\\n                    value={habitWeight}\\n                    onChange={(e) => setHabitWeight(Number(e.target.value))}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-2.5 py-2 text-xs font-mono tabular-nums\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Waist (cm)</label>\\n                  <input\\n                    type=\\\"number\\\"\\n                    step={0.5}\\n                    value={habitWaist}\\n                    onChange={(e) => setHabitWaist(Number(e.target.value))}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-2.5 py-2 text-xs font-mono tabular-nums\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <label className=\\\"flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer\\\">\\n                <input\\n                  type=\\\"checkbox\\\"\\n                  checked={habitDiet}\\n                  onChange={(e) => setHabitDiet(e.target.checked)}\\n                  className=\\\"h-4 w-4 rounded accent-[#0D9488]\\\"\\n                />\\n                Followed balanced Indian plate (vegetables + dal + controlled rice/millet)\\n              </label>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                  Barriers or Symptoms (Optional \342\200\224 e.g., &quot;rain&quot;, &quot;shift fatigue&quot;, or &quot;blurred vision&quot;)\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={habitBarrier}\\n                  onChange={(e) => setHabitBarrier(e.target.value)}\\n                  placeholder=\\\"Share any challenge so your coach can adapt activities\\\"\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                />\\n              </div>\\n\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={submitting}\\n                className=\\\"w-full rounded-xl bg-[#0D9488] py-2.5 text-xs font-semibold text-white hover:bg-[#0F766E] disabled:opacity-60\\\"\\n              >\\n                {submitting ? \'Logging...\' : isOnline ? \'Log Daily Check-In\' : \'Queue Habit Log Offline\'}\\n              </button>\\n            </form>\\n\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <h3 className=\\\"font-display text-sm font-bold text-[#0B2540]\\\">\\n                Deterministic Adaptive Intervention Ladder\\n              </h3>\\n              <p className=\\\"mt-1 text-[11px] text-slate-500\\\">\\n                Clinical escalations use strict deterministic rules. Experimental educational message selection is isolated to pre-approved coaching tips only.\\n              </p>\\n\\n              <div className=\\\"mt-3 space-y-2.5\\\">\\n                {patientInterventions.length === 0 ? (\\n                  <p className=\\\"text-xs text-slate-500\\\">\\n                    No active barrier interventions triggered. Try logging &lt; 4,000 steps or a barrier note to test the ladder.\\n                  </p>\\n                ) : (\\n                  patientInterventions.slice(0, 4).map((intv) => (\\n                    <div\\n                      key={intv.id}\\n                      className={`rounded-xl border p-3 text-xs ${\\n                        intv.actionType === \'clinician_escalation\'\\n                          ? \'border-rose-200 bg-rose-50/70\'\\n                          : \'border-slate-200 bg-slate-50\'\\n                      }`}\\n                    >\\n                      <div className=\\\"font-semibold text-slate-900\\\">\\n                        Step {intv.ladderStep} \302\267 {intv.triggerRule}\\n                      </div>\\n                      <p className=\\\"mt-1 text-slate-700\\\">{intv.recommendedMessage}</p>\\n                      {intv.experimentalBanditArm && (\\n                        <div className=\\\"mt-1.5 text-[11px] text-[#0F766E]\\\">\\n                          {intv.experimentalBanditArm}\\n                        </div>\\n                      )}\\n                    </div>\\n                  ))\\n                )}\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'labs\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 space-y-4\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                Clinical Laboratory Testing Guidance\\n              </h2>\\n              <p className=\\\"mt-1 text-xs text-slate-600 leading-relaxed\\\">\\n                Lifestyle risk assessments can highlight modifiable habits, but <strong>never diagnose diabetes</strong>. Diagnostic confirmation requires laboratory blood testing ordered and interpreted by an authorised healthcare professional.\\n              </p>\\n\\n              <div className=\\\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\\\">\\n                <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-4\\\">\\n                  <div className=\\\"font-bold text-[#0B2540]\\\">HbA1c (Glycated Haemoglobin)</div>\\n                  <ul className=\\\"mt-2 space-y-1 text-slate-600 font-mono text-[11px]\\\">\\n                    <li>Normal reference: &lt; 5.7%</li>\\n                    <li>Prediabetes range: 5.7% \342\200\223 6.4%</li>\\n                    <li>Diabetes threshold: \342\211\245 6.5%</li>\\n                  </ul>\\n                </div>\\n                <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-4\\\">\\n                  <div className=\\\"font-bold text-[#0B2540]\\\">Fasting Plasma Glucose (FPG)</div>\\n                  <ul className=\\\"mt-2 space-y-1 text-slate-600 font-mono text-[11px]\\\">\\n                    <li>Normal reference: &lt; 100 mg/dL</li>\\n                    <li>Impaired fasting: 100 \342\200\223 125 mg/dL</li>\\n                    <li>Diabetes threshold: \342\211\245 126 mg/dL</li>\\n                  </ul>\\n                </div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <h3 className=\\\"font-display text-sm font-bold text-[#0B2540] mb-3\\\">\\n                Recorded Laboratory History ({patient?.name})\\n              </h3>\\n              {patientLabs.length === 0 ? (\\n                <p className=\\\"text-xs text-slate-500\\\">No laboratory records entered yet.</p>\\n              ) : (\\n                <div className=\\\"space-y-3\\\">\\n                  {patientLabs.map((lab) => (\\n                    <div key={lab.id} className=\\\"rounded-xl border border-slate-200 p-3.5 text-xs\\\">\\n                      <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                        <span className=\\\"font-mono font-bold text-[#0B2540] tabular-nums\\\">\\n                          HbA1c: {lab.hba1cPercent ?? \'\342\200\224\'}% \302\267 FPG: {lab.fastingGlucoseMgDl ?? \'\342\200\224\'} mg/dL\\n                        </span>\\n                        <span className=\\\"text-slate-500\\\">\\n                          {lab.testedAt.slice(0, 10)} \302\267 Recorded by {lab.recordedByName}\\n                        </span>\\n                      </div>\\n                      <p className=\\\"mt-1.5 text-slate-700 font-medium\\\">{lab.guidelineInterpretation}</p>\\n                      {lab.clinicalNotes && (\\n                        <p className=\\\"mt-1 text-slate-500\\\">Clinician notes: {lab.clinicalNotes}</p>\\n                      )}\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Record Laboratory Result (Clinician Only)\\n            </h3>\\n            {data.user.role === \'patient\' ? (\\n              <div className=\\\"mt-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-950 flex items-start gap-2.5\\\">\\n                <AlertTriangle className=\\\"h-4 w-4 text-amber-700 shrink-0 mt-0.5\\\" />\\n                <div>\\n                  <strong>Role Permission Boundary:</strong> Only authorised Doctors or Administrators may enter laboratory diagnostic values. Switch to the <strong>Doctor</strong> demo role in the top bar to test clinician lab recording.\\n                </div>\\n              </div>\\n            ) : (\\n              <form onSubmit={handleSaveLab} className=\\\"mt-4 space-y-3.5\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Test Date</label>\\n                  <input\\n                    type=\\\"date\\\"\\n                    required\\n                    value={labDate}\\n                    onChange={(e) => setLabDate(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono\\\"\\n                  />\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">HbA1c (%)</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      step=\\\"0.1\\\"\\n                      min=\\\"3.5\\\"\\n                      max=\\\"18\\\"\\n                      value={labHba1c}\\n                      onChange={(e) => setLabHba1c(e.target.value)}\\n                      placeholder=\\\"e.g., 6.4\\\"\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono tabular-nums\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">FPG (mg/dL)</label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min=\\\"40\\\"\\n                      max=\\\"600\\\"\\n                      value={labFpg}\\n                      onChange={(e) => setLabFpg(e.target.value)}\\n                      placeholder=\\\"e.g., 118\\\"\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono tabular-nums\\\"\\n                    />\\n                  </div>\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinician Interpretation Notes\\n                  </label>\\n                  <textarea\\n                    rows={3}\\n                    value={labNotes}\\n                    onChange={(e) => setLabNotes(e.target.value)}\\n                    placeholder=\\\"Document guideline context and follow-up plan...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={submitting || !isOnline}\\n                  className=\\\"w-full rounded-xl bg-[#0B2540] py-2.5 text-xs font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  {submitting ? \'Saving...\' : \'Save Clinician Lab Record\'}\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'register\' && (\\n        <form\\n          onSubmit={handleRegister}\\n          className=\\\"rounded-2xl border border-slate-200 bg-white p-6 max-w-3xl space-y-4\\\"\\n        >\\n          <div>\\n            <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n              Patient Registration &amp; Informed Consent\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n              Creates a shared longitudinal patient record across Prevent, Detect, and Protect. Primary languages: English and Tamil (Hindi ready).\\n            </p>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Full Name</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                minLength={2}\\n                value={regForm.name}\\n                onChange={(e) => setRegForm({ ...regForm, name: e.target.value })}\\n                placeholder=\\\"e.g., Muthuvel Krishnan\\\"\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm\\\"\\n              />\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Age</label>\\n                <input\\n                  type=\\\"number\\\"\\n                  required\\n                  min={18}\\n                  max={100}\\n                  value={regForm.age}\\n                  onChange={(e) => setRegForm({ ...regForm, age: Number(e.target.value) })}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Sex</label>\\n                <select\\n                  value={regForm.sex}\\n                  onChange={(e) =>\\n                    setRegForm({ ...regForm, sex: e.target.value as \'Female\' | \'Male\' | \'Other\' })\\n                  }\\n                  className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm\\\"\\n                >\\n                  <option value=\\\"Female\\\">Female</option>\\n                  <option value=\\\"Male\\\">Male</option>\\n                  <option value=\\\"Other\\\">Other</option>\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Phone</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={regForm.phone}\\n                onChange={(e) => setRegForm({ ...regForm, phone: e.target.value })}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Preferred Language</label>\\n              <select\\n                value={regForm.language}\\n                onChange={(e) =>\\n                  setRegForm({ ...regForm, language: e.target.value as LanguageCode })\\n                }\\n                className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm\\\"\\n              >\\n                <option value=\\\"en\\\">English</option>\\n                <option value=\\\"ta\\\">\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215 (Tamil)</option>\\n                <option value=\\\"hi\\\">\340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200 (Hindi Scaffold)</option>\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">District</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={regForm.district}\\n                onChange={(e) => setRegForm({ ...regForm, district: e.target.value })}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">PHC / Ward / Village</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={regForm.villageOrWard}\\n                onChange={(e) => setRegForm({ ...regForm, villageOrWard: e.target.value })}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n              Baseline Clinical Status (Recorded by Patient/Clinician)\\n            </label>\\n            <select\\n              value={regForm.diabetesStatus}\\n              onChange={(e) =>\\n                setRegForm({\\n                  ...regForm,\\n                  diabetesStatus: e.target.value as \'at_risk\' | \'prediabetes_lab\' | \'diagnosed_t2d\',\\n                })\\n              }\\n              className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm\\\"\\n            >\\n              <option value=\\\"at_risk\\\">Lifestyle Prevention Cohort (No Diabetes Diagnosis)</option>\\n              <option value=\\\"prediabetes_lab\\\">Prediabetes (Lab Confirmed by Clinician)</option>\\n              <option value=\\\"diagnosed_t2d\\\">Already Diagnosed with Type 2 Diabetes (Eligible for Retinal Screening)</option>\\n            </select>\\n          </div>\\n\\n          <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-2.5 text-xs text-slate-700\\\">\\n            <div className=\\\"font-bold text-[#0B2540]\\\">Mandatory Informed Consent</div>\\n            <label className=\\\"flex items-start gap-2 cursor-pointer\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                required\\n                checked={regForm.screeningConsent}\\n                onChange={(e) => setRegForm({ ...regForm, screeningConsent: e.target.checked })}\\n                className=\\\"mt-0.5 h-4 w-4 accent-[#0D9488]\\\"\\n              />\\n              <span>I consent to participate in lifestyle risk screening and prevention programme tracking.</span>\\n            </label>\\n            <label className=\\\"flex items-start gap-2 cursor-pointer\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                required\\n                checked={regForm.dataStorageConsent}\\n                onChange={(e) => setRegForm({ ...regForm, dataStorageConsent: e.target.checked })}\\n                className=\\\"mt-0.5 h-4 w-4 accent-[#0D9488]\\\"\\n              />\\n              <span>I consent to longitudinal record storage shared with my assigned healthcare team.</span>\\n            </label>\\n            <label className=\\\"flex items-start gap-2 cursor-pointer\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                checked={regForm.offlineCacheConsent}\\n                onChange={(e) => setRegForm({ ...regForm, offlineCacheConsent: e.target.checked })}\\n                className=\\\"mt-0.5 h-4 w-4 accent-[#0D9488]\\\"\\n              />\\n              <span>Allow minimized local IndexedDB caching for offline habit tracking.</span>\\n            </label>\\n            <label className=\\\"flex items-start gap-2 cursor-pointer\\\">\\n              <input\\n                type=\\\"checkbox\\\"\\n                required\\n                checked={regForm.clinicalBoundaryAcknowledged}\\n                onChange={(e) =>\\n                  setRegForm({ ...regForm, clinicalBoundaryAcknowledged: e.target.checked })\\n                }\\n                className=\\\"mt-0.5 h-4 w-4 accent-[#0D9488]\\\"\\n              />\\n              <span>\\n                I understand Mritidhristi is a non-diagnostic screening prototype and does not replace physician diagnosis.\\n              </span>\\n            </label>\\n          </div>\\n\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={submitting || !isOnline}\\n            className=\\\"rounded-xl bg-[#0D9488] px-6 py-2.5 text-xs font-semibold text-white hover:bg-[#0F766E] disabled:opacity-50\\\"\\n          >\\n            {submitting ? \'Registering...\' : \'Register Patient & Create Programme\'}\\n          </button>\\n        </form>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create PreventModule with 9-input lifestyle assessment, What-If simulator, 12-month prevention programme, lab guidance, and patient registration\", \"Overwrite\":true, \"TargetFile\":\"/src/views/PreventModule.tsx\", \"toolAction\":\"Creating PreventModule view\", \"toolSummary\":\"Create src/views/PreventModule.tsx\"}"
      thinking_signature: "\022\233\002\n\230\002\001i\024}\023 \f\246Q\201\201E\337\252\030<9\022\271\3731\250\3764\360N\244xw\263\232T\217\031\321\261\237\225G\361\005\250\371#/s\377\211M_ \220M)UW\t\341\257\373\274iA\263n\210\341C\363\267I\253\037\241\3009\227ptZ\352p\t\317\254\v\261\300\351Z\270\377\213\217\252\006\255\244\275N0\177\'\372\345v\002E\313\t8@\250\363\366\271Fo\025\006\265P(j\3721+\273\355e\377H\006\210\"F\205\331I\315\211T-}\324%\202\2269!\225\367\005\270!{\025\311\206\215\302T\024\267\213\237\256\260\242=PL_\234N\246\240.-\036+T4\252\275F0\b \230\362[gd\355B\266?*\004\304o\020\033\201\200)^\022\272>\220~cK\024\214\177.\b\257\331\024F=3\az\372\032\222\266\342\363b|\000LI\225\264\254T_t\314\315\346\274\226r\214Y\267\221|T\033\'C \025\023A\373\364\350j\246\t\252\037x\265}\215\377\271\361["
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_831467689216051824"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  CheckCircle2,\\n  Database,\\n  Eye,\\n  FileCheck2,\\n  Layers,\\n  ShieldAlert,\\n  Upload,\\n} from \'lucide-react\';\\nimport type { BootstrapPayload, RetinalScreening } from \'../types/domain\';\\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\\nimport {\\n  analyzeRetinalCanvasPixels,\\n  renderSyntheticFundusToCanvas,\\n  type PipelineAnalysisOutput,\\n  type RetinalPresetKey,\\n} from \'../utils/retinalPipeline\';\\n\\ninterface DetectModuleProps {\\n  data: BootstrapPayload;\\n  selectedPatientId: string;\\n  onSelectPatient: (id: string) => void;\\n  isOnline: boolean;\\n  onSubmitScreening: (\\n    payload: Omit<RetinalScreening, \'id\' | \'capturedAt\' | \'humanReviewStatus\' | \'summaryText\'>\\n  ) => Promise<void>;\\n  onNavigateProtect: () => void;\\n}\\n\\nconst SEVEN_STEPS = [\\n  { num: 1, title: \'Image Quality Assessment\', stage: \'raw\' as const },\\n  { num: 2, title: \'Enhancement & CLAHE Preprocessing\', stage: \'preprocessed\' as const },\\n  { num: 3, title: \'Anatomical Structure Detection\', stage: \'anatomy\' as const },\\n  { num: 4, title: \'Lesion Detection (Illustrative)\', stage: \'lesions\' as const },\\n  { num: 5, title: \'CNN ICDR 5-Class DR Grading\', stage: \'raw\' as const },\\n  { num: 6, title: \'Grad-CAM Explainability\', stage: \'gradcam\' as const },\\n  { num: 7, title: \'Annotated Report Generation\', stage: \'gradcam\' as const },\\n];\\n\\nconst DATASET_SPECS = [\\n  {\\n    name: \'APTOS 2019 Blindness Detection\',\\n    role: \'Primary DR grading experiments (5-class ICDR 0\342\200\2234)\',\\n    splitRule: \'Stratified split with duplicate/near-duplicate hash check; never mixed into external test fold.\',\\n    metrics: \'Sensitivity, Specificity, Quadratic Weighted Kappa, Macro F1, ROC-AUC\',\\n    status: \'Loader & validation interface defined (no weights fabricated)\',\\n  },\\n  {\\n    name: \'IDRiD (Indian Diabetic Retinopathy Image Dataset)\',\\n    role: \'Indian fundus grading + pixel-level lesion segmentation (EX, HE, SE, MA)\',\\n    splitRule: \'Strict official train/test partition preserving Indian clinical imaging characteristics.\',\\n    metrics: \'AUC-PR for Hard Exudates & Haemorrhages; Microaneurysm experimental benchmark\',\\n    status: \'Lesion mask & Indian calibration interface ready\',\\n  },\\n  {\\n    name: \'DRIVE (Digital Retinal Images for Vessel Extraction)\',\\n    role: \'Retinal vessel segmentation & anatomical landmark verification\',\\n    splitRule: \'Used exclusively for Step 3 vessel/optic-disc anatomy \342\200\224 NEVER interchanged with DR grading labels.\',\\n    metrics: \'Vessel Dice / IoU, Sensitivity, Specificity\',\\n    status: \'Anatomy pipeline specification documented\',\\n  },\\n  {\\n    name: \'Messidor-2\',\\n    role: \'External validation cohort (held-out out-of-distribution generalization)\',\\n    splitRule: \'Zero training exposure; strict patient-level eye pairing to prevent leakage.\',\\n    metrics: \'Referable DR (\342\211\245 Grade 2) Sensitivity, Specificity, External AUC\',\\n    status: \'External evaluation harness ready (access-gated dataset)\',\\n  },\\n];\\n\\nexport const DetectModule: React.FC<DetectModuleProps> = ({\\n  data,\\n  selectedPatientId,\\n  onSelectPatient,\\n  isOnline,\\n  onSubmitScreening,\\n  onNavigateProtect,\\n}) => {\\n  const [subTab, setSubTab] = useState<\'pipeline\' | \'datasets\' | \'history\'>(\'pipeline\');\\n  const [preset, setPreset] = useState<\\n    \'normal_demo\' | \'moderate_npdr_demo\' | \'ungradable_blur_demo\' | \'uploaded_custom\'\\n  >(\'moderate_npdr_demo\');\\n  const [customDataUrl, setCustomDataUrl] = useState<string | undefined>(undefined);\\n  const [eye, setEye] = useState<\'Left (OS)\' | \'Right (OD)\'>(\'Left (OS)\');\\n  const [cameraSource, setCameraSource] = useState(\\n    \'Remidio FOP Non-Mydriatic Fundus Camera (Synthetic Demo)\'\\n  );\\n  const [activeStep, setActiveStep] = useState(1);\\n  const [gradCamOpacity, setGradCamOpacity] = useState(0.65);\\n  const [compareSideBySide, setCompareSideBySide] = useState(true);\\n  const [analysis, setAnalysis] = useState<PipelineAnalysisOutput | null>(null);\\n  const [submitting, setSubmitting] = useState(false);\\n  const [feedback, setFeedback] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n\\n  const hiddenCanvasRef = useRef<HTMLCanvasElement | null>(null);\\n\\n  const patient =\\n    data.patients.find((p) => p.id === selectedPatientId) || data.patients[0];\\n  const isEligible = patient?.diabetesStatus === \'diagnosed_t2d\';\\n  const patientScreenings = data.screenings.filter((s) => s.patientId === patient?.id);\\n\\n  useEffect(() => {\\n    const canvas = hiddenCanvasRef.current;\\n    if (!canvas) return;\\n    const ctx = canvas.getContext(\'2d\');\\n    if (!ctx) return;\\n\\n    if (preset === \'uploaded_custom\' && customDataUrl) {\\n      const img = new Image();\\n      img.onload = () => {\\n        canvas.width = Math.min(512, img.width);\\n        canvas.height = Math.min(512, img.height);\\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\\n        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);\\n        setAnalysis(analyzeRetinalCanvasPixels(canvas, \'uploaded_custom\'));\\n      };\\n      img.src = customDataUrl;\\n    } else {\\n      canvas.width = 384;\\n      canvas.height = 384;\\n      const demoKey: RetinalPresetKey =\\n        preset === \'uploaded_custom\' ? \'normal_demo\' : preset;\\n      renderSyntheticFundusToCanvas(canvas, demoKey, { stage: \'raw\' });\\n      setAnalysis(analyzeRetinalCanvasPixels(canvas, demoKey));\\n    }\\n  }, [preset, customDataUrl]);\\n\\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    setFeedback(null);\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    if (![\'image/png\', \'image/jpeg\', \'image/webp\'].includes(file.type)) {\\n      setFeedback({\\n        type: \'error\',\\n        text: \'Upload rejected: Only PNG, JPEG, or WebP fundus images are permitted.\',\\n      });\\n      return;\\n    }\\n    if (file.size > 4.5 * 1024 * 1024) {\\n      setFeedback({\\n        type: \'error\',\\n        text: \'Upload rejected: File exceeds 4.5 MB safety limit.\',\\n      });\\n      return;\\n    }\\n    const reader = new FileReader();\\n    reader.onload = () => {\\n      if (typeof reader.result === \'string\') {\\n        setCustomDataUrl(reader.result);\\n        setPreset(\'uploaded_custom\');\\n        setCameraSource(`Uploaded File: ${file.name}`);\\n        setActiveStep(1);\\n      }\\n    };\\n    reader.readAsDataURL(file);\\n  };\\n\\n  const handleSubmitReport = async () => {\\n    if (!patient || !analysis) return;\\n    setSubmitting(true);\\n    setFeedback(null);\\n    try {\\n      await onSubmitScreening({\\n        patientId: patient.id,\\n        eye,\\n        cameraSource,\\n        imagePreset: preset,\\n        imageDataUrl: preset === \'uploaded_custom\' ? customDataUrl : undefined,\\n        quality: analysis.quality,\\n        anatomicalStructures: analysis.anatomicalStructures,\\n        lesionFindings: analysis.lesionFindings,\\n        modelPrediction: analysis.modelPrediction,\\n        gradCam: analysis.gradCam,\\n      });\\n      setFeedback({\\n        type: \'success\',\\n        text: analysis.quality.gradable\\n          ? \'Annotated screening report saved and queued for mandatory Doctor Review in Pillar 3 (Protect).\'\\n          : \'Ungradable image rejection recorded in patient history with recapture recommendation.\',\\n      });\\n    } catch (err) {\\n      setFeedback({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Unable to save retinal screening.\',\\n      });\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const currentStage = SEVEN_STEPS[activeStep - 1]?.stage ?? \'raw\';\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      <canvas ref={hiddenCanvasRef} className=\\\"hidden\\\" />\\n\\n      <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-[#12598C]\\\">\\n            Pillar Two \302\267 AI-Assisted Diabetic Retinopathy Screening (7-Step Pipeline)\\n          </p>\\n          <h1 className=\\\"font-display text-2xl font-bold text-[#0B2540]\\\">\\n            DETECT \342\200\224 Retinal Screening &amp; Explainable AI\\n          </h1>\\n        </div>\\n\\n        {data.patients.length > 1 && (\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label htmlFor=\\\"detect-patient\\\" className=\\\"text-xs font-semibold text-slate-600\\\">\\n              Patient:\\n            </label>\\n            <select\\n              id=\\\"detect-patient\\\"\\n              value={patient?.id || \'\'}\\n              onChange={(e) => onSelectPatient(e.target.value)}\\n              className=\\\"rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800\\\"\\n            >\\n              {data.patients.map((p) => (\\n                <option key={p.id} value={p.id}>\\n                  {p.name} ({p.mrn}) \302\267 {p.diabetesStatus === \'diagnosed_t2d\' ? \'Diagnosed T2D\' : \'Not T2D\'}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        )}\\n      </div>\\n\\n      {!isEligible && patient && (\\n        <div className=\\\"rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-950 flex items-start gap-2.5\\\">\\n          <AlertTriangle className=\\\"h-4 w-4 text-amber-700 shrink-0 mt-0.5\\\" />\\n          <div>\\n            <strong>Eligibility Clinical Boundary:</strong> Diabetic retinopathy screening is intended for individuals already diagnosed with diabetes. <strong>{patient.name}</strong> is currently classified as <em>{patient.diabetesStatus}</em>. Confirm clinical eligibility or laboratory diagnosis before screening.\\n          </div>\\n        </div>\\n      )}\\n\\n      <div className=\\\"flex flex-wrap gap-1.5 rounded-xl bg-slate-200/70 p-1\\\">\\n        {[\\n          { id: \'pipeline\', label: \'Acquisition & 7-Step Pipeline\', icon: Layers },\\n          { id: \'datasets\', label: \'Dataset Architecture (APTOS/IDRiD/DRIVE/Messidor-2)\', icon: Database },\\n          { id: \'history\', label: `Screening History (${patientScreenings.length})`, icon: FileCheck2 },\\n        ].map((tab) => {\\n          const Icon = tab.icon;\\n          const active = subTab === tab.id;\\n          return (\\n            <button\\n              key={tab.id}\\n              type=\\\"button\\\"\\n              onClick={() => setSubTab(tab.id as typeof subTab)}\\n              className={`inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-xs font-semibold transition-colors whitespace-nowrap ${\\n                active ? \'bg-white text-[#0B2540] shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              <Icon className=\\\"h-3.5 w-3.5 text-[#12598C]\\\" />\\n              {tab.label}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {feedback && (\\n        <div\\n          className={`rounded-xl border px-4 py-3 text-xs font-medium flex items-center justify-between gap-3 ${\\n            feedback.type === \'success\'\\n              ? \'border-emerald-200 bg-emerald-50 text-emerald-900\'\\n              : \'border-rose-200 bg-rose-50 text-rose-900\'\\n          }`}\\n        >\\n          <span>{feedback.text}</span>\\n          {feedback.type === \'success\' && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onNavigateProtect}\\n              className=\\\"shrink-0 rounded-lg bg-[#0B2540] px-3 py-1.5 text-xs font-semibold text-white\\\"\\n            >\\n              Go to Doctor Review \342\206\222\\n            </button>\\n          )}\\n        </div>\\n      )}\\n\\n      {subTab === \'pipeline\' && (\\n        <div className=\\\"grid grid-cols-1 xl:grid-cols-12 gap-5 items-start\\\">\\n          <div className=\\\"xl:col-span-4 space-y-4\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5 space-y-3.5\\\">\\n              <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                A. Retinal Image Acquisition\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Upload a retinal image (PNG/JPEG/WebP, max 4.5MB) or select a synthetic demonstration capture to inspect all 7 stages.\\n              </p>\\n\\n              <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                <div>\\n                  <label className=\\\"block text-[11px] font-semibold text-slate-600 mb-1\\\">Eye</label>\\n                  <select\\n                    value={eye}\\n                    onChange={(e) => setEye(e.target.value as \'Left (OS)\' | \'Right (OD)\')}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"Left (OS)\\\">Left (OS)</option>\\n                    <option value=\\\"Right (OD)\\\">Right (OD)</option>\\n                  </select>\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-[11px] font-semibold text-slate-600 mb-1\\\">Demo Sample</label>\\n                  <select\\n                    value={preset}\\n                    onChange={(e) => {\\n                      const val = e.target.value as typeof preset;\\n                      setPreset(val);\\n                      if (val !== \'uploaded_custom\') {\\n                        setCameraSource(\'Remidio FOP Non-Mydriatic Fundus Camera (Synthetic Demo)\');\\n                      }\\n                    }}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"normal_demo\\\">Synthetic: Normal (Grade 0)</option>\\n                    <option value=\\\"moderate_npdr_demo\\\">Synthetic: Moderate NPDR</option>\\n                    <option value=\\\"ungradable_blur_demo\\\">Synthetic: Blurred Ungradable</option>\\n                    {customDataUrl && <option value=\\\"uploaded_custom\\\">Uploaded Custom Image</option>}\\n                  </select>\\n                </div>\\n              </div>\\n\\n              <label className=\\\"flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 text-xs font-semibold text-[#0B2540] hover:bg-slate-100 transition-colors\\\">\\n                <Upload className=\\\"h-4 w-4 text-[#0D9488]\\\" />\\n                <span>Upload Retinal Image File</span>\\n                <input\\n                  type=\\\"file\\\"\\n                  accept=\\\"image/png,image/jpeg,image/webp\\\"\\n                  onChange={handleFileUpload}\\n                  className=\\\"hidden\\\"\\n                />\\n              </label>\\n\\n              <div>\\n                <label className=\\\"block text-[11px] font-semibold text-slate-600 mb-1\\\">\\n                  Camera / Source Metadata\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={cameraSource}\\n                  onChange={(e) => setCameraSource(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <h2 className=\\\"font-display text-sm font-bold text-[#0B2540] mb-3\\\">\\n                B. Seven-Step Processing Pipeline\\n              </h2>\\n              <div className=\\\"space-y-1.5\\\">\\n                {SEVEN_STEPS.map((st) => {\\n                  const active = activeStep === st.num;\\n                  const blocked =\\n                    st.num > 1 && analysis && !analysis.quality.gradable && st.num < 7;\\n                  return (\\n                    <button\\n                      key={st.num}\\n                      type=\\\"button\\\"\\n                      onClick={() => setActiveStep(st.num)}\\n                      className={`flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-xs transition-colors ${\\n                        active\\n                          ? \'bg-[#0B2540] text-white font-semibold\'\\n                          : \'text-slate-700 hover:bg-slate-100\'\\n                      }`}\\n                    >\\n                      <span\\n                        className={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full font-mono text-[11px] ${\\n                          active\\n                            ? \'bg-[#0D9488] text-white\'\\n                            : blocked\\n                            ? \'bg-rose-100 text-rose-700\'\\n                            : \'bg-slate-200 text-slate-700\'\\n                        }`}\\n                      >\\n                        {st.num}\\n                      </span>\\n                      <span className=\\\"truncate flex-1\\\">{st.title}</span>\\n                      {blocked && (\\n                        <span className=\\\"text-[10px] font-semibold text-rose-500\\\">Halted</span>\\n                      )}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"xl:col-span-8 space-y-5\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3 mb-4\\\">\\n                <div>\\n                  <div className=\\\"text-xs font-semibold text-[#12598C]\\\">\\n                    Step {activeStep} of 7 \302\267 Prototype Demonstration Mode (Illustrative Outputs Clearly Labelled)\\n                  </div>\\n                  <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n                    {SEVEN_STEPS[activeStep - 1].title}\\n                  </h2>\\n                </div>\\n\\n                {activeStep === 6 && (\\n                  <div className=\\\"flex items-center gap-3 text-xs\\\">\\n                    <label className=\\\"flex items-center gap-1.5 cursor-pointer\\\">\\n                      <input\\n                        type=\\\"checkbox\\\"\\n                        checked={compareSideBySide}\\n                        onChange={(e) => setCompareSideBySide(e.target.checked)}\\n                        className=\\\"accent-[#0D9488]\\\"\\n                      />\\n                      Side-by-side\\n                    </label>\\n                    <label className=\\\"flex items-center gap-2\\\">\\n                      <span>Heatmap</span>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={0.15}\\n                        max={0.95}\\n                        step={0.05}\\n                        value={gradCamOpacity}\\n                        onChange={(e) => setGradCamOpacity(Number(e.target.value))}\\n                        className=\\\"w-20 accent-[#0D9488]\\\"\\n                      />\\n                    </label>\\n                  </div>\\n                )}\\n              </div>\\n\\n              <div\\n                className={`grid gap-4 ${\\n                  activeStep === 6 && compareSideBySide\\n                    ? \'grid-cols-1 sm:grid-cols-2\'\\n                    : \'grid-cols-1 md:grid-cols-12 items-start\'\\n                }`}\\n              >\\n                {activeStep === 6 && compareSideBySide ? (\\n                  <>\\n                    <FundusVisualizer\\n                      preset={preset}\\n                      imageDataUrl={customDataUrl}\\n                      stage=\\\"raw\\\"\\n                      size={320}\\n                      className=\\\"aspect-square w-full max-w-[340px] mx-auto\\\"\\n                      label=\\\"Original Fundus Capture\\\"\\n                    />\\n                    <FundusVisualizer\\n                      preset={preset}\\n                      imageDataUrl={customDataUrl}\\n                      stage=\\\"gradcam\\\"\\n                      gradCamOpacity={gradCamOpacity}\\n                      hotspots={analysis?.gradCam.hotspots}\\n                      size={320}\\n                      className=\\\"aspect-square w-full max-w-[340px] mx-auto\\\"\\n                      label=\\\"Grad-CAM Explainability Overlay (Illustrative)\\\"\\n                    />\\n                  </>\\n                ) : (\\n                  <>\\n                    <div className=\\\"md:col-span-6\\\">\\n                      <FundusVisualizer\\n                        preset={preset}\\n                        imageDataUrl={customDataUrl}\\n                        stage={currentStage}\\n                        gradCamOpacity={gradCamOpacity}\\n                        hotspots={analysis?.gradCam.hotspots}\\n                        size={340}\\n                        className=\\\"aspect-square w-full max-w-[340px] mx-auto\\\"\\n                        label={`Stage ${activeStep}: ${SEVEN_STEPS[activeStep - 1].title}`}\\n                      />\\n                    </div>\\n\\n                    <div className=\\\"md:col-span-6 space-y-3 text-xs\\\">\\n                      {analysis && (\\n                        <>\\n                          <div\\n                            className={`rounded-xl border p-4 ${\\n                              analysis.quality.gradable\\n                                ? \'border-emerald-200 bg-emerald-50/50\'\\n                                : \'border-rose-300 bg-rose-50\'\\n                            }`}\\n                          >\\n                            <div className=\\\"flex items-center gap-2 font-bold text-slate-900\\\">\\n                              {analysis.quality.gradable ? (\\n                                <CheckCircle2 className=\\\"h-4 w-4 text-emerald-600\\\" />\\n                              ) : (\\n                                <ShieldAlert className=\\\"h-4 w-4 text-rose-600\\\" />\\n                              )}\\n                              <span>\\n                                Step 1 Quality Gate:{\' \'}\\n                                {analysis.quality.gradable ? \'GRADABLE\' : \'UNGRADABLE \342\200\224 REJECTED\'}\\n                              </span>\\n                            </div>\\n                            <div className=\\\"mt-2 grid grid-cols-2 gap-2 font-mono text-[11px] text-slate-700 tabular-nums\\\">\\n                              <div>Sharpness: {analysis.quality.sharpnessScore}/100</div>\\n                              <div>Brightness: {analysis.quality.brightnessMean}/255</div>\\n                              <div>Clipped Exposure: {analysis.quality.exposureClipPercent}%</div>\\n                              <div>\\n                                Resolution: {analysis.quality.width}\303\227{analysis.quality.height}\\n                              </div>\\n                            </div>\\n                            {!analysis.quality.gradable && (\\n                              <div className=\\\"mt-2.5 text-rose-900 space-y-1\\\">\\n                                <div>\\n                                  <strong>Reason:</strong> {analysis.quality.rejectionReason}\\n                                </div>\\n                                <div>\\n                                  <strong>Recapture Guidance:</strong> {analysis.quality.recaptureGuidance}\\n                                </div>\\n                              </div>\\n                            )}\\n                          </div>\\n\\n                          <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-1.5\\\">\\n                            <div className=\\\"font-bold text-[#0B2540]\\\">\\n                              Anatomy &amp; Lesion Candidates ({analysis.lesionFindings.implementationStatus})\\n                            </div>\\n                            <div className=\\\"text-slate-700\\\">\\n                              Optic Disc: {analysis.anatomicalStructures.opticDiscDetected ? \'Localized\' : \'Not resolved\'} \302\267\\n                              Macula: {analysis.anatomicalStructures.maculaCentered ? \'Centered\' : \'Off-axis\'} \302\267\\n                              Vessel Index:{\' \'}\\n                              <span className=\\\"font-mono tabular-nums\\\">\\n                                {analysis.anatomicalStructures.vesselDensityIndex}\\n                              </span>\\n                            </div>\\n                            <div className=\\\"text-slate-700\\\">\\n                              Hard Exudates:{\' \'}\\n                              <strong>{analysis.lesionFindings.hardExudatesFlag ? \'Candidate Flagged\' : \'None Flagged\'}</strong>{\' \'}\\n                              \302\267 Haemorrhages:{\' \'}\\n                              <strong>{analysis.lesionFindings.haemorrhagesFlag ? \'Candidate Flagged\' : \'None Flagged\'}</strong>\\n                            </div>\\n                            <p className=\\\"text-[11px] text-slate-500\\\">\\n                              {analysis.lesionFindings.microaneurysmsExperimentalNote}\\n                            </p>\\n                          </div>\\n\\n                          <div\\n                            className={`rounded-xl border p-4 space-y-1.5 ${\\n                              analysis.modelPrediction.gradeWithheld\\n                                ? \'border-amber-300 bg-amber-50/80\'\\n                                : \'border-sky-200 bg-sky-50/60\'\\n                            }`}\\n                          >\\n                            <div className=\\\"font-bold text-[#0B2540]\\\">\\n                              Step 5 Screening Output &amp; Reliability Gate\\n                            </div>\\n                            <div className=\\\"text-sm font-bold text-slate-900\\\">\\n                              {analysis.modelPrediction.gradeLabel}\\n                            </div>\\n                            <div className=\\\"font-mono text-[11px] text-slate-600 tabular-nums\\\">\\n                              Confidence: {Math.round(analysis.modelPrediction.confidence * 100)}% \302\267\\n                              Uncertainty: {Math.round(analysis.modelPrediction.uncertainty * 100)}% \302\267\\n                              OOD Flag: {analysis.modelPrediction.oodFlag ? \'YES (Withheld)\' : \'No\'}\\n                            </div>\\n                            {analysis.modelPrediction.withholdReason && (\\n                              <p className=\\\"text-amber-950 font-medium\\\">\\n                                Safe Withholding Active: {analysis.modelPrediction.withholdReason}\\n                              </p>\\n                            )}\\n                            <p className=\\\"text-[11px] text-slate-600\\\">\\n                              Model: {analysis.modelPrediction.modelVersion} \302\267 Requires mandatory clinician review.\\n                            </p>\\n                          </div>\\n                        </>\\n                      )}\\n                    </div>\\n                  </>\\n                )}\\n              </div>\\n\\n              {activeStep >= 6 && analysis && (\\n                <div className=\\\"mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-700\\\">\\n                  <strong>Grad-CAM Explainability Limitation:</strong> {analysis.gradCam.limitationNotice}\\n                </div>\\n              )}\\n\\n              <div className=\\\"mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4\\\">\\n                <div className=\\\"text-xs text-slate-500\\\">\\n                  Submitting creates a shared annotated report linked to <strong>{patient?.name}</strong> and notifies the reviewing doctor.\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={submitting || !analysis || !isOnline}\\n                  onClick={() => void handleSubmitReport()}\\n                  className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#0D9488] px-5 py-2.5 text-xs font-semibold text-white hover:bg-[#0F766E] disabled:opacity-50\\\"\\n                >\\n                  <Eye className=\\\"h-4 w-4\\\" />\\n                  {submitting\\n                    ? \'Generating Report...\'\\n                    : isOnline\\n                    ? \'Generate & Submit Annotated Report (Step 7)\'\\n                    : \'Requires Connectivity to Submit for Doctor Review\'}\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'datasets\' && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-6 space-y-4\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n              Dataset Integration &amp; Evaluation Governance\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-slate-600 leading-relaxed max-w-3xl\\\">\\n              Mritidhristi never treats retinal datasets as interchangeable and never fabricates training accuracy, AUC, or clinical weights. Each dataset serves a strict role with patient-level splits and leakage prevention.\\n            </p>\\n          </div>\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            {DATASET_SPECS.map((ds) => (\\n              <div key={ds.name} className=\\\"rounded-xl border border-slate-200 p-4 space-y-2 text-xs\\\">\\n                <div className=\\\"font-display text-sm font-bold text-[#0B2540]\\\">{ds.name}</div>\\n                <div className=\\\"text-slate-700\\\">\\n                  <strong>Role:</strong> {ds.role}\\n                </div>\\n                <div className=\\\"text-slate-600\\\">\\n                  <strong>Leakage &amp; Split Rule:</strong> {ds.splitRule}\\n                </div>\\n                <div className=\\\"text-slate-600\\\">\\n                  <strong>Evaluation Metrics:</strong> {ds.metrics}\\n                </div>\\n                <div className=\\\"pt-1 font-semibold text-[#0F766E]\\\">{ds.status}</div>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'history\' && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n          <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n            Retinal Screening History \342\200\224 {patient?.name}\\n          </h2>\\n          {patientScreenings.length === 0 ? (\\n            <p className=\\\"text-xs text-slate-500\\\">No retinal screenings recorded for this patient yet.</p>\\n          ) : (\\n            <div className=\\\"space-y-3\\\">\\n              {patientScreenings.map((scr) => (\\n                <div\\n                  key={scr.id}\\n                  className=\\\"flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-xl border border-slate-200 p-4 text-xs\\\"\\n                >\\n                  <FundusVisualizer\\n                    preset={scr.imagePreset}\\n                    imageDataUrl={scr.imageDataUrl}\\n                    stage=\\\"gradcam\\\"\\n                    hotspots={scr.gradCam.hotspots}\\n                    size={100}\\n                    className=\\\"h-20 w-20 shrink-0\\\"\\n                  />\\n                  <div className=\\\"min-w-0 flex-1 space-y-1\\\">\\n                    <div className=\\\"font-semibold text-slate-900\\\">\\n                      {scr.eye} \302\267 {scr.modelPrediction.gradeLabel}\\n                    </div>\\n                    <div className=\\\"text-slate-500 font-mono text-[11px] tabular-nums\\\">\\n                      {new Date(scr.capturedAt).toLocaleString()} \302\267 Sharpness {scr.quality.sharpnessScore}/100 \302\267\\n                      Review: <strong className=\\\"text-slate-800\\\">{scr.humanReviewStatus}</strong>\\n                    </div>\\n                    <p className=\\\"text-slate-600\\\">{scr.summaryText}</p>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DetectModule with retinal acquisition, 7-step canvas processing pipeline, OOD/quality safety withholding, Grad-CAM comparison, and dataset specs\", \"Overwrite\":true, \"TargetFile\":\"/src/views/DetectModule.tsx\", \"toolAction\":\"Creating DetectModule view\", \"toolSummary\":\"Create src/views/DetectModule.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_831467689216052273"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Calendar,\\n  CheckCircle2,\\n  ClipboardCheck,\\n  Send,\\n  Stethoscope,\\n  UserCheck,\\n} from \'lucide-react\';\\nimport type {\\n  AppointmentRecord,\\n  BootstrapPayload,\\n  DoctorReview,\\n  FollowUpRecord,\\n  ReferralRecord,\\n} from \'../types/domain\';\\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\\n\\ninterface ProtectModuleProps {\\n  data: BootstrapPayload;\\n  selectedPatientId: string;\\n  onSelectPatient: (id: string) => void;\\n  isOnline: boolean;\\n  onSubmitReview: (payload: {\\n    screeningId: string;\\n    decision: DoctorReview[\'decision\'];\\n    clinicianGrade: string;\\n    triageCategory: DoctorReview[\'triageCategory\'];\\n    clinicalNotes: string;\\n    recommendedNextSteps: string;\\n  }) => Promise<void>;\\n  onCreateReferral: (payload: {\\n    patientId: string;\\n    screeningId?: string;\\n    targetFacility: string;\\n    specialty: ReferralRecord[\'specialty\'];\\n    urgency: ReferralRecord[\'urgency\'];\\n    reason: string;\\n  }) => Promise<void>;\\n  onUpdateReferral: (\\n    id: string,\\n    status: ReferralRecord[\'status\'],\\n    specialistFindings?: string\\n  ) => Promise<void>;\\n  onCreateAppointment: (payload: {\\n    patientId: string;\\n    title: string;\\n    facility: string;\\n    clinicianName: string;\\n    scheduledDate: string;\\n    scheduledTime: string;\\n    type: AppointmentRecord[\'type\'];\\n    reminderNote: string;\\n  }) => Promise<void>;\\n  onUpdateAppointment: (\\n    id: string,\\n    status: AppointmentRecord[\'status\'],\\n    escalated?: boolean\\n  ) => Promise<void>;\\n  onCreateFollowUp: (payload: {\\n    patientId: string;\\n    healthWorkerName: string;\\n    dueDate: string;\\n    channel: FollowUpRecord[\'channel\'];\\n    status: FollowUpRecord[\'status\'];\\n    outcomeNotes: string;\\n    nextScreeningDate?: string;\\n  }) => Promise<void>;\\n}\\n\\nexport const ProtectModule: React.FC<ProtectModuleProps> = ({\\n  data,\\n  selectedPatientId,\\n  onSelectPatient,\\n  isOnline,\\n  onSubmitReview,\\n  onCreateReferral,\\n  onUpdateReferral,\\n  onCreateAppointment,\\n  onUpdateAppointment,\\n  onCreateFollowUp,\\n}) => {\\n  const [subTab, setSubTab] = useState<\'review\' | \'referrals\' | \'appointments\' | \'continuity\'>(\'review\');\\n  const [msg, setMsg] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n  const [busy, setBusy] = useState(false);\\n\\n  const patient = data.patients.find((p) => p.id === selectedPatientId) || data.patients[0];\\n  const screenings = data.screenings.filter((s) => s.patientId === patient?.id);\\n  const activeScreening =\\n    screenings.find((s) => s.humanReviewStatus === \'pending_review\') || screenings[0];\\n  const reviews = data.doctorReviews.filter((r) => r.patientId === patient?.id);\\n  const referrals = data.referrals.filter((r) => r.patientId === patient?.id);\\n  const appointments = data.appointments.filter((a) => a.patientId === patient?.id);\\n  const followUps = data.followUps.filter((f) => f.patientId === patient?.id);\\n  const latestLab = data.labs.find((l) => l.patientId === patient?.id);\\n  const latestRisk = data.assessments.find((a) => a.patientId === patient?.id);\\n\\n  const [decision, setDecision] = useState<DoctorReview[\'decision\']>(\'confirmed\');\\n  const [clinicianGrade, setClinicianGrade] = useState(\'Moderate NPDR \342\200\224 Clinician Verified\');\\n  const [triageCategory, setTriageCategory] =\\n    useState<DoctorReview[\'triageCategory\']>(\'Priority (3-6 months)\');\\n  const [clinicalNotes, setClinicalNotes] = useState(\'\');\\n  const [nextSteps, setNextSteps] = useState(\\n    \'Refer for dilated ophthalmologist examination and optimize HbA1c control.\'\\n  );\\n\\n  const [refFacility, setRefFacility] = useState(\'Regional Institute of Ophthalmology, Egmore\');\\n  const [refSpecialty, setRefSpecialty] = useState<ReferralRecord[\'specialty\']>(\'Ophthalmology\');\\n  const [refUrgency, setRefUrgency] = useState<ReferralRecord[\'urgency\']>(\'Priority\');\\n  const [refReason, setRefReason] = useState(\'\');\\n\\n  const [aptTitle, setAptTitle] = useState(\'Follow-up Consultation & Retinal Review\');\\n  const [aptFacility, setAptFacility] = useState(\'Adyar Urban PHC / City Hospital\');\\n  const [aptClinician, setAptClinician] = useState(\'Dr. Arvind Raman\');\\n  const [aptDate, setAptDate] = useState(\'2026-12-04\');\\n  const [aptTime, setAptTime] = useState(\'10:00 AM\');\\n  const [aptType, setAptType] = useState<AppointmentRecord[\'type\']>(\'Follow-up Consultation\');\\n  const [aptReminder, setAptReminder] = useState(\'Bring previous lab reports and medication list.\');\\n\\n  const [fuWorker, setFuWorker] = useState(patient?.assignedHealthWorker || \'Anitha K (VHN)\');\\n  const [fuDue, setFuDue] = useState(\'2026-12-10\');\\n  const [fuChannel, setFuChannel] = useState<FollowUpRecord[\'channel\']>(\'Phone Call\');\\n  const [fuStatus, setFuStatus] = useState<FollowUpRecord[\'status\']>(\'Scheduled\');\\n  const [fuNotes, setFuNotes] = useState(\'\');\\n  const [fuNextScreen, setFuNextScreen] = useState(\'2027-05-20\');\\n\\n  const isDoctor = data.user.role === \'doctor\';\\n  const isStaff = data.user.role === \'doctor\' || data.user.role === \'admin\';\\n\\n  const handleReviewSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!activeScreening) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onSubmitReview({\\n        screeningId: activeScreening.id,\\n        decision,\\n        clinicianGrade,\\n        triageCategory,\\n        clinicalNotes,\\n        recommendedNextSteps: nextSteps,\\n      });\\n      setClinicalNotes(\'\');\\n      setMsg({ type: \'success\', text: \'Clinician review recorded and patient notified.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to submit review.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleCreateReferral = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onCreateReferral({\\n        patientId: patient.id,\\n        screeningId: activeScreening?.id,\\n        targetFacility: refFacility,\\n        specialty: refSpecialty,\\n        urgency: refUrgency,\\n        reason: refReason,\\n      });\\n      setRefReason(\'\');\\n      setMsg({ type: \'success\', text: \'Specialist referral created and logged in continuity record.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to create referral.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleCreateApt = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onCreateAppointment({\\n        patientId: patient.id,\\n        title: aptTitle,\\n        facility: aptFacility,\\n        clinicianName: aptClinician,\\n        scheduledDate: aptDate,\\n        scheduledTime: aptTime,\\n        type: aptType,\\n        reminderNote: aptReminder,\\n      });\\n      setMsg({ type: \'success\', text: \'Appointment scheduled in shared patient care plan.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to book appointment.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleCreateFollowUp = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onCreateFollowUp({\\n        patientId: patient.id,\\n        healthWorkerName: fuWorker,\\n        dueDate: fuDue,\\n        channel: fuChannel,\\n        status: fuStatus,\\n        outcomeNotes: fuNotes,\\n        nextScreeningDate: fuNextScreen || undefined,\\n      });\\n      setFuNotes(\'\');\\n      setMsg({ type: \'success\', text: \'Health-worker continuity follow-up recorded.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to save follow-up.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-indigo-700\\\">\\n            Pillar Three \302\267 Clinician Review, Referrals, Appointments &amp; Continuity of Care\\n          </p>\\n          <h1 className=\\\"font-display text-2xl font-bold text-[#0B2540]\\\">\\n            PROTECT \342\200\224 Doctor-Led Clinical Coordination\\n          </h1>\\n        </div>\\n        {data.patients.length > 1 && (\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label htmlFor=\\\"protect-patient\\\" className=\\\"text-xs font-semibold text-slate-600\\\">\\n              Patient Chart:\\n            </label>\\n            <select\\n              id=\\\"protect-patient\\\"\\n              value={patient?.id || \'\'}\\n              onChange={(e) => onSelectPatient(e.target.value)}\\n              className=\\\"rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800\\\"\\n            >\\n              {data.patients.map((p) => (\\n                <option key={p.id} value={p.id}>\\n                  {p.name} ({p.mrn})\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        )}\\n      </div>\\n\\n      {patient && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs\\\">\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Patient &amp; MRN</div>\\n            <div className=\\\"mt-0.5 font-display text-sm font-bold text-[#0B2540]\\\">{patient.name}</div>\\n            <div className=\\\"font-mono text-[11px] text-slate-500\\\">\\n              {patient.mrn} \302\267 {patient.age}y {patient.sex} \302\267 {patient.district}\\n            </div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Prevent Risk Score</div>\\n            <div className=\\\"mt-0.5 font-mono text-sm font-bold text-slate-900 tabular-nums\\\">\\n              {latestRisk ? `${latestRisk.experimentalScore}/100 (${latestRisk.riskCategory})` : \'Not assessed\'}\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Experimental lifestyle screen</div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Latest Clinical Lab</div>\\n            <div className=\\\"mt-0.5 font-mono text-sm font-bold text-slate-900 tabular-nums\\\">\\n              {latestLab\\n                ? `HbA1c ${latestLab.hba1cPercent ?? \'\342\200\224\'}% \302\267 FPG ${latestLab.fastingGlucoseMgDl ?? \'\342\200\224\'}`\\n                : \'No lab recorded\'}\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">\\n              {patient.diabetesStatus === \'diagnosed_t2d\' ? \'Diagnosed T2D\' : patient.diabetesStatus}\\n            </div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Care Team Ownership</div>\\n            <div className=\\\"mt-0.5 text-sm font-bold text-[#0F766E]\\\">\\n              {patient.assignedHealthWorker}\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Dr. Arvind Raman (MO)</div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {!isOnline && (\\n        <div className=\\\"rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-950 flex items-center gap-2\\\">\\n          <AlertTriangle className=\\\"h-4 w-4 text-amber-700 shrink-0\\\" />\\n          <span>\\n            <strong>Online-Only Clinical Governance:</strong> Remote doctor review sign-off, specialist referral updates, and external hospital appointment confirmations require live connectivity and are paused while offline.\\n          </span>\\n        </div>\\n      )}\\n\\n      <div className=\\\"flex flex-wrap gap-1.5 rounded-xl bg-slate-200/70 p-1\\\">\\n        {[\\n          { id: \'review\', label: \'Doctor Clinical Review\', icon: Stethoscope },\\n          { id: \'referrals\', label: `Referrals (${referrals.length})`, icon: Send },\\n          { id: \'appointments\', label: `Appointments (${appointments.length})`, icon: Calendar },\\n          { id: \'continuity\', label: `Continuity & Follow-ups (${followUps.length})`, icon: UserCheck },\\n        ].map((tab) => {\\n          const Icon = tab.icon;\\n          const active = subTab === tab.id;\\n          return (\\n            <button\\n              key={tab.id}\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSubTab(tab.id as typeof subTab);\\n                setMsg(null);\\n              }}\\n              className={`inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-xs font-semibold transition-colors whitespace-nowrap ${\\n                active ? \'bg-white text-[#0B2540] shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              <Icon className=\\\"h-3.5 w-3.5 text-indigo-700\\\" />\\n              {tab.label}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {msg && (\\n        <div\\n          className={`rounded-xl border px-4 py-3 text-xs font-medium ${\\n            msg.type === \'success\'\\n              ? \'border-emerald-200 bg-emerald-50 text-emerald-900\'\\n              : \'border-rose-200 bg-rose-50 text-rose-900\'\\n          }`}\\n        >\\n          {msg.text}\\n        </div>\\n      )}\\n\\n      {subTab === \'review\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5 items-start\\\">\\n          <div className=\\\"lg:col-span-6 rounded-2xl border border-slate-200 bg-white p-5 space-y-4\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Retinal Screening &amp; Grad-CAM Inspection\\n            </h2>\\n            {activeScreening ? (\\n              <>\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <FundusVisualizer\\n                    preset={activeScreening.imagePreset}\\n                    imageDataUrl={activeScreening.imageDataUrl}\\n                    stage=\\\"raw\\\"\\n                    size={240}\\n                    className=\\\"aspect-square w-full\\\"\\n                    label={`Original (${activeScreening.eye})`}\\n                  />\\n                  <FundusVisualizer\\n                    preset={activeScreening.imagePreset}\\n                    imageDataUrl={activeScreening.imageDataUrl}\\n                    stage=\\\"gradcam\\\"\\n                    hotspots={activeScreening.gradCam.hotspots}\\n                    size={240}\\n                    className=\\\"aspect-square w-full\\\"\\n                    label=\\\"Grad-CAM Assist\\\"\\n                  />\\n                </div>\\n                <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-xs space-y-1\\\">\\n                  <div className=\\\"font-bold text-slate-900\\\">\\n                    AI Screening Assist: {activeScreening.modelPrediction.gradeLabel}\\n                  </div>\\n                  <div className=\\\"font-mono text-[11px] text-slate-600 tabular-nums\\\">\\n                    Quality: {activeScreening.quality.gradable ? \'Gradable\' : \'Ungradable\'} \302\267\\n                    Sharpness: {activeScreening.quality.sharpnessScore}/100 \302\267\\n                    Status: {activeScreening.humanReviewStatus}\\n                  </div>\\n                  <p className=\\\"text-slate-600\\\">{activeScreening.summaryText}</p>\\n                </div>\\n              </>\\n            ) : (\\n              <p className=\\\"text-xs text-slate-500\\\">No retinal screening available for this patient yet.</p>\\n            )}\\n\\n            <div className=\\\"pt-2 border-t border-slate-100 space-y-2\\\">\\n              <div className=\\\"text-xs font-bold text-[#0B2540]\\\">Clinician Review History</div>\\n              {reviews.length === 0 ? (\\n                <p className=\\\"text-xs text-slate-500\\\">Awaiting first doctor clinical review.</p>\\n              ) : (\\n                reviews.map((rev) => (\\n                  <div\\n                    key={rev.id}\\n                    className=\\\"rounded-xl border border-emerald-200 bg-emerald-50/40 p-3 text-xs space-y-1\\\"\\n                  >\\n                    <div className=\\\"flex items-center justify-between\\\">\\n                      <span className=\\\"font-bold text-slate-900\\\">{rev.clinicianGrade}</span>\\n                      <span className=\\\"font-semibold text-[#0F766E]\\\">{rev.triageCategory}</span>\\n                    </div>\\n                    <p className=\\\"text-slate-700\\\">{rev.clinicalNotes}</p>\\n                    <div className=\\\"text-[11px] text-slate-500\\\">\\n                      Signed by {rev.doctorName} \302\267 {new Date(rev.reviewedAt).toLocaleString()}\\n                    </div>\\n                  </div>\\n                ))\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-6 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Clinician Confirmation &amp; Triage Protocol\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-slate-500\\\">\\n              Triage follows clinician-approved ophthalmology protocols \342\200\224 never solely AI confidence or lifestyle score.\\n            </p>\\n\\n            {!isDoctor ? (\\n              <div className=\\\"mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-950\\\">\\n                <strong>RBAC Protection Active:</strong> Clinical confirmation and triage sign-off are restricted to authenticated <strong>Doctor</strong> accounts. Switch to <em>Dr. Arvind Raman</em> via the top-right account menu to submit a review.\\n              </div>\\n            ) : !activeScreening ? (\\n              <p className=\\\"mt-4 text-xs text-slate-500\\\">Capture or upload a retinal screening in Detect first.</p>\\n            ) : (\\n              <form onSubmit={handleReviewSubmit} className=\\\"mt-4 space-y-3.5\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinical Decision on AI-Assisted Finding\\n                  </label>\\n                  <select\\n                    value={decision}\\n                    onChange={(e) => setDecision(e.target.value as DoctorReview[\'decision\'])}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"confirmed\\\">Confirm AI-Assisted Finding</option>\\n                    <option value=\\\"rejected_modified\\\">Reject / Override with Clinician Assessment</option>\\n                    <option value=\\\"recapture_requested\\\">Reject Image \342\200\224 Request Fundus Recapture</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinician Grade / Finding\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={clinicianGrade}\\n                    onChange={(e) => setClinicianGrade(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinician-Approved Triage Category\\n                  </label>\\n                  <select\\n                    value={triageCategory}\\n                    onChange={(e) => setTriageCategory(e.target.value as DoctorReview[\'triageCategory\'])}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"Routine (12 months)\\\">Routine (12 months)</option>\\n                    <option value=\\\"Priority (3-6 months)\\\">Priority (3\342\200\2236 months)</option>\\n                    <option value=\\\"Urgent Ophthalmology (< 2 weeks)\\\">Urgent Ophthalmology (&lt; 2 weeks)</option>\\n                    <option value=\\\"Immediate Recapture\\\">Immediate Recapture</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">Clinical Notes</label>\\n                  <textarea\\n                    required\\n                    rows={3}\\n                    value={clinicalNotes}\\n                    onChange={(e) => setClinicalNotes(e.target.value)}\\n                    placeholder=\\\"Document optic disc, macula, exudates, haemorrhages, and glycaemic context...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Recommended Next Steps\\n                  </label>\\n                  <textarea\\n                    required\\n                    rows={2}\\n                    value={nextSteps}\\n                    onChange={(e) => setNextSteps(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy || !isOnline}\\n                  className=\\\"inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#0B2540] py-2.5 text-xs font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  <ClipboardCheck className=\\\"h-4 w-4\\\" />\\n                  {busy ? \'Signing Review...\' : \'Sign & Save Clinical Review\'}\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'referrals\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Referral Records ({patient?.name})\\n            </h2>\\n            {referrals.length === 0 ? (\\n              <p className=\\\"text-xs text-slate-500\\\">No specialist referrals issued for this patient.</p>\\n            ) : (\\n              referrals.map((ref) => (\\n                <div key={ref.id} className=\\\"rounded-xl border border-slate-200 p-4 text-xs space-y-2\\\">\\n                  <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                    <span className=\\\"font-bold text-slate-900\\\">\\n                      {ref.urgency} \302\267 {ref.specialty} \342\206\222 {ref.targetFacility}\\n                    </span>\\n                    <span className=\\\"font-mono font-semibold text-[#0F766E]\\\">{ref.status}</span>\\n                  </div>\\n                  <p className=\\\"text-slate-600\\\">{ref.reason}</p>\\n                  {ref.specialistFindings && (\\n                    <div className=\\\"rounded-lg bg-emerald-50 border border-emerald-200 p-2.5 text-emerald-950\\\">\\n                      <strong>Specialist Feedback:</strong> {ref.specialistFindings}\\n                    </div>\\n                  )}\\n                  {isStaff && isOnline && ref.status !== \'Completed\' && (\\n                    <div className=\\\"flex flex-wrap gap-2 pt-1\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateReferral(ref.id, \'Accepted\')}\\n                        className=\\\"rounded-lg border border-slate-200 px-3 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50\\\"\\n                      >\\n                        Mark Accepted\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          void onUpdateReferral(\\n                            ref.id,\\n                            \'Completed\',\\n                            \'Dilated fundus examination & OCT completed; follow-up plan updated in PHC chart.\'\\n                          )\\n                        }\\n                        className=\\\"rounded-lg bg-[#0D9488] px-3 py-1 text-[11px] font-semibold text-white hover:bg-[#0F766E]\\\"\\n                      >\\n                        Record Specialist Findings &amp; Complete\\n                      </button>\\n                    </div>\\n                  )}\\n                </div>\\n              ))\\n            )}\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">Issue New Referral</h3>\\n            {!isStaff ? (\\n              <p className=\\\"mt-2 text-xs text-slate-500\\\">\\n                Referrals are generated by authorised Doctors or Health Administrators.\\n              </p>\\n            ) : (\\n              <form onSubmit={handleCreateReferral} className=\\\"mt-4 space-y-3 text-xs\\\">\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Target Healthcare Facility</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={refFacility}\\n                    onChange={(e) => setRefFacility(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Specialty</label>\\n                    <select\\n                      value={refSpecialty}\\n                      onChange={(e) => setRefSpecialty(e.target.value as ReferralRecord[\'specialty\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Ophthalmology\\\">Ophthalmology</option>\\n                      <option value=\\\"Diabetology\\\">Diabetology</option>\\n                      <option value=\\\"Primary Health Centre\\\">Primary Health Centre</option>\\n                    </select>\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Urgency</label>\\n                    <select\\n                      value={refUrgency}\\n                      onChange={(e) => setRefUrgency(e.target.value as ReferralRecord[\'urgency\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Routine\\\">Routine</option>\\n                      <option value=\\\"Priority\\\">Priority</option>\\n                      <option value=\\\"Urgent\\\">Urgent</option>\\n                    </select>\\n                  </div>\\n                </div>\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Clinical Referral Reason</label>\\n                  <textarea\\n                    required\\n                    rows={3}\\n                    value={refReason}\\n                    onChange={(e) => setRefReason(e.target.value)}\\n                    placeholder=\\\"Specify clinical findings, HbA1c, and requested specialist evaluation...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy || !isOnline}\\n                  className=\\\"w-full rounded-xl bg-[#0B2540] py-2.5 font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  Generate Referral Record\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {subTab === \'appointments\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Scheduled Appointments ({patient?.name})\\n            </h2>\\n            {appointments.map((apt) => (\\n              <div key={apt.id} className=\\\"rounded-xl border border-slate-200 p-4 text-xs space-y-2\\\">\\n                <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                  <span className=\\\"font-bold text-slate-900\\\">{apt.title}</span>\\n                  <span\\n                    className={`font-semibold ${\\n                      apt.status === \'Confirmed\' || apt.status === \'Attended\'\\n                        ? \'text-emerald-700\'\\n                        : apt.status === \'Missed\'\\n                        ? \'text-rose-700\'\\n                        : \'text-amber-700\'\\n                    }`}\\n                  >\\n                    {apt.status}\\n                  </span>\\n                </div>\\n                <div className=\\\"text-slate-600 font-mono text-[11px] tabular-nums\\\">\\n                  {apt.scheduledDate} at {apt.scheduledTime} \302\267 {apt.facility} \302\267 {apt.clinicianName}\\n                </div>\\n                <div className=\\\"flex flex-wrap gap-2 pt-1\\\">\\n                  {isStaff && isOnline && (\\n                    <>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateAppointment(apt.id, \'Confirmed\')}\\n                        className=\\\"rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-800\\\"\\n                      >\\n                        Confirm\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateAppointment(apt.id, \'Attended\')}\\n                        className=\\\"rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-800\\\"\\n                      >\\n                        Mark Attended\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateAppointment(apt.id, \'Missed\', true)}\\n                        className=\\\"rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-semibold text-rose-800\\\"\\n                      >\\n                        Mark Missed &amp; Escalate\\n                      </button>\\n                    </>\\n                  )}\\n                  {isOnline && apt.status !== \'Cancelled\' && apt.status !== \'Attended\' && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => void onUpdateAppointment(apt.id, \'Cancelled\')}\\n                      className=\\\"rounded-lg border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50\\\"\\n                    >\\n                      Cancel\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n\\n          <form\\n            onSubmit={handleCreateApt}\\n            className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5 space-y-3 text-xs\\\"\\n          >\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">Schedule Appointment</h3>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Visit Title</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={aptTitle}\\n                onChange={(e) => setAptTitle(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n              />\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n              <div>\\n                <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Date</label>\\n                <input\\n                  type=\\\"date\\\"\\n                  required\\n                  value={aptDate}\\n                  onChange={(e) => setAptDate(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Time</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={aptTime}\\n                  onChange={(e) => setAptTime(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Appointment Type</label>\\n              <select\\n                value={aptType}\\n                onChange={(e) => setAptType(e.target.value as AppointmentRecord[\'type\'])}\\n                className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n              >\\n                <option value=\\\"Follow-up Consultation\\\">Follow-up Consultation</option>\\n                <option value=\\\"Retinal Screening\\\">Retinal Screening</option>\\n                <option value=\\\"Ophthalmology Referral\\\">Ophthalmology Referral</option>\\n                <option value=\\\"Lab Testing (HbA1c/FPG)\\\">Lab Testing (HbA1c/FPG)</option>\\n              </select>\\n            </div>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Facility</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={aptFacility}\\n                onChange={(e) => setAptFacility(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Reminder Note</label>\\n              <input\\n                type=\\\"text\\\"\\n                value={aptReminder}\\n                onChange={(e) => setAptReminder(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n              />\\n            </div>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={busy || !isOnline}\\n              className=\\\"w-full rounded-xl bg-[#0D9488] py-2.5 font-semibold text-white hover:bg-[#0F766E] disabled:opacity-50\\\"\\n            >\\n              Book Appointment\\n            </button>\\n          </form>\\n        </div>\\n      )}\\n\\n      {subTab === \'continuity\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Continuity of Care &amp; Follow-up Timeline\\n            </h2>\\n            {followUps.length === 0 ? (\\n              <p className=\\\"text-xs text-slate-500\\\">No health-worker follow-up records yet.</p>\\n            ) : (\\n              followUps.map((fu) => (\\n                <div key={fu.id} className=\\\"rounded-xl border border-slate-200 p-4 text-xs space-y-1\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"font-bold text-slate-900\\\">\\n                      {fu.healthWorkerName} \302\267 {fu.channel}\\n                    </span>\\n                    <span\\n                      className={`font-semibold ${\\n                        fu.status === \'Escalated\' ? \'text-rose-700\' : \'text-[#0F766E]\'\\n                      }`}\\n                    >\\n                      {fu.status}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"font-mono text-[11px] text-slate-500 tabular-nums\\\">\\n                    Due: {fu.dueDate}{\' \'}\\n                    {fu.nextScreeningDate ? `\302\267 Next Retinal Screening: ${fu.nextScreeningDate}` : \'\'}\\n                  </div>\\n                  <p className=\\\"text-slate-700\\\">{fu.outcomeNotes}</p>\\n                </div>\\n              ))\\n            )}\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Assign Health-Worker Follow-Up\\n            </h3>\\n            {!isStaff ? (\\n              <p className=\\\"mt-2 text-xs text-slate-500\\\">\\n                Follow-up tasks are assigned by Doctors and Health Programme Administrators.\\n              </p>\\n            ) : (\\n              <form onSubmit={handleCreateFollowUp} className=\\\"mt-4 space-y-3 text-xs\\\">\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Health Worker Owner</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={fuWorker}\\n                    onChange={(e) => setFuWorker(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Due Date</label>\\n                    <input\\n                      type=\\\"date\\\"\\n                      required\\n                      value={fuDue}\\n                      onChange={(e) => setFuDue(e.target.value)}\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Channel</label>\\n                    <select\\n                      value={fuChannel}\\n                      onChange={(e) => setFuChannel(e.target.value as FollowUpRecord[\'channel\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Phone Call\\\">Phone Call</option>\\n                      <option value=\\\"In-Person PHC\\\">In-Person PHC</option>\\n                      <option value=\\\"Home Visit\\\">Home Visit</option>\\n                    </select>\\n                  </div>\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Status</label>\\n                    <select\\n                      value={fuStatus}\\n                      onChange={(e) => setFuStatus(e.target.value as FollowUpRecord[\'status\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Scheduled\\\">Scheduled</option>\\n                      <option value=\\\"Completed\\\">Completed</option>\\n                      <option value=\\\"Escalated\\\">Escalated</option>\\n                    </select>\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Next Retinal Screening</label>\\n                    <input\\n                      type=\\\"date\\\"\\n                      value={fuNextScreen}\\n                      onChange={(e) => setFuNextScreen(e.target.value)}\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                    />\\n                  </div>\\n                </div>\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Follow-Up Notes</label>\\n                  <textarea\\n                    required\\n                    rows={3}\\n                    value={fuNotes}\\n                    onChange={(e) => setFuNotes(e.target.value)}\\n                    placeholder=\\\"Record outreach instructions, missed-visit escalation, or specialist feedback...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy || !isOnline}\\n                  className=\\\"inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#0B2540] py-2.5 font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  <CheckCircle2 className=\\\"h-4 w-4\\\" />\\n                  Save Continuity Follow-Up\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ProtectModule with doctor retinal review, triage protocols, referral management, appointments, and continuity-of-care follow-ups\", \"Overwrite\":true, \"TargetFile\":\"/src/views/ProtectModule.tsx\", \"toolAction\":\"Creating ProtectModule view\", \"toolSummary\":\"Create src/views/ProtectModule.tsx\"}"
      original_name: "write_to_file"
