      thinking_signature: "\022\261\034\n\256\034\001i\024}\023\216@+\224\325C\266\004h+\361\272\226f\355f\353\263\221\026\313F\216&s\270\3443\364\201\374r\213\210\'\371V\324\024t\253C\341\001J\036\373k\001\340.\b\354\274\034\265\037\222\312\346\332 \350M\243\204\337\203\335\217\222\301\377L\\\216p\204\261[_3\315\246\362%\210\247ITw\336\214\337\272\375F\227\221M}\320_~pdp\205\241\242\224f\a)\2709\f_}\244F\255\200\020\032\251~P\234\034\272\355\347N\224A\006\375\234rOo\253\252\366\031\227\016\246H\362\357\2526\236{v@\264\374\353\f\3175\362R?\366\344?1\245\305\352*\f\364#u\fm\222\237(C\225\"\v\003\350o\027\301h\313\036\303\243\210J\337\263}?\324\311\2416]\315\367c\356\267\r\217\030\006\213\'\025\244J\321\207\266\264\020\237\347jPc\272\343\000\371{\377\307\320%\036\006\025\346\362=\227\220\351\336\0241=z\027\227v}\320\a\312\276\245\337\247\315\354\355\315\323\'>{\250xmI\001\333\273\250\367\020\271[ \343\222\263\204\334\f\311\251\351t\342\355\247\237\374c\206\250\2143\002+\365G\333\t\356X\311\212\2277\243v\206\227y:\330x\316\346\226\004\a\364\251\301*jv`\301y5\225\203mY&\263\310Q\261D\244\'\233`\347\327H\351\f\2730\306\\x\212\262\371ec\340\f\037\225\252\0207]\264\256F\255\330\005\t\274i\023wd\366`&\255\227U@\367\203\341>5\204\330\t\350\337?/\264\fO\217\242W\t\352\266%\000\026\'\a\nA,R\nZn\246\177\006\2503\212\264\235\016;\261\3669\321\353{\206\302\267\231\006\375]?s\aKG\303\016\027\240h\334\027\'\256x\307\017c\360>z1\377\275fn\252\365\312nTq\216\262kJ\267\243\300\246\333\030\212\266\030\237\367\354\322\323,kn\'\000\246\3279\330\026\022AL\342~\r\274\373\\v\005\226\260\313V\2319#\257\370\017\035)\343\017\376\v\325\215\271\b\016\000p9bX\025\312\200$\254\373\026)\352\222p1w\373>\307\001\r\b\017\212\"\315\320\370\r\354|*`\300\362\265\232\316\370FG\355T\375\311\276fB\272.\260\224|\fy\356t\377\341$@\363\316\223\024\222x\215\3174\031M{\004\'\276Y\250\202\362\216#\245\001Nu\223\250 _\2456\273\n\226\017\305l*\177\004~\362\230)g\355%y\332%\270n\216x7\301\206\233fJM9\261\304\205\276