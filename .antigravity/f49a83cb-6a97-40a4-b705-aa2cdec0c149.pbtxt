  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useMemo, useState } from \'react\';\nimport {\n  Activity,\n  AlertCircle,\n  ArrowRight,\n  Calendar,\n  CheckCircle2,\n  ChevronRight,\n  ClipboardList,\n  Eye,\n  FileText,\n  Lightbulb,\n  RefreshCw,\n  ShieldCheck,\n  Wifi,\n  WifiOff,\n} from \'lucide-react\';\nimport {\n  CartesianGrid,\n  Legend,\n  Line,\n  LineChart,\n  ResponsiveContainer,\n  Tooltip,\n  XAxis,\n  YAxis,\n} from \'recharts\';\nimport type { AppNavView, BootstrapPayload } from \'../types/domain\';\nimport type { TranslationBundle } from \'../i18n/translations\';\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\n\ninterface PatientDashboardProps {\n  data: BootstrapPayload;\n  t: TranslationBundle;\n  isOnline: boolean;\n  pendingSyncCount: number;\n  onNavigate: (view: AppNavView) => void;\n  onSyncNow: () => void;\n}\n\nexport const PatientDashboard: React.FC<PatientDashboardProps> = ({\n  data,\n  t,\n  isOnline,\n  pendingSyncCount,\n  onNavigate,\n  onSyncNow,\n}) => {\n  const [range, setRange] = useState<\'6m\' | \'3m\'>(\'6m\');\n  const [showGradCamPreview, setShowGradCamPreview] = useState(false);\n\n  const patient = data.patients[0];\n  const latestAssessment = data.assessments[0];\n  const latestScreening = data.screenings[0];\n  const latestReview = data.doctorReviews.find((r) => r.screeningId === latestScreening?.id);\n  const programme = data.programmes[0];\n  const upcomingApt =\n    data.appointments.find((a) => a.status === \'Confirmed\' || a.status === \'Pending Confirmation\') ||\n    data.appointments[0];\n\n  const healthSeries = useMemo(() => {\n    const baseScore = latestAssessment?.experimentalScore ?? 26;\n    const all = [\n      { month: \'Jun\', riskScore: Math.min(95, baseScore + 14), activity: 46, sleep: 62 },\n      { month: \'Jul\', riskScore: Math.min(95, baseScore + 10), activity: 58, sleep: 68 },\n      { month: \'Aug\', riskScore: Math.min(95, baseScore + 7), activity: 66, sleep: 64 },\n      { month: \'Sep\', riskScore: Math.min(95, baseScore + 4), activity: 71, sleep: 74 },\n      { month: \'Oct\', riskScore: Math.min(95, baseScore + 2), activity: 78, sleep: 79 },\n      { month: \'Nov\', riskScore: baseScore, activity: 84, sleep: 82 },\n    ];\n    return range === \'3m\' ? all.slice(3) : all;\n  }, [latestAssessment, range]);\n\n  const adherence = programme?.adherencePercent ?? 72;\n  const ringCircumference = 2 * Math.PI * 44;\n  const ringOffset = ringCircumference - (adherence / 100) * ringCircumference;\n\n  const firstName = (patient?.name || data.user.name).split(\' \')[0];\n\n  return (\n    <div className=\"space-y-5\">\n      {/* Main 12-Column Grid with Right Operational Rail on Desktop */}\n      <div className=\"grid grid-cols-1 xl:grid-cols-12 gap-5 items-start\">\n        {/* Left/Main 9 Columns */}\n        <div className=\"xl:col-span-9 space-y-5\">\n          {/* Hero Welcome Banner */}\n          <section className=\"relative overflow-hidden rounded-2xl border border-[#124E78]/20 bg-gradient-to-r from-[#EBF4FA] via-[#E3F2F8] to-[#0B3558] p-6 sm:p-7\">\n            <div className=\"relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6\">\n              <div className=\"max-w-xl\">\n                <p className=\"text-xs font-semibold text-[#0F766E] tracking-wide\">\n                  {patient ? `${patient.mrn} \302\267 ${patient.district}` : \'Personal Care Workspace\'} \302\267 Synthetic Prototype Record\n                </p>\n                <h1 className=\"mt-1.5 font-display text-2xl sm:text-3xl font-bold tracking-tight text-[#0B2540] [text-wrap:balance]\">\n                  {t.hero.welcomeBack}, {firstName}!\n                </h1>\n                <p className=\"mt-1 text-base font-medium text-[#164263]\">\n                  {t.hero.subtitle}\n                </p>\n                <p className=\"mt-1.5 text-sm text-slate-600 leading-relaxed\">\n                  {t.hero.tagline}\n                </p>\n                <div className=\"mt-4 flex flex-wrap items-center gap-3\">\n                  <button\n                    type=\"button\"\n                    onClick={() => onNavigate(\'prevent\')}\n                    className=\"inline-flex items-center gap-2 rounded-xl bg-[#0D9488] px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#0F766E] transition-colors whitespace-nowrap\"\n                  >\n                    {t.hero.exploreCta}\n                    <ArrowRight className=\"h-4 w-4\" />\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => onNavigate(\'detect\')}\n                    className=\"inline-flex items-center gap-2 rounded-xl border border-[#0B2540]/20 bg-white/85 px-4 py-2.5 text-sm font-semibold text-[#0B2540] hover:bg-white transition-colors whitespace-nowrap\"\n                  >\n                    Retinal Screening Status\n                  </button>\n                </div>\n              </div>\n\n              {/* Clean Clinical Shield & Eye Motif */}\n              <div className=\"hidden lg:flex items-center gap-4 rounded-2xl bg-[#071D33]/85 px-5 py-4 text-white border border-teal-400/25 max-w-xs\">\n                <div className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-500/20 text-teal-300\">\n                  <ShieldCheck className=\"h-7 w-7\" />\n                </div>\n                <div>\n                  <div className=\"font-display text-sm font-bold text-white\">\n                    Smart Care. Better Health.\n                  </div>\n                  <p className=\"mt-1 text-xs text-slate-300 leading-relaxed\">\n                    Screening support only \342\200\224 all clinical decisions remain with your physician.\n                  </p>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          {/* Three Pillars Launch Strip */}\n          <section className=\"grid grid-cols-1 md:grid-cols-3 gap-4\" aria-label=\"Three Healthcare Pillars\">\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'prevent\')}\n              className=\"group flex items-center justify-between rounded-2xl border border-emerald-200/80 bg-gradient-to-br from-emerald-50/90 to-white p-4 text-left hover:border-emerald-300 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3.5 min-w-0\">\n                <div className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white\">\n                  <Activity className=\"h-6 w-6\" />\n                </div>\n                <div className=\"min-w-0\">\n                  <div className=\"font-display text-sm font-bold text-[#0B2540]\">\n                    {t.pillars.preventTitle}\n                  </div>\n                  <div className=\"text-xs text-slate-600 truncate\">{t.pillars.preventDesc}</div>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-semibold text-emerald-700 tabular-nums\">\n                    <span>{latestAssessment?.riskCategory ?? \'Low\'} Risk</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <span>Score {latestAssessment?.experimentalScore ?? 24}/100</span>\n                  </div>\n                </div>\n              </div>\n              <ChevronRight className=\"h-5 w-5 shrink-0 text-slate-400 group-hover:translate-x-0.5 group-hover:text-emerald-700 transition-transform\" />\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'detect\')}\n              className=\"group flex items-center justify-between rounded-2xl border border-sky-200/80 bg-gradient-to-br from-sky-50/90 to-white p-4 text-left hover:border-sky-300 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3.5 min-w-0\">\n                <div className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#12598C] text-white\">\n                  <Eye className=\"h-6 w-6\" />\n                </div>\n                <div className=\"min-w-0\">\n                  <div className=\"font-display text-sm font-bold text-[#0B2540]\">\n                    {t.pillars.detectTitle}\n                  </div>\n                  <div className=\"text-xs text-slate-600 truncate\">{t.pillars.detectDesc}</div>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-semibold text-sky-800\">\n                    <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-600 shrink-0\" />\n                    <span className=\"truncate\">\n                      {latestScreening\n                        ? latestScreening.modelPrediction.gradeWithheld\n                          ? \'Review Required\'\n                          : latestScreening.modelPrediction.icdrGrade === 0\n                          ? \'No Apparent DR (Assist)\'\n                          : `ICDR Grade ${latestScreening.modelPrediction.icdrGrade}`\n                        : \'No Screening Yet\'}\n                    </span>\n                  </div>\n                </div>\n              </div>\n              <ChevronRight className=\"h-5 w-5 shrink-0 text-slate-400 group-hover:translate-x-0.5 group-hover:text-sky-700 transition-transform\" />\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'protect\')}\n              className=\"group flex items-center justify-between rounded-2xl border border-indigo-200/70 bg-gradient-to-br from-indigo-50/70 to-white p-4 text-left hover:border-indigo-300 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3.5 min-w-0\">\n                <div className=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#4F46A5] text-white\">\n                  <ShieldCheck className=\"h-6 w-6\" />\n                </div>\n                <div className=\"min-w-0\">\n                  <div className=\"font-display text-sm font-bold text-[#0B2540]\">\n                    {t.pillars.protectTitle}\n                  </div>\n                  <div className=\"text-xs text-slate-600 truncate\">{t.pillars.protectDesc}</div>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-semibold text-indigo-800\">\n                    <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-600 shrink-0\" />\n                    <span className=\"truncate\">\n                      {latestReview ? latestReview.triageCategory : \'Care Plan Active\'}\n                    </span>\n                  </div>\n                </div>\n              </div>\n              <ChevronRight className=\"h-5 w-5 shrink-0 text-slate-400 group-hover:translate-x-0.5 group-hover:text-indigo-700 transition-transform\" />\n            </button>\n          </section>\n\n          {/* Middle Analytics Row */}\n          <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n            {/* Health Overview Trend Chart */}\n            <div className=\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\">\n              <div className=\"flex items-center justify-between gap-2 mb-4\">\n                <div>\n                  <h2 className=\"font-display text-base font-bold text-[#0B2540]\">\n                    Health Overview\n                  </h2>\n                  <p className=\"text-xs text-slate-500\">\n                    Experimental lifestyle score, activity &amp; sleep index\n                  </p>\n                </div>\n                <div className=\"flex items-center rounded-lg bg-slate-100 p-0.5 text-xs\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setRange(\'6m\')}\n                    className={`rounded-md px-2.5 py-1 font-medium transition-colors ${\n                      range === \'6m\' ? \'bg-white text-slate-900 shadow-xs\' : \'text-slate-600\'\n                    }`}\n                  >\n                    6M\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setRange(\'3m\')}\n                    className={`rounded-md px-2.5 py-1 font-medium transition-colors ${\n                      range === \'3m\' ? \'bg-white text-slate-900 shadow-xs\' : \'text-slate-600\'\n                    }`}\n                  >\n                    3M\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"h-56 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <LineChart data={healthSeries} margin={{ top: 8, right: 8, left: -22, bottom: 0 }}>\n                    <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#E2E8F0\" />\n                    <XAxis dataKey=\"month\" tick={{ fontSize: 11, fill: \'#64748B\' }} />\n                    <YAxis domain={[0, 100]} tick={{ fontSize: 11, fill: \'#64748B\' }} />\n                    <Tooltip\n                      contentStyle={{\n                        borderRadius: \'10px\',\n                        borderColor: \'#E2E8F0\',\n                        fontSize: \'12px\',\n                      }}\n                    />\n                    <Legend iconType=\"circle\" wrapperStyle={{ fontSize: \'11px\' }} />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"riskScore\"\n                      name=\"Risk Score (Lower Better)\"\n                      stroke=\"#1D4ED8\"\n                      strokeWidth={2.2}\n                      dot={{ r: 3 }}\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"activity\"\n                      name=\"Activity Index\"\n                      stroke=\"#0D9488\"\n                      strokeWidth={2.2}\n                      dot={{ r: 3 }}\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"sleep\"\n                      name=\"Sleep Consistency\"\n                      stroke=\"#7C3AED\"\n                      strokeWidth={2.2}\n                      dot={{ r: 3 }}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </div>\n            </div>\n\n            {/* Retinal Screening Result Card */}\n            <div className=\"lg:col-span-4 rounded-2xl border border-slate-200 bg-white p-5 flex flex-col justify-between\">\n              <div className=\"flex items-center justify-between gap-2 mb-3\">\n                <h2 className=\"font-display text-base font-bold text-[#0B2540]\">\n                  Retinal Screening Result\n                </h2>\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'reports\')}\n                  className=\"text-xs font-semibold text-[#0D9488] hover:underline whitespace-nowrap\"\n                >\n                  View Report \342\206\222\n                </button>\n              </div>\n\n              {latestScreening ? (\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5 items-center flex-1\">\n                  <FundusVisualizer\n                    preset={latestScreening.imagePreset}\n                    imageDataUrl={latestScreening.imageDataUrl}\n                    stage={showGradCamPreview ? \'gradcam\' : \'raw\'}\n                    hotspots={latestScreening.gradCam.hotspots}\n                    size={220}\n                    className=\"aspect-square w-full\"\n                    label={showGradCamPreview ? \'Grad-CAM Overlay\' : latestScreening.eye}\n                  />\n\n                  <div className=\"space-y-2.5\">\n                    <div className=\"flex items-center gap-2\">\n                      <CheckCircle2\n                        className={`h-5 w-5 shrink-0 ${\n                          latestScreening.modelPrediction.icdrGrade === 0\n                            ? \'text-emerald-600\'\n                            : \'text-amber-600\'\n                        }`}\n                      />\n                      <span className=\"font-display text-sm font-bold text-slate-900 leading-tight\">\n                        {latestScreening.modelPrediction.icdrGrade === 0\n                          ? \'No Apparent DR\'\n                          : latestScreening.modelPrediction.gradeWithheld\n                          ? \'Grade Withheld\'\n                          : `ICDR Grade ${latestScreening.modelPrediction.icdrGrade}`}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-600 leading-relaxed\">\n                      {latestScreening.humanReviewStatus === \'confirmed\'\n                        ? `Confirmed by ${latestReview?.doctorName || \'Clinician\'}`\n                        : \'Illustrative AI assist \342\200\224 pending clinician review\'}\n                    </p>\n                    <p className=\"text-[11px] font-mono text-slate-500 tabular-nums\">\n                      Quality: {latestScreening.quality.sharpnessScore}/100 \302\267{\' \'}\n                      {new Date(latestScreening.capturedAt).toLocaleDateString()}\n                    </p>\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowGradCamPreview((v) => !v)}\n                      className=\"w-full rounded-lg border border-sky-200 bg-sky-50 px-3 py-1.5 text-xs font-semibold text-sky-900 hover:bg-sky-100 transition-colors\"\n                    >\n                      {showGradCamPreview ? \'Show Original Fundus\' : \'View Grad-CAM\'}\n                    </button>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"flex flex-1 flex-col items-center justify-center py-6 text-center\">\n                  <p className=\"text-xs text-slate-500\">No retinal screening recorded yet.</p>\n                  <button\n                    type=\"button\"\n                    onClick={() => onNavigate(\'detect\')}\n                    className=\"mt-3 rounded-lg bg-[#0B2540] px-4 py-2 text-xs font-semibold text-white\"\n                  >\n                    Start Screening\n                  </button>\n                </div>\n              )}\n            </div>\n\n            {/* Prevention Programme Progress Card */}\n            <div className=\"lg:col-span-3 rounded-2xl border border-slate-200 bg-white p-5 flex flex-col justify-between\">\n              <div>\n                <h2 className=\"font-display text-base font-bold text-[#0B2540]\">\n                  Prevention Programme\n                </h2>\n                <p className=\"text-xs text-slate-500 mt-0.5\">\n                  {programme?.phase || \'PHASE 1: LEARNING (Months 1-6)\'}\n                </p>\n              </div>\n\n              <div className=\"my-4 flex items-center gap-4\">\n                <div className=\"relative h-24 w-24 shrink-0\">\n                  <svg className=\"h-24 w-24 -rotate-90\" viewBox=\"0 0 100 100\">\n                    <circle\n                      cx=\"50\"\n                      cy=\"50\"\n                      r=\"44\"\n                      fill=\"none\"\n                      stroke=\"#E2E8F0\"\n                      strokeWidth=\"9\"\n                    />\n                    <circle\n                      cx=\"50\"\n                      cy=\"50\"\n                      r=\"44\"\n                      fill=\"none\"\n                      stroke=\"#0D9488\"\n                      strokeWidth=\"9\"\n                      strokeLinecap=\"round\"\n                      strokeDasharray={ringCircumference}\n                      strokeDashoffset={ringOffset}\n                    />\n                  </svg>\n                  <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n                    <span className=\"font-display text-xl font-bold text-[#0B2540] tabular-nums\">\n                      {adherence}%\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"space-y-1.5 text-xs text-slate-700 min-w-0\">\n                  <div className=\"font-mono text-[11px] font-semibold text-slate-500 tabular-nums\">\n                    Month {programme?.currentMonth ?? 6} / 12\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-600 shrink-0\" />\n                    <span className=\"truncate\">Balanced Indian Diet</span>\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-600 shrink-0\" />\n                    <span className=\"truncate\">Daily Steps Goal</span>\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-600 shrink-0\" />\n                    <span className=\"truncate\">Restorative Sleep</span>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'prevent\')}\n                className=\"w-full rounded-xl bg-[#EBF4FA] py-2 text-xs font-semibold text-[#0B2540] hover:bg-[#DDEBF5] transition-colors\"\n              >\n                Continue Programme \342\206\222\n              </button>\n            </div>\n          </section>\n\n          {/* Bottom Action & Continuity Row */}\n          <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-5\">\n            {/* Upcoming Appointments */}\n            <div className=\"lg:col-span-4 rounded-2xl border border-slate-200 bg-white p-5\">\n              <div className=\"flex items-center justify-between mb-3\">\n                <h2 className=\"font-display text-base font-bold text-[#0B2540]\">\n                  Upcoming Appointments\n                </h2>\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'appointments\')}\n                  className=\"text-xs font-semibold text-[#0D9488] hover:underline\"\n                >\n                  View All \342\206\222\n                </button>\n              </div>\n\n              {upcomingApt ? (\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-start gap-3\">\n                    <div className=\"flex flex-col items-center justify-center rounded-xl bg-[#EBF4FA] px-3 py-2 text-center shrink-0\">\n                      <span className=\"font-mono text-lg font-bold text-[#0B2540] tabular-nums leading-none\">\n                        {upcomingApt.scheduledDate.slice(8, 10)}\n                      </span>\n                      <span className=\"mt-0.5 text-[11px] font-semibold text-[#12598C]\">\n                        {new Date(`${upcomingApt.scheduledDate}T00:00:00`).toLocaleString(\'en\', {\n                          month: \'short\',\n                        })}\n                      </span>\n                    </div>\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"text-sm font-semibold text-slate-900 truncate\">\n                        {upcomingApt.title}\n                      </div>\n                      <div className=\"mt-0.5 text-xs text-slate-500\">\n                        {upcomingApt.scheduledTime} \302\267 {upcomingApt.facility}\n                      </div>\n                      <div className=\"mt-1 text-xs font-semibold text-emerald-700\">\n                        Status: {upcomingApt.status}\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"rounded-xl bg-amber-50/90 border border-amber-200/70 px-3.5 py-2.5 text-xs text-amber-950\">\n                    <strong>Reminder:</strong> {upcomingApt.reminderNote}\n                  </div>\n                </div>\n              ) : (\n                <p className=\"text-xs text-slate-500\">No upcoming appointments scheduled.</p>\n              )}\n            </div>\n\n            {/* Quick Actions */}\n            <div className=\"lg:col-span-4 rounded-2xl border border-slate-200 bg-white p-5\">\n              <h2 className=\"font-display text-base font-bold text-[#0B2540] mb-3\">\n                Quick Actions\n              </h2>\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'prevent\')}\n                  className=\"flex flex-col items-center justify-center gap-2 rounded-xl border border-emerald-200/80 bg-emerald-50/60 p-3.5 text-center hover:bg-emerald-100/70 transition-colors\"\n                >\n                  <ClipboardList className=\"h-5 w-5 text-emerald-700\" />\n                  <span className=\"text-xs font-semibold text-slate-800\">Take Risk Assessment</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'detect\')}\n                  className=\"flex flex-col items-center justify-center gap-2 rounded-xl border border-sky-200/80 bg-sky-50/60 p-3.5 text-center hover:bg-sky-100/70 transition-colors\"\n                >\n                  <Eye className=\"h-5 w-5 text-sky-700\" />\n                  <span className=\"text-xs font-semibold text-slate-800\">Upload Retinal Image</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'reports\')}\n                  className=\"flex flex-col items-center justify-center gap-2 rounded-xl border border-indigo-200/80 bg-indigo-50/60 p-3.5 text-center hover:bg-indigo-100/70 transition-colors\"\n                >\n                  <FileText className=\"h-5 w-5 text-indigo-700\" />\n                  <span className=\"text-xs font-semibold text-slate-800\">View Reports</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'appointments\')}\n                  className=\"flex flex-col items-center justify-center gap-2 rounded-xl border border-amber-200/80 bg-amber-50/60 p-3.5 text-center hover:bg-amber-100/70 transition-colors\"\n                >\n                  <Calendar className=\"h-5 w-5 text-amber-700\" />\n                  <span className=\"text-xs font-semibold text-slate-800\">Book Appointment</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Health Insights */}\n            <div className=\"lg:col-span-4 rounded-2xl border border-slate-200 bg-white p-5\">\n              <div className=\"flex items-center gap-2 mb-3\">\n                <Lightbulb className=\"h-4 w-4 text-[#0D9488]\" />\n                <h2 className=\"font-display text-base font-bold text-[#0B2540]\">\n                  Health Insights\n                </h2>\n              </div>\n              <ul className=\"space-y-2.5 text-xs text-slate-700 leading-relaxed\">\n                <li className=\"flex items-start gap-2\">\n                  <CheckCircle2 className=\"h-4 w-4 text-emerald-600 shrink-0 mt-0.5\" />\n                  <span>\n                    Waist trend improved by{\' \'}\n                    <strong className=\"font-mono tabular-nums\">\n                      {(programme?.baselineWaistCm ?? 83) - (programme?.currentWaistCm ?? 78)} cm\n                    </strong>{\' \'}\n                    since starting Phase 1 Learning.\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2\">\n                  <CheckCircle2 className=\"h-4 w-4 text-emerald-600 shrink-0 mt-0.5\" />\n                  <span>\n                    Top focus areas:{\' \'}\n                    <strong>{latestAssessment?.topModifiableFactors.join(\', \') || \'Diet & Steps\'}</strong>.\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2\">\n                  <CheckCircle2 className=\"h-4 w-4 text-emerald-600 shrink-0 mt-0.5\" />\n                  <span>\n                    Next recommended retinal screening:{\' \'}\n                    <strong>{data.followUps[0]?.nextScreeningDate || \'May 2027 (Annual)\'}</strong>.\n                  </span>\n                </li>\n              </ul>\n            </div>\n          </section>\n        </div>\n\n        {/* Right Rail (3 Columns) */}\n        <aside className=\"xl:col-span-3 space-y-5\">\n          {/* Alerts & Notifications */}\n          <div className=\"rounded-2xl border border-slate-200 bg-white p-5\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <h2 className=\"font-display text-sm font-bold text-[#0B2540]\">\n                Alerts &amp; Notifications\n              </h2>\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'notifications\')}\n                className=\"text-xs font-semibold text-[#0D9488] hover:underline\"\n              >\n                View All \342\206\222\n              </button>\n            </div>\n            <div className=\"space-y-3\">\n              {data.notifications.slice(0, 3).map((item) => (\n                <button\n                  key={item.id}\n                  type=\"button\"\n                  onClick={() => item.actionView && onNavigate(item.actionView)}\n                  className=\"flex w-full items-start gap-2.5 rounded-xl border border-slate-100 bg-slate-50/70 p-3 text-left hover:bg-slate-100/80 transition-colors\"\n                >\n                  <AlertCircle\n                    className={`h-4 w-4 shrink-0 mt-0.5 ${\n                      item.severity === \'urgent\'\n                        ? \'text-rose-600\'\n                        : item.severity === \'warning\'\n                        ? \'text-amber-600\'\n                        : item.severity === \'success\'\n                        ? \'text-emerald-600\'\n                        : \'text-sky-600\'\n                    }`}\n                  />\n                  <div className=\"min-w-0\">\n                    <div className=\"text-xs font-semibold text-slate-900\">{item.title}</div>\n                    <p className=\"mt-0.5 text-[11px] text-slate-600 line-clamp-2\">{item.message}</p>\n                  </div>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Offline Readiness & Sync Card */}\n          <div className=\"rounded-2xl border border-slate-200 bg-white p-5\">\n            <h2 className=\"font-display text-sm font-bold text-[#0B2540]\">\n              Offline-First Readiness\n            </h2>\n            <div className=\"mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3.5\">\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-slate-900\">\n                {isOnline ? (\n                  <Wifi className=\"h-4 w-4 text-emerald-600\" />\n                ) : (\n                  <WifiOff className=\"h-4 w-4 text-amber-600\" />\n                )}\n                <span>{isOnline ? \'Connected \302\267 IndexedDB Ready\' : \'Offline Mode Active\'}</span>\n              </div>\n              <p className=\"mt-1.5 text-[11px] text-slate-600 leading-relaxed\">\n                Lifestyle assessments &amp; habit logs work offline via Dexie IndexedDB. Remote doctor reviews &amp; hospital confirmations require connectivity.\n              </p>\n              <div className=\"mt-3 flex items-center justify-between gap-2\">\n                <span className=\"font-mono text-xs font-semibold text-slate-700 tabular-nums\">\n                  Queue: {pendingSyncCount}\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={pendingSyncCount > 0 && isOnline ? onSyncNow : () => onNavigate(\'offline\')}\n                  className=\"inline-flex items-center gap-1.5 rounded-lg bg-[#0B2540] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#113556]\"\n                >\n                  <RefreshCw className=\"h-3.5 w-3.5\" />\n                  {pendingSyncCount > 0 && isOnline ? \'Sync Now\' : \'Offline Console\'}\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Clinical Boundary Card */}\n          <div className=\"rounded-2xl border border-slate-200 bg-white p-5\">\n            <h2 className=\"font-display text-sm font-bold text-[#0B2540]\">\n              Clinical Governance Note\n            </h2>\n            <p className=\"mt-2 text-xs text-slate-600 leading-relaxed\">\n              {t.clinicalBoundaryShort}\n            </p>\n            <div className=\"mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-500\">\n              Assigned Health Worker: <strong className=\"text-slate-700\">{patient?.assignedHealthWorker || \'Anitha K (VHN)\'}</strong>\n            </div>\n          </div>\n        </aside>\n      </div>\n    </div>\n  );\n};\n"
        path {
