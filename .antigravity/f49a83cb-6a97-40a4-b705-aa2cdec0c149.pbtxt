      thinking_signature: "\022\316\005\n\313\005\001i\024}\023\311\221\252\267?\237}\004\024\205\271\223\237\302\263d\2417Wc\202\325o\371\324:\342\220^\334h\275)9\327q\343\036\3255\367r\342/N\v!\a\004\'\005\365\316\'\377\3555\036\326R\322o\243\363\237\247\361\001=\336\365\314\021\006c#\216>\322\303\376bg5\027\325PI\346<\374\364iS\322\355\270HWl4\300A7\201\204\237\360}cFY1\343\221(\004et\314@\213$\213\211\322\334/\354\223\\\333\330\244\214}\356C\027\367\rLJ\363\250F!\340\375\322[\324\024Nw\345\374#\326\304\362r\\W{\203\267\200\352c\341I\270\3548B\333\222\361a\255h\000oC*8U\355L},\342\'8\243\f\332\tn\253~\273\353\367{\360\f\267\020\006H1\251\262\250\227\340A\316\033Oh5\031\213\274\210\243\207\361\201\210>\241]\217\332\306s\343Fl\034\a\017\241\302Gq\177\315\225\274\241}\000\300i\332\274\230P\320+\205q\334J\357\307e\305I\020\276\351\312b3\320\300\245+\376v\0004V\226\311{\236.\316nS\332d\242\337O\213<\350\034d\305\230\317\374\274\255G\245\360\247s\256P\200q8\362s\227\254nb&\227\035\241\366>\303\231\207\244C\027\3120\003\202bj\2379\330\35741g\005\314\354\334ik\244\341\3206\301\316\276a1t\370\232\303\310t\213\331\\\250\023\374\353\263\243\220X\356/\272\265\371c\311c\3228\205\304\211\334\227,\334o\253o\023\250If\263Z\316E\037,zP\211\225\261\345\362Q\276\024\331#,X9\024\236\260\221\320\250R\024\355\300\003\267\a|f4d\2343\177\240\3013\271\017o\200\v\365\341\252\0247\273\033xsM\243\301\006{\304-\230\026\232VJ\341\355 \253Q,Z\356\344\227\n\024;<g\235\350I\3518W\034\3077\230W?L\037\320+\037\342\177|:\340/U\277\212E(V\202\356\265\311\f\245\206f\270\200\244\320\253\357\246\314-|*\232pp\271md,a\342\267h\037\242\360\006\220\232~j\307Kn\243\352|\324RC\232OQ*\264\345\354\231\340&\312@\224\3500\334\246n\266\"\r=\313u\324\264a\344\256\v\250P\r\361m\201\357\233\375\004/\221\020R\315e\374\234\305O0\253b\r\240n(\025X\245\v_\220\335f\260\364T\326\0007>\237\275\272RnwB\r\202\023\355F\252m>\004\344\t\266\000\360\3372\336\257\260d\020\260\225j\263\270]#\254\264\217!h_\234 \302\273x\260\027[\3