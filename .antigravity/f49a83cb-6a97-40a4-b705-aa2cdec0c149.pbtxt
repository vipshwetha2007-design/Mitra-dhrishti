      thinking_signature: "\022\224\020\n\221\020\001i\024}\023O\242\233fI\202\337\326\0054\\\n.od\302\362\321!(\206%^X\310\235\fF\302\321\331\021\362\tG\244<_d\017\2134N\347\317\233\a;\244\241EX\235\212\210\211\003\314\230~\211SP\327\270]\232_\340++\351XX\320\361\236\374\313K@X2\201\230\351\363\345\325\214\020.\265\326*\260oa6\032\204\177\246\030\230J\"\355\351L\361\026\237t5\247_-\335\315\bS\207\031\f\270\314\217\252O\036\302\347\315\232\341\306\220\321\031\332\327DS\232\313B\362\276\v\f\344\204\\\027\246\264\306\267Q4\340\376\243G\333\274g\321aZ\333\341\220\277\244X\'\325p[#\373d\3218-f\322\n\345\317n\354\036I?en\300I\232\226\306\252\245\254G\003|\217\020\235/\216\356\300\343\241\333/\343q\304>^\032\3358T\263\242(\021\034\253w\240\336\352\261iS\a\302\343)\0260q\263Q8\322\034\307\025\345\321\346\204O$\202l\326\323\300\347\256\206\331\257J\340m\243PC\212\316\337\220\226\336Y\322\326 \247\241\270\254\201:&\330\220/\335\032(iTX\262ZwK\203)\377m\330\245GC\232\357\006\026\307\255/\214\032\002|1\243\025\365\331\371\361%4s>\241\3134\324_wL\271\332\002\310\324\2030_\251A\216\t<\220\276d\037\243{\036\322/\263D=\316\201\306k=C\352\255\327y\352\204\036\333FLIz\004\336\034\261\204,I\254\0360\322bR\354\004\364\033\212\361d\277\341\323\304\vVS\205\030\315\223>t{\367S5wM\365\303\t\260M:\355~\341[\361\201AV\221W\331\035\200\347K\312\2537f\225x3%\262L-\034\313B\200\027S\'\323\037\250\023\236\231\266\347[=\217k\n\223 \372\343\0324~\265\336\a\205+\023\322\367\254\352\337\255\323\221\034\314/\215\366~2\246\373\330>\240l\364\254\037\267\205>g\346\024 \303\206\270\341\273\232\330u\376\3521{;:3\307b\213\251s\027Mds\314\230\035\260\227:\210~e\273\245\207\024\224,\221\373qb\352-(\224l\331\212b\226\235\030\322C.\v:9\030\227\024e\274\242\023\035\370\002%\372\315\244A0\223f\317jS\n*,\345CX\000K8\352u\364\035z\025\022\366Ss\0011\bE\322\224\262\034u\226D\264\027\3272\226\305A`M\"2\366U\244\222\271S\375K\331g\302\325\255\233WB)\000\251\354\fO\265\251\2137\222\231W\212\033\224X\030n\204$\242\235\f\370:/\241\274\203\305=\360\000\346\035@\323 \256]V<\017\023/KL\260\342z\234C\264 \021\\t\214Q\362b\000\233Z\370w\253\374\034\336\227J\344<\263\214\247qf\2035\267\251\221\366kK\240?\v}\267y\376\313(c^\372?\275\022\035\320\261,O[-\354{\3520\r\365\240jTr\311`\3001[\205~\333\304\236h\r\356u\251\202\267p\025\204\366N\267d\223(\3344!b$\204?YEIE\303\003\275G&E\362\33226\206l\334\253\027)\020\250\200\205\304\316\245\227Bk6\273k\026\207\252\201\236\225\362+ew%\344\353\033\026\\\025\375(\\\302u6\324\262\212=T\261F\')\227\342H\303\314\211\233\333\243\255\372\247\vk\347\322\031hH\251\206\277-(S\276\274t\207c\2631\207\347\232:\231\201P\207\245\241\340\266\325-^\022j6\t\374\037/:\"\031\352\335U\350(\024\017\264\352@u\216e\304o\270\302\343=\336\270\251\211t\035:\322%,\003f\222\t\22587\000\023\030g\254\341\212\376A\370\017\0238\233\375UE\034\312R\362\344\033:Q\'{&I\f\035\337\334\216\340\326OI\030z\335\245<\'\303\3511\243!\362>\313dsy\365\'\263\351\272\256\341\351\250\315\204o\351!N\355\234\2104E\230!Vx\261\232\275\003\t\022\3208\222\324\353\215MZ\252U\367O>\217bU\346#\363\261\016\036\032g\366\323=W\320\t\207\336_\336\336Ggj\023\207\203\317\222#\\P\310\371&\003\303\\\016W\336\376<M\232\357\367\371\314%\270\322\017f\220\031p\210\3166,\034\006\304\334lOl#.\024\256\370\2334\333\030w\206r$\374\334\322\006\025\260\307\304\203\234\\r\261\364\221\2439\f\310\226\030\244\250\256\354\266\264\374\324\346\b\332C\021F\231\310\303 \302\374^\342\022\255\307\372a\200\312\210+\350U0\332\360ipO\006\273)S\212\254\334\374\307\314\260\212\377\214\037\321*.\247\301;$>\225\2709\343\202\307\364#\022\002\234\020\277P!\024ci\242\224\322\377@\344\035\340\344c\350Aj\334\244\244\300\033@\264\b=6C\002\327\255O\204\353:9\204\025\346\334\037\353\314j\3604r\265K\330\034\2269\001\321\276WQX\215\323\t\333Q\261\302\273\313\313\016\031x0/\244J*H\261\004G\374\330_\342\251+f\266\025\373H\r\357\301\216\255\314\220\230,Y\031\307\254\aY\310\204\033@,+\330\256\025\260\3258\021\250xc/\204Y\324\356\362\2558\201\314\036s\333