              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      res.status(403).json({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        error: `Access denied. Role \'${user.role}\' is not permitted to perform this clinical/administrative operation.`,"
