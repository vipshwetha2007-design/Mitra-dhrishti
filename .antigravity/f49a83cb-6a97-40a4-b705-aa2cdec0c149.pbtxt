      create_file {
        instruction: "import type { LanguageCode } from \'../types/domain\';\n\nexport interface TranslationBundle {\n  appTagline: string;\n  clinicalBoundaryShort: string;\n  nav: {\n    dashboard: string;\n    prevent: string;\n    preventSub: string;\n    detect: string;\n    detectSub: string;\n    protect: string;\n    protectSub: string;\n    reports: string;\n    appointments: string;\n    referrals: string;\n    notifications: string;\n    offline: string;\n    simulink: string;\n    settings: string;\n  };\n  topbar: {\n    searchPlaceholder: string;\n    online: string;\n    offline: string;\n    syncPending: string;\n    switchRole: string;\n    signIn: string;\n  };\n  hero: {\n    welcomeBack: string;\n    subtitle: string;\n    tagline: string;\n    exploreCta: string;\n  };\n  pillars: {\n    preventTitle: string;\n    preventDesc: string;\n    detectTitle: string;\n    detectDesc: string;\n    protectTitle: string;\n    protectDesc: string;\n  };\n}\n\nexport const TRANSLATIONS: Record<LanguageCode, TranslationBundle> = {\n  en: {\n    appTagline: \'Prevent \342\200\242 Detect \342\200\242 Protect\',\n    clinicalBoundaryShort:\n      \'Screening & care-coordination prototype only \342\200\224 not a diagnostic replacement. All clinical decisions remain with authorised healthcare professionals.\',\n    nav: {\n      dashboard: \'Dashboard\',\n      prevent: \'Prevent\',\n      preventSub: \'Diabetes Care\',\n      detect: \'Detect\',\n      detectSub: \'Retinal Screening\',\n      protect: \'Protect\',\n      protectSub: \'Clinical Follow-up\',\n      reports: \'My Reports\',\n      appointments: \'Appointments\',\n      referrals: \'Referrals\',\n      notifications: \'Notifications\',\n      offline: \'Offline Sync\',\n      simulink: \'Simulink Analytics\',\n      settings: \'Settings\',\n    },\n    topbar: {\n      searchPlaceholder: \'Search patients, reports, or services...\',\n      online: \'Online\',\n      offline: \'Offline Mode\',\n      syncPending: \'pending sync\',\n      switchRole: \'Switch Role / Account\',\n      signIn: \'Sign In\',\n    },\n    hero: {\n      welcomeBack: \'Welcome back\',\n      subtitle: \'Your health. Our priority.\',\n      tagline: \'Prevent diabetes risk. Support retinal screening. Protect continuity of care.\',\n      exploreCta: \'Explore Your Health\',\n    },\n    pillars: {\n      preventTitle: \'PREVENT\',\n      preventDesc: \'Manage Type 2 Diabetes Risk\',\n      detectTitle: \'DETECT\',\n      detectDesc: \'AI-Assisted Retinal Screening\',\n      protectTitle: \'PROTECT\',\n      protectDesc: \'Clinician Review & Follow-up\',\n    },\n  },\n  ta: {\n    appTagline: \'\340\256\244\340\256\237\340\257\201\340\256\252\340\257\215\340\256\252\340\257\201 \342\200\242 \340\256\225\340\256\243\340\257\215\340\256\237\340\256\261\340\256\277\340\256\244\340\256\262\340\257\215 \342\200\242 \340\256\252\340\256\276\340\256\244\340\257\201\340\256\225\340\256\276\340\256\252\340\257\215\340\256\252\340\257\201\',\n    clinicalBoundaryShort:\n      \'\340\256\207\340\256\244\340\257\201 \340\256\232\340\257\201\340\256\225\340\256\276\340\256\244\340\256\276\340\256\260 \340\256\252\340\256\260\340\256\277\340\256\232\340\257\213\340\256\244\340\256\251\340\257\210 \340\256\256\340\256\261\340\257\215\340\256\261\340\257\201\340\256\256\340\257\215 \340\256\252\340\256\260\340\256\276\340\256\256\340\256\260\340\256\277\340\256\252\340\257\215\340\256\252\340\257\201 \340\256\211\340\256\244\340\256\265\340\256\277 \340\256\256\340\256\276\340\256\244\340\256\277\340\256\260\340\256\277 \340\256\256\340\256\237\340\257\215\340\256\237\340\257\201\340\256\256\340\257\207 \342\200\224 \340\256\256\340\256\260\340\257\201\340\256\244\340\257\215\340\256\244\340\257\201\340\256\265 \340\256\250\340\257\213\340\256\257\340\256\261\340\256\277\340\256\244\340\256\262\340\257\201\340\256\225\340\257\215\340\256\225\340\257\201 \340\256\256\340\256\276\340\256\261\340\257\215\340\256\261\340\257\201 \340\256\205\340\256\262\340\257\215\340\256\262. \340\256\205\340\256\251\340\257\210\340\256\244\340\257\215\340\256\244\340\257\201 \340\256\256\340\256\260\340\257\201\340\256\244\340\257\215\340\256\244\340\257\201\340\256\265 \340\256\256\340\257\201\340\256\237\340\256\277\340\256\265\340\257\201\340\256\225\340\256\263\340\257\201\340\256\256\340\257\215 \340\256\205\340\256\231\340\257\215\340\256\225\340\257\200\340\256\225\340\256\260\340\256\277\340\256\225\340\257\215\340\256\225\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237 \340\256\256\340\256\260\340\257\201\340\256\244\340\257\215\340\256\244\340\257\201\340\256\265\340\256\260\340\257\215\340\256\225\340\256\263\340\256\276\340\256\262\340\257\215 \340\256\216\340\256\237\340\257\201\340\256\225\340\257\215\340\256\225\340\256\252\340\257\215\340\256\252\340\256\237\340\257\201\340\256\256\340\257\215.\',\n    nav: {\n      dashboard: \'\340\256\256\340\257\201\340\256\225\340\256\252\340\257\215\340\256\252\340\257\201\',\n      prevent: \'\340\256\244\340\256\237\340\257\201\340\256\252\340\257\215\340\256\252\340\257\201 (Prevent)\',\n      preventSub: \'\340\256\250\340\257\200\340\256\260\340\256\277\340\256\264\340\256\277\340\256\265\340\257\201 \340\256\252\340\256\260\340\256\276\340\256\256\340\256\260\340\256\277\340\256\252\340\257\215\340\256\252\340\257\201\',\n      detect: \'\340\256\225\340\256\243\340\257\215\340\256\237\340\256\261\340\256\277\340\256\244\340\256\262\340\257\215 (Detect)\',\n      detectSub: \'\340\256\265\340\256\277\340\256\264\340\256\277\340\256\244\340\257\215\340\256\244\340\256\277\340\256\260\340\257\210 \340\256\252\340\256\260\340\256\277\340\256\232\340\257\213\340\256\244\340\256\251\340\257\210\',\n      protect: \'\340\256\252\340\256\276\340\256\244\340\257\201\340\256\225\340\256\276\340\256\252\340\257\215\340\256\252\340\257\201 (Protect)\',\n      protectSub: \'\340\256\256\340\256\260\340\257\201\340\256\244\340\257\215\340\256\244\340\257\201\340\256\265 \340\256\252\340\256\277\340\256\251\340\257\215\340\256\244\340\257\212\340\256\237\340\256\260\340\257\215\340\256\244\340\256\262\340\257\215\',\n      reports: \'\340\256\205\340\256\261\340\256\277\340\256\225\340\257\215\340\256\225\340\257\210\340\256\225\340\256\263\340\257\215\',\n      appointments: \'\340\256\232\340\256\250\340\257\215\340\256\244\340\256\277\340\256\252\340\257\215\340\256\252\340\257\201\340\256\225\340\256\263\340\257\215\',\n      referrals: \'\340\256\252\340\256\260\340\256\277\340\256\250\340\257\215\340\256\244\340\257\201\340\256\260\340\257\210\340\256\225\340\256\263\340\257\215\',\n      notifications: \'\340\256\205\340\256\261\340\256\277\340\256\265\340\256\277\340\256\252\340\257\215\340\256\252\340\257\201\340\256\225\340\256\263\340\257\215\',\n      offline: \'\340\256\206\340\256\203\340\256\252\340\257\215\340\256\262\340\257\210\340\256\251\340\257\215 \340\256\222\340\256\244\340\257\215\340\256\244\340\256\277\340\256\232\340\257\210\340\256\265\340\257\201\',\n      simulink: \'\340\256\232\340\256\277\340\256\256\340\257\201\340\256\262\340\256\277\340\256\231\340\257\215\340\256\225\340\257\215 \340\256\252\340\256\225\340\257\201\340\256\252\340\257\215\340\256\252\340\256\276\340\256\257\340\257\215\340\256\265\340\257\201\',\n      settings: \'\340\256\205\340\256\256\340\257\210\340\256\252\340\257\215\340\256\252\340\257\201\340\256\225\340\256\263\340\257\215\',\n    },\n    topbar: {\n      searchPlaceholder: \'\340\256\250\340\257\213\340\256\257\340\256\276\340\256\263\340\256\277\340\256\225\340\256\263\340\257\215, \340\256\205\340\256\261\340\256\277\340\256\225\340\257\215\340\256\225\340\257\210\340\256\225\340\256\263\340\257\215 \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 \340\256\232\340\257\207\340\256\265\340\257\210\340\256\225\340\256\263\340\257\210\340\256\244\340\257\215 \340\256\244\340\257\207\