              text: "    ctx.fillStyle = \'#E0F2FE\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.font = \'600 11px \"DM Sans\", sans-serif\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillText(\'Optic Disc\', discX - 26, discY - discR - 8);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillStyle = \'#CCFBF1\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillText(\'Macula / Fovea\', maculaX - 36, maculaY + r * 0.26 + 12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Step 4: Lesion Candidate Overlays (Illustrative)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (options?.stage === \'lesions\' && preset === \'moderate_npdr_demo\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.strokeStyle = \'#FACC15\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.lineWidth = 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.strokeRect(cx - r * 0.34, cy - r * 0.24, r * 0.22, r * 0.2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillStyle = \'#FEF08A\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.font = \'600 11px \"DM Sans\", sans-serif\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillText(\'Exudate Cluster\', cx - r * 0.36, cy - r * 0.26);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.strokeStyle = \'#FB7185\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.arc(cx - r * 0.32, cy - r * 0.04, r * 0.09, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.stroke();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.arc(cx - r * 0.06, cy + r * 0.28, r * 0.09, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.stroke();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillStyle = \'#FECDD3\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.fillText(\'Haemorrhage Candidate\', cx - r * 0.18, cy + r * 0.42);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Step 6: Grad-CAM Explainability Heatmap Overlay"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (options?.stage === \'gradcam\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const opacity = options.gradCamOpacity ?? 0.6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const spots ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      options.hotspots && options.hotspots.length > 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? options.hotspots"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : preset === \'moderate_npdr_demo\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ? ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            { x: 0.38, y: 0.42, radius: 0.16, intensity: 0.9 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            { x: 0.54, y: 0.62, radius: 0.15, intensity: 0.8 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        : [{ x: 0.66, y: 0.48, radius: 0.18, intensity: 0.42 }];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (const spot of spots) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const sx = spot.x * w;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const sy = spot.y * h;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const sr = spot.radius * w;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const hGrad = ctx.createRadialGradient(sx, sy, 2, sx, sy, sr);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      hGrad.addColorStop(0, `rgba(239, 68, 68, ${Math.min(0.95, opacity * spot.intensity)})`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      hGrad.addColorStop(0.4, `rgba(250, 204, 21, ${opacity * spot.intensity * 0.78})`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      hGrad.addColorStop(0.75, `rgba(34, 197, 94, ${opacity * spot.intensity * 0.42})`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      hGrad.addColorStop(1, \'rgba(37, 99, 235, 0)\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fillStyle = hGrad;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.arc(sx, sy, sr, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Runs genuine client-side pixel statistics on an HTMLImageElement or HTMLCanvasElement"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * to compute Step 1 Image Quality Assessment (sharpness variance, brightness, exposure clipping,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * resolution, retinal color distribution OOD check) and prepares the 7-step illustrative pipeline payload."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function analyzeRetinalCanvasPixels("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  sourceCanvas: HTMLCanvasElement,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  presetMode: \'normal_demo\' | \'moderate_npdr_demo\' | \'ungradable_blur_demo\' | \'uploaded_custom\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): PipelineAnalysisOutput {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const ctx = sourceCanvas.getContext(\'2d\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const w = sourceCanvas.width;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const h = sourceCanvas.height;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let meanLuminance = 120;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let clippedCount = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let laplacianSum = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let totalChecked = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let warmRetinalPixels = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (ctx) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const imgData = ctx.getImageData(0, 0, w, h).data;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const gray = new Float32Array(w * h);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let i = 0, p = 0; i < imgData.length; i += 4, p++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const r = imgData[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const g = imgData[i + 1];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const b = imgData[i + 2];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const lum = 0.299 * r + 0.587 * g + 0.114 * b;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gray[p] = lum;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    // Focus inside central retinal circle (radius 40% of min dim)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const cx = w / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const cy = h / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const radSq = Math.pow(Math.min(w, h) * 0.38, 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    let lumAccum = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    for (let y = 2; y < h - 2; y += 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let x = 2; x < w - 2; x += 2) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const dx = x - cx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const dy = y - cy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (dx * dx + dy * dy > radSq) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const idx = y * w + x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const lum = gray[idx];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        lumAccum += lum;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        totalChecked++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (lum < 12 || lum > 246) clippedCount++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const r = imgData[idx * 4];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const g = imgData[idx * 4 + 1];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const b = imgData[idx * 4 + 2];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Fundus images typically exhibit higher red/orange dominance over blue inside ROI"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (r > g * 1.05 && r > b * 1.25 && r > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          warmRetinalPixels++;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const lap = Math.abs("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          4 * lum - gray[idx - 1] - gray[idx + 1] - gray[idx - w] - gray[idx + w]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        laplacianSum += lap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (totalChecked > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      meanLuminance = Math.round(lumAccum / totalChecked);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const exposureClipPercent ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalChecked > 0 ? Number(((clippedCount / totalChecked) * 100).toFixed(1)) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rawSharpness = totalChecked > 0 ? (laplacianSum / totalChecked) * 12 : 70;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sharpnessScore ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    presetMode === \'ungradable_blur_demo\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ? Math.min(34, Math.max(18, Math.round(rawSharpness)))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      : Math.min(96, Math.max(25, Math.round(rawSharpness + 38)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const retinalColorRatio = totalChecked > 0 ? warmRetinalPixels / totalChecked : 0.8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const oodFlag = presetMode === \'uploaded_custom\' && retinalColorRatio < 0.25;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const resolutionValid = w >= 256 && h >= 256;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const blurPass = sharpnessScore >= 45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const brightnessPass = meanLuminance >= 42 && meanLuminance <= 215;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const exposurePass = exposureClipPercent <= 18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const gradable = resolutionValid && blurPass && brightnessPass && exposurePass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let rejectionReason: string | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let recaptureGuidance: string | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!gradable) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (!resolutionValid) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rejectionReason = `Low image resolution (${w}\303\227${h}px; minimum 256\303\227256px required).`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      recaptureGuidance = \'Capture using standard non-mydriatic fundus resolution (\342\211\245 512\303\227512px).\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (!blurPass) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rejectionReason = `Excessive motion blur / defocus (Sharpness ${sharpnessScore}/100 < threshold 45).`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      recaptureGuidance = \'Stabilize chin rest, confirm optic disc focus lock, and ask patient to fixate before recapturing.\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (!brightnessPass) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rejectionReason = `Improper illumination (Mean luminance ${meanLuminance}/255 outside 42\342\200\223215 window).`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      recaptureGuidance = \'Dim room lighting for natural pupil dilation and adjust camera flash exposure.\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    } else if (!exposurePass) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rejectionReason = `High exposure clipping (${exposureClipPercent}% clipped pixels).`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      recaptureGuidance = \'Reduce flash intensity and avoid lens glare artifacts.\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Illustrative ICDR grade logic (strictly non-diagnostic prototype output)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let icdrGrade: ICDRGrade = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let gradeLabel = \'ICDR Grade 0 \342\200\224 No Apparent DR (Illustrative Prototype Assist)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let confidence = 0.89;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let hardExudatesFlag = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let haemorrhagesFlag = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let hotspots = [{ x: 0.66, y: 0.48, radius: 0.16, intensity: 0.45 }];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (presetMode === \'moderate_npdr_demo\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    icdrGrade = 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    gradeLabel = \'ICDR Grade 2 \342\200\224 Moderate NPDR Suspected (Illustrative Prototype Assist)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    confidence = 0.83;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hardExudatesFlag = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    haemorrhagesFlag = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    hotspots = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { x: 0.38, y: 0.42, radius: 0.15, intensity: 0.88 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { x: 0.54, y: 0.62, radius: 0.14, intensity: 0.78 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (presetMode === \'uploaded_custom\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (oodFlag) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      icdrGrade = null;"
