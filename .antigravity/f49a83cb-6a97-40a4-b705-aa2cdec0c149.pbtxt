    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "f49a83cb-6a97-40a4-b705-aa2cdec0c149"
      step_index: 1
      cascade_id: "f49a83cb-6a97-40a4-b705-aa2cdec0c149"
