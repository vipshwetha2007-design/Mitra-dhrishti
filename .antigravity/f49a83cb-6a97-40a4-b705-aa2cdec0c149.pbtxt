    command_line: "python3 -c \'\nimport struct, zlib, math\n\ndef make_png(path, size, maskable=False):\n    raw = bytearray()\n    cx, cy = size / 2.0, size / 2.0\n    scale = 0.68 if maskable else 0.85\n    for y in range(size):\n        raw.append(0)\n        for x in range(size):\n            t = (x + y) / (2.0 * size)\n            r = int(11 * (1 - t) + 15 * t)\n            g = int(37 * (1 - t) + 82 * t)\n            b = int(64 * (1 - t) + 102 * t)\n            nx = (x - cx) / (size * 0.5 * scale)\n            ny = (y - cy) / (size * 0.5 * scale)\n            # Medical cross in center\n            if (abs(nx) < 0.14 and abs(ny) < 0.42) or (abs(ny) < 0.14 and abs(nx) < 0.42):\n                r, g, b = 255, 255, 255\n            else:\n                # Teal protective ring around cross\n                dist = math.hypot(nx, ny)\n                if 0.62 < dist < 0.78:\n                    r, g, b = 20, 184, 166\n            raw.extend((r, g, b, 255))\n    def chunk(tag, data):\n        return struct.pack(\"!I\", len(data)) + tag + data + struct.pack(\"!I\", zlib.crc32(tag + data) & 0xffffffff)\n    ihdr = struct.pack(\"!IIBBBBB\", size, size, 8, 6, 0, 0, 0)\n    png = b\"\\x89PNG\\r\\n\\x1a\\n\" + chunk(b\"IHDR\", ihdr) + chunk(b\"IDAT\", zlib.compress(bytes(raw), 6)) + chunk(b\"IEND\", b\"\")\n    with open(path, \"wb\") as f:\n        f.write(png)\n\nmake_png(\"public/pwa-192x192.png\", 192, False)\nmake_png(\"public/pwa-512x512.png\", 512, False)\nmake_png(\"public/pwa-maskable-512x512.png\", 512, True)\nmake_png(\"public/apple-touch-icon.png\", 180, False)\nprint(\"Generated PNG icons successfully\")\n\' && ls -lh public/*.png public/icon.svg"
    proposed_command_line: "python3 -c \'\nimport struct, zlib, math\n\ndef make_png(path, size, maskable=False):\n    raw = bytearray()\n    cx, cy = size / 2.0, size / 2.0\n    scale = 0.68 if maskable else 0.85\n    for y in range(size):\n        raw.append(0)\n        for x in range(size):\n            t = (x + y) / (2.0 * size)\n            r = int(11 * (1 - t) + 15 * t)\n            g = int(37 * (1 - t) + 82 * t)\n            b = int(64 * (1 - t) + 102 * t)\n            nx = (x - cx) / (size * 0.5 * scale)\n            ny = (y - cy) / (size * 0.5 * scale)\n            # Medical cross in center\n            if (abs(nx) < 0.14 and abs(ny) < 0.42) or (abs(ny) < 0.14 and abs(nx) < 0.42):\n                r, g, b = 255, 255, 255\n            else:\n                # Teal protective ring around cross\n                dist = math.hypot(nx, ny)\n                if 0.62 < dist < 0.78:\n                    r, g, b = 20, 184, 166\n            raw.extend((r, g, b, 255))\n    def chunk(tag, data):\n        return struct.pack(\"!I\", len(data)) + tag + data + struct.pack(\"!I\", zlib.crc32(tag + data) & 0xffffffff)\n    ihdr = struct.pack(\"!IIBBBBB\", size, size, 8, 6, 0, 0, 0)\n    png = b\"\\x89PNG\\r\\n\\x1a\\n\" + chunk(b\"IHDR\", ihdr) + chunk(b\"IDAT\", zlib.compress(bytes(raw), 6)) + chunk(b\"IEND\", b\"\")\n    with open(path, \"wb\") as f:\n        f.write(png)\n\nmake_png(\"public/pwa-192x192.png\", 192, False)\nmake_png(\"public/pwa-512x512.png\", 512, False)\nmake_png(\"public/pwa-maskable-512x512.png\", 512, True)\nmake_png(\"public/apple-touch-icon.png\", 180, False)\nprint(\"Generated PNG icons successfully\")\n\' && ls -lh public/*.png public/icon.svg"
