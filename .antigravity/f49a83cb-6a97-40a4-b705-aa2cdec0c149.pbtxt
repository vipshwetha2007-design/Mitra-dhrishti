age.\',\\n      createdAt: \'2026-11-21T10:20:00Z\',\\n      read: false,\\n      actionView: \'protect\',\\n    },\\n    {\\n      id: \'not-2\',\\n      roleTargets: [\'patient\', \'doctor\'],\\n      patientId: \'pat-1\',\\n      severity: \'info\',\\n      title: \'Upcoming Follow-up Consultation\',\\n      message: \'Follow-up consultation confirmed for 28 Nov at 10:30 AM \302\267 Adyar Urban PHC / City Hospital.\',\\n      createdAt: \'2026-11-21T16:00:00Z\',\\n      read: false,\\n      actionView: \'appointments\',\\n    },\\n    {\\n      id: \'not-3\',\\n      roleTargets: [\'patient\', \'doctor\', \'admin\'],\\n      patientId: \'pat-1\',\\n      severity: \'success\',\\n      title: \'Offline Sync Ready\',\\n      message: \'IndexedDB offline queue is initialized and synchronized with backend records.\',\\n      createdAt: \'2026-11-22T01:00:00Z\',\\n      read: false,\\n      actionView: \'offline\',\\n    },\\n    {\\n      id: \'not-4\',\\n      roleTargets: [\'doctor\', \'admin\'],\\n      patientId: \'pat-3\',\\n      severity: \'warning\',\\n      title: \'Missed Lab Appointment Escalated\',\\n      message: \'Lakshmi Narayanan missed 19 Nov HbA1c test; VHN phone follow-up assigned.\',\\n      createdAt: \'2026-11-20T12:30:00Z\',\\n      read: false,\\n      actionView: \'protect\',\\n    },\\n  ];\\n\\n  const districtResources: DistrictResourceMetric[] = [\\n    {\\n      id: \'res-1\',\\n      facilityName: \'Adyar Urban PHC\',\\n      type: \'PHC\',\\n      fundusCameras: 2,\\n      ophthalmologists: 0,\\n      healthWorkers: 6,\\n      dailyCapacity: 45,\\n      currentUtilizationPct: 76,\\n      connectivityProfile: \'Stable Broadband\',\\n    },\\n    {\\n      id: \'res-2\',\\n      facilityName: \'Sriperumbudur Block PHC\',\\n      type: \'PHC\',\\n      fundusCameras: 1,\\n      ophthalmologists: 0,\\n      healthWorkers: 5,\\n      dailyCapacity: 30,\\n      currentUtilizationPct: 88,\\n      connectivityProfile: \'Offline-First Rural\',\\n    },\\n    {\\n      id: \'res-3\',\\n      facilityName: \'Tambaram Taluk Hospital\',\\n      type: \'District Hospital\',\\n      fundusCameras: 2,\\n      ophthalmologists: 2,\\n      healthWorkers: 9,\\n      dailyCapacity: 55,\\n      currentUtilizationPct: 71,\\n      connectivityProfile: \'Stable Broadband\',\\n    },\\n    {\\n      id: \'res-4\',\\n      facilityName: \'Chengalpattu Mobile Eye Van #1\',\\n      type: \'Mobile Screening Unit\',\\n      fundusCameras: 1,\\n      ophthalmologists: 1,\\n      healthWorkers: 4,\\n      dailyCapacity: 25,\\n      currentUtilizationPct: 82,\\n      connectivityProfile: \'Intermittent 4G\',\\n    },\\n  ];\\n\\n  const auditLogs: AuditLogEntry[] = [\\n    {\\n      id: \'aud-1\',\\n      timestamp: \'2026-11-16T14:20:00Z\',\\n      userId: \'usr-doctor-1\',\\n      userName: \'Dr. Arvind Raman\',\\n      role: \'doctor\',\\n      action: \'DOCTOR_REVIEW_SUBMITTED\',\\n      resourceType: \'RetinalScreening\',\\n      resourceId: \'scr-1\',\\n      outcome: \'SUCCESS\',\\n      details: \'Confirmed ICDR Grade 0 screening assist and set Routine 12-month triage.\',\\n    },\\n    {\\n      id: \'aud-2\',\\n      timestamp: \'2026-11-21T10:15:00Z\',\\n      userId: \'usr-doctor-1\',\\n      userName: \'Dr. Arvind Raman\',\\n      role: \'doctor\',\\n      action: \'RETINAL_SCREENING_CREATED\',\\n      resourceType: \'RetinalScreening\',\\n      resourceId: \'scr-2\',\\n      outcome: \'SUCCESS\',\\n      details: \'Uploaded gradable fundus capture for pat-2 (synthetic demo); pending clinical review.\',\\n    },\\n    {\\n      id: \'aud-3\',\\n      timestamp: \'2026-11-21T12:00:00Z\',\\n      userId: \'usr-doctor-1\',\\n      userName: \'Dr. Arvind Raman\',\\n      role: \'doctor\',\\n      action: \'REFERRAL_CREATED\',\\n      resourceType: \'Referral\',\\n      resourceId: \'ref-1\',\\n      outcome: \'SUCCESS\',\\n      details: \'Generated Priority Ophthalmology referral to RIO Egmore.\',\\n    },\\n  ];\\n\\n  return {\\n    users,\\n    patients,\\n    assessments,\\n    labs,\\n    programmes,\\n    habitLogs,\\n    interventions,\\n    screenings,\\n    doctorReviews,\\n    referrals,\\n    appointments,\\n    followUps,\\n    notifications,\\n    districtResources,\\n    simulations: buildDefaultSimulinkScenarios(),\\n    auditLogs,\\n    processedIdempotencyKeys: {},\\n  };\\n}\\n\\nclass MritidhristiStore {\\n  private db: PersistentDatabase;\\n  private sessions = new Map<string, SessionRecord>();\\n\\n  constructor() {\\n    this.db = this.load();\\n  }\\n\\n  private load(): PersistentDatabase {\\n    try {\\n      if (fs.existsSync(STORE_PATH)) {\\n        const raw = fs.readFileSync(STORE_PATH, \'utf-8\');\\n        const parsed = JSON.parse(raw) as PersistentDatabase;\\n        if (parsed && Array.isArray(parsed.users) && Array.isArray(parsed.patients)) {\\n          return parsed;\\n        }\\n      }\\n    } catch (err) {\\n      console.error(\'Failed to read local store, re-seeding synthetic dataset:\', err);\\n    }\\n    const seeded = createSyntheticSeedData();\\n    this.persist(seeded);\\n    return seeded;\\n  }\\n\\n  public persist(snapshot?: PersistentDatabase) {\\n    const data = snapshot ?? this.db;\\n    try {\\n      if (!fs.existsSync(DATA_DIR)) {\\n        fs.mkdirSync(DATA_DIR, { recursive: true });\\n      }\\n      fs.writeFileSync(STORE_PATH, JSON.stringify(data, null, 2), \'utf-8\');\\n    } catch (err) {\\n      console.error(\'Failed to persist local store:\', err);\\n    }\\n  }\\n\\n  public get data(): PersistentDatabase {\\n    return this.db;\\n  }\\n\\n  public createSession(user: StoredUser): SessionRecord {\\n    const token = crypto.randomBytes(32).toString(\'hex\');\\n    const now = Date.now();\\n    const record: SessionRecord = {\\n      token,\\n      userId: user.id,\\n      role: user.role,\\n      createdAt: now,\\n      expiresAt: now + SESSION_TTL_MS,\\n    };\\n    this.sessions.set(token, record);\\n    return record;\\n  }\\n\\n  public getSession(token: string): { session: SessionRecord; user: StoredUser } | null {\\n    const session = this.sessions.get(token);\\n    if (!session) return null;\\n    if (Date.now() > session.expiresAt) {\\n      this.sessions.delete(token);\\n      return null;\\n    }\\n    const user = this.db.users.find((u) => u.id === session.userId);\\n    if (!user) return null;\\n    return { session, user };\\n  }\\n\\n  public revokeSession(token: string) {\\n    this.sessions.delete(token);\\n  }\\n\\n  public sanitizeUser(user: StoredUser): UserAccount {\\n    return {\\n      id: user.id,\\n      email: user.email,\\n      name: user.name,\\n      role: user.role,\\n      title: user.title,\\n      facility: user.facility,\\n      patientId: user.patientId,\\n      language: user.language,\\n      isSynthetic: user.isSynthetic,\\n    };\\n  }\\n\\n  public appendAudit(entry: Omit<AuditLogEntry, \'id\' | \'timestamp\'>) {\\n    const full: AuditLogEntry = {\\n      id: `aud-${Date.now()}-${crypto.randomBytes(3).toString(\'hex\')}`,\\n      timestamp: new Date().toISOString(),\\n      ...entry,\\n    };\\n    this.db.auditLogs.unshift(full);\\n    if (this.db.auditLogs.length > 250) {\\n      this.db.auditLogs.length = 250;\\n    }\\n    this.persist();\\n    return full;\\n  }\\n}\\n\\nexport const store = new MritidhristiStore();\\n\", \"Description\":\"Implement persistent server store with scrypt password hashing, session TTL management, synthetic dataset seeding, and immutable audit trail logging\", \"Overwrite\":true, \"TargetFile\":\"/server/store.ts\", \"toolAction\":\"Creating backend store and seed data\", \"toolSummary\":\"Create server/store.ts\"}"
      thinking_signature: "\022\233\031\n\230\031\001i\024}\023\274\002\307\006k\"\036(v\240_\250\020\220\2227\002\n\201=\3138\001\344\337I\364C\200A\271\2042Ui\032Q\036h\222\t\357M:r5\353\251\211\210Jgz\344X\024\022c\224TXS\231(;Q\251\220\262:\004b4L\322\034\235\363C\303 \276\244\372\211\332\350_\001\n\331IH\212\331&.F\304%\273\240\350\2047\2158\\cJ\343\202K;\212\257\350R\016\326\tt\201\250_\221cW\n\\Q\335\224U`\244p(\315\252Rz\004\026\031H\247\271\350\243\331\037\277\226\231\254\324\245R\237\a$\345\362\307\262\361R\345a\304N\375\362\221\202_\253\255o/r\002WG\000Ub$\303\030\312\317\333\227\305\205ej,\202\346Q\341\264Ad\237,\316\232\256\325\277\220\310\377\0026Z*\205\330\345|\313M\005\316\202\212\254\301+\224\021\331\256l\357\367\200\306P\3175\236\277T\276d0\302BlX4h\305)\375\022\370\316\025\323O\340K\027\330\373~\274z\327\324\003E\a\tB\023RV\211\202\t\334j\ti\017\001\363\356\367\261L\001\314\334\205@5\240\225\363YG\273u\001\361aX0\027}\032!\aM^r\240$\254\335\vf\267T:8\356|!\317\232\021\2131\217`\363\t\320\265p\266{\306\004\267_Q\250\267(0\365T4\254\340\250\036\037\353\v5\344\223\004@\300S\221\354>\233$\316:\t$\3457\271\370?\252\323\3657,\342%\216iv\232\373A1\376){\201\006fy?\315\364\202\351\226I\213M\267\211\255Q\356\313\031\346\326\333o\023aA\377\343sP\216f[W\251\r\377\r)3\371\r2Y\360=\361\3603\220`)\3548\220\265w\026\027\217\310d_hl\200 x\024\204a\241@\377\206\213\033\273%0\226F\356\340\247rH\023\333\213\360\254\324\366,!\3126l~\375U\204\377}\035\313\361\016\333\263\251\366\017]\256Z\310\376\036\220TQ\"\037X;`d\034\312\243N\346\343\321g\261m\336B\273\313\355\323\016\346f\025\377\263\336<\237B\313\301r\253Q\221]\006\325\225\273\354E\374\320$\366\310`\306\255w8\346\207\317G\333TV\353\326\360\2126\361ZL\356`\333\234N9c0\270\276\305\231\343c\334a\\\377\2673\367\026\006\f\310\325\210y\003\257\003ks\004\033)!O\336\335h^\320ZS\021R\325]~\231\020V\207<wdmK\200\021]\r\330\"\000\231\205\2469P\341\\\0353\025\362\230_\0278p\030\026\203\310\230\277\366\270HDB\177\244\314\201\