            lines {
              text: "  if (!header || !header.startsWith(\'Bearer \')) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    res.status(401).json({ error: \'Authentication required. Please sign in.\' });"
