277\340\244\202\340\244\227\340\245\215\340\244\270\',\\n    },\\n    topbar: {\\n      searchPlaceholder: \'\340\244\260\340\245\213\340\244\227\340\245\200, \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\257\340\244\276 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202...\',\\n      online: \'\340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250\',\\n      offline: \'\340\244\221\340\244\253\340\244\274\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\256\340\245\213\340\244\241\',\\n      syncPending: \'\340\244\270\340\244\277\340\244\202\340\244\225 \340\244\262\340\244\202\340\244\254\340\244\277\340\244\244\',\\n      switchRole: \'\340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276 \340\244\254\340\244\246\340\244\262\340\245\207\340\244\202\',\\n      signIn: \'\340\244\270\340\244\276\340\244\207\340\244\250 \340\244\207\340\244\250\',\\n    },\\n    hero: {\\n      welcomeBack: \'\340\244\265\340\244\276\340\244\252\340\244\270\340\245\200 \340\244\252\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\227\340\244\244 \340\244\271\340\245\210\',\\n      subtitle: \'\340\244\206\340\244\252\340\244\225\340\244\276 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\270\340\245\215\340\244\245\340\245\215\340\244\257\340\245\244 \340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225\340\244\244\340\244\276\340\245\244\',\\n      tagline: \'\340\244\256\340\244\247\340\245\201\340\244\256\340\245\207\340\244\271 \340\244\234\340\245\213\340\244\226\340\244\277\340\244\256 \340\244\260\340\245\213\340\244\225\340\245\207\340\244\202\340\245\244 \340\244\260\340\245\207\340\244\237\340\244\277\340\244\250\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250\340\244\277\340\244\202\340\244\227 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\260\340\245\215\340\244\245\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244 \340\244\250\340\244\277\340\244\260\340\244\202\340\244\244\340\244\260 \340\244\246\340\245\207\340\244\226\340\244\255\340\244\276\340\244\262 \340\244\270\340\245\201\340\244\250\340\244\277\340\244\266\340\245\215\340\244\232\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\\n      exploreCta: \'\340\244\270\340\245\215\340\244\265\340\244\276\340\244\270\340\245\215\340\244\245\340\245\215\340\244\257 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\',\\n    },\\n    pillars: {\\n      preventTitle: \'PREVENT (\340\244\260\340\245\213\340\244\225\340\244\245\340\244\276\340\244\256)\',\\n      preventDesc: \'\340\244\256\340\244\247\340\245\201\340\244\256\340\245\207\340\244\271 \340\244\234\340\245\213\340\244\226\340\244\277\340\244\256 \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250\',\\n      detectTitle: \'DETECT (\340\244\252\340\244\271\340\244\232\340\244\276\340\244\250)\',\\n      detectDesc: \'AI-\340\244\270\340\244\271\340\244\276\340\244\257\340\244\244\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\252\340\245\215\340\244\244 \340\244\260\340\245\207\340\244\237\340\244\277\340\244\250\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250\340\244\277\340\244\202\340\244\227\',\\n      protectTitle: \'PROTECT (\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276)\',\\n      protectDesc: \'\340\244\241\340\245\211\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\224\340\244\260 \340\244\253\340\245\211\340\244\262\340\245\213-\340\244\205\340\244\252\',\\n    },\\n  },\\n};\\n\", \"Description\":\"Create English and Tamil translations with Hindi architecture scaffold ready\", \"Overwrite\":true, \"TargetFile\":\"/src/i18n/translations.ts\", \"toolAction\":\"Creating bilingual EN/TA/HI translations\", \"toolSummary\":\"Create src/i18n/translations.ts\"}"
