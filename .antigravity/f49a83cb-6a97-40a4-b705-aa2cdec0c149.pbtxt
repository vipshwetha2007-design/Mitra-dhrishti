              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const resolved = store.getSession(token);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!resolved) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    res.status(401).json({ error: \'Session expired or invalid. Please sign in again.\' });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  req.authUser = resolved.user;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  req.authToken = token;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  next();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
