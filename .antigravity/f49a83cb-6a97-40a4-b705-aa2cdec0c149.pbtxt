1i\035\fC\312\f0\271!\fX\375\341\224\243(\211y~\333]\337\t\362M\222\223qU\330\214/\001\003)\341\313\v\233\2143\342\220,/\203P\370r\371\'kx\242/e\207\230\aw\361\030\312\030\372c\004\202\336\301F.\325\324\3258\226s\0375\3011P\272q\357\372\346\375.\203_\320\361\227W\035\361RA+\361\210\310\213\274E\336Y\222\321\030\306\253\200B\205n*Yr\3416K\t\216\307\031mJ\341\034\356\352\033i\341\020\372\33625\337\230\316v\031O|\267\022xc\261\266\2161\304\345(Y\366B\324?P\vo\245\336\321\017FZ\356\337D\271\244vA0\016\226o\2019\352\240\265\202G\243)\033\035w\377\350bE:a\001\366S)\332\221\241\306uU\311Rj\027\257K\215{=\351\234\310\255M?\376\2628\351h\313\315\347R_p\v\355:\"\3313A\207\037\334\271\351\316^m\310+\316\242\376\204n\263h\027`5\215O\243\206\234\344T\204$\212Z\303\365a)\211Q\214\fr\'^\223+.\370!\245\275\323\272\016\3670\203\247\335\363\277\303\342\022aO\323c\031\032\244~\020\203\301\217\267,S\314=\270\276\037\'\376\037\355\221H\204=\240\r\240\375-\034\225\325\310\250\035\n\200\033\312\376uu\330&(\336\321\374\254\374\031\351\371q\025\367AoQ\005u\351\250\232\317Pu\264G\315G\345u\362\2655Q\371G\003\341\312$\022\a\213\031\231\340\227\242n\260\221|\320\036\260\276\304\311\330\036_e\375\3553\274~uJx4\3147O\231\023\334\240l\3244\357\2328A\027\315\377<Q<\200\204.h]\220\370\200\254\264s\377\316\311\366\247\205\"\322\030w\243+\362@\021\206I\363Xp\265\220\266H\244\326\255em\373\226\331|\310\207\256-*\356IY\236-\334/\361O\331\242o\204\031\362W\326\360.\0042\227\354\327dREnH\273\223\270=\321\215\250\347L\265[Z\236sVW9\300\217\004\221e\371\27707\3733\331\245\230\267q\0178\'\204\222\343\247\267,\355\336\261\023\300o-\360\307H\363g\364\231\341\224:\016\376\202\205;\246\253\276F*\264\227Zk\326\'#\"\a\\\023\304\272l\353L\304\036\350y\271\244\r6\023K\314\2218Z\227\2750\rD\031\241\230\331\233\005\023\274\337i\343\365\353\266\341\034\364pF{\320\304\006\232I\353\373\210\021Rcg\334?(\277\202\036?\243\203b\004\202\347\026\004Q\217\306\333\321g\255\035\251M\223\2410\222ve?D\034A\206F\266r\302\256\230\221^;s\031\305/r\235\003\202\206T\254\3450\035\345\355q+\315N\355BKIR&\213\032^\202\354C\314q\254\a\305\340yK\337~\357BY\223\330\271\370\315\371\365_\266\2616\202h\265\"\024\347\201r\360\0265B\255=\211\001p\311\331\254Au\005B\030^\360\306\327\n\017\307\346\207\315\306\'\037\335\246\211\263\324N\246h\200\005\025\320g/i\237\262\205"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12869043348055998057"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport {\\n  AlertTriangle,\\n  CalendarClock,\\n  CheckCircle2,\\n  Eye,\\n  Send,\\n  Stethoscope,\\n  Users,\\n} from \'lucide-react\';\\nimport type { AppNavView, BootstrapPayload } from \'../types/domain\';\\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\\n\\ninterface DoctorDashboardProps {\\n  data: BootstrapPayload;\\n  searchQuery: string;\\n  onNavigate: (view: AppNavView, selectedPatientId?: string) => void;\\n}\\n\\nexport const DoctorDashboard: React.FC<DoctorDashboardProps> = ({\\n  data,\\n  searchQuery,\\n  onNavigate,\\n}) => {\\n  const pendingScreenings = data.screenings.filter(\\n    (s) => s.humanReviewStatus === \'pending_review\' || s.humanReviewStatus === \'recapture_requested\'\\n  );\\n  const openReferrals = data.referrals.filter((r) => r.status === \'Pending\' || r.status === \'Accepted\');\\n  const missedAppointments = data.appointments.filter((a) => a.status === \'Missed\');\\n  const activeEscalations = data.followUps.filter((f) => f.status === \'Escalated\');\\n\\n  const q = searchQuery.trim().toLowerCase();\\n  const filteredPatients = data.patients.filter(\\n    (p) =>\\n      !q ||\\n      p.name.toLowerCase().includes(q) ||\\n      p.mrn.toLowerCase().includes(q) ||\\n      p.district.toLowerCase().includes(q)\\n  );\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Clinician Header Banner */}\\n      <section className=\\\"rounded-2xl border border-slate-200 bg-gradient-to-r from-[#0B2540] to-[#0F4C5C] p-6 text-white\\\">\\n        <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-medium text-teal-200\\\">\\n              Clinician &amp; Healthcare Worker Workspace \302\267 {data.user.facility || \'District Care Network\'}\\n            </p>\\n            <h1 className=\\\"mt-1 font-display text-2xl font-bold tracking-tight\\\">\\n              Welcome, {data.user.name}\\n            </h1>\\n            <p className=\\\"mt-1 text-sm text-slate-200 max-w-2xl\\\">\\n              Review AI-assisted retinal screenings, validate Grad-CAM explanations, record laboratory HbA1c/FPG values, and coordinate ophthalmology referrals.\\n            </p>\\n          </div>\\n          <div className=\\\"flex flex-wrap gap-2.5 shrink-0\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'protect\')}\\n              className=\\\"rounded-xl bg-[#0D9488] px-4 py-2.5 text-xs font-semibold text-white hover:bg-[#14B8A6] transition-colors whitespace-nowrap\\\"\\n            >\\n              Open Clinical Review Queue ({pendingScreenings.length})\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'detect\')}\\n              className=\\\"rounded-xl border border-white/25 bg-white/10 px-4 py-2.5 text-xs font-semibold text-white hover:bg-white/20 transition-colors whitespace-nowrap\\\"\\n            >\\n              New Retinal Screening\\n            </button>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* 4 KPI Summary Strip */}\\n      <section className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Assigned Cohort</span>\\n            <Users className=\\\"h-4 w-4 text-[#0D9488]\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {data.patients.length}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-slate-500\\\">\\n            {data.patients.filter((p) => p.diabetesStatus === \'diagnosed_t2d\').length} eligible for retinal screening\\n          </div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Unreviewed Screenings</span>\\n            <Eye className=\\\"h-4 w-4 text-rose-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-rose-700 tabular-nums\\\">\\n            {pendingScreenings.length}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-slate-500\\\">\\n            Mandatory physician confirmation required\\n          </div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Active Referrals</span>\\n            <Send className=\\\"h-4 w-4 text-sky-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {openReferrals.length}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-slate-500\\\">\\n            {data.referrals.filter((r) => r.status === \'Completed\').length} completed with specialist feedback\\n          </div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Missed / Escalated</span>\\n            <CalendarClock className=\\\"h-4 w-4 text-amber-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-amber-700 tabular-nums\\\">\\n            {missedAppointments.length + activeEscalations.length}\\n          </div>\\n          <div className=\\\"mt-1 text-xs text-slate-500\\\">\\n            {missedAppointments.length} missed appointments \302\267 {activeEscalations.length} VHN escalations\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Pending Clinical Review Cards */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n        <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between mb-4\\\">\\n            <div>\\n              <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                Retinal Screenings Requiring Doctor Review\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                AI outputs are screening assistance only \342\200\224 confirm, modify, or request recapture.\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'protect\')}\\n              className=\\\"text-xs font-semibold text-[#0D9488] hover:underline\\\"\\n            >\\n              Open Protect \342\206\222\\n            </button>\\n          </div>\\n\\n          {pendingScreenings.length === 0 ? (\\n            <div className=\\\"rounded-xl border border-emerald-200 bg-emerald-50/50 p-6 text-center\\\">\\n              <CheckCircle2 className=\\\"mx-auto h-7 w-7 text-emerald-600\\\" />\\n              <div className=\\\"mt-2 text-sm font-semibold text-slate-900\\\">\\n                All retinal screenings reviewed\\n              </div>\\n              <p className=\\\"mt-1 text-xs text-slate-600\\\">\\n                No unreviewed AI-assisted findings remain in your queue.\\n              </p>\\n            </div>\\n          ) : (\\n            <div className=\\\"space-y-3\\\">\\n              {pendingScreenings.map((scr) => {\\n                const pat = data.patients.find((p) => p.id === scr.patientId);\\n                return (\\n                  <div\\n                    key={scr.id}\\n                    className=\\\"flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-xl border border-slate-200 p-3.5 hover:bg-slate-50/80 transition-colors\\\"\\n                  >\\n                    <FundusVisualizer\\n                      preset={scr.imagePreset}\\n                      imageDataUrl={scr.imageDataUrl}\\n                      stage=\\\"gradcam\\\"\\n                      hotspots={scr.gradCam.hotspots}\\n                      size={112}\\n                      className=\\\"h-24 w-24 shrink-0\\\"\\n                    />\\n                    <div className=\\\"min-w-0 flex-1\\\">\\n                      <div className=\\\"flex flex-wrap items-center gap-2 text-xs text-slate-500\\\">\\n                        <span className=\\\"font-semibold text-slate-900 text-sm\\\">\\n                          {pat?.name || scr.patientId}\\n                        </span>\\n                        <span>\302\267</span>\\n                        <span className=\\\"font-mono\\\">{pat?.mrn}</span>\\n                        <span>\302\267</span>\\n                        <span>{scr.eye}</span>\\n                      </div>\\n                      <div className=\\\"mt-1 text-xs font-semibold text-rose-700\\\">\\n                        {scr.modelPrediction.gradeLabel}\\n                      </div>\\n                      <p className=\\\"mt-1 text-xs text-slate-600 line-clamp-2\\\">{scr.summaryText}</p>\\n                    </div>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onNavigate(\'protect\', scr.patientId)}\\n                      className=\\\"shrink-0 rounded-lg bg-[#0B2540] px-3.5 py-2 text-xs font-semibold text-white hover:bg-[#113556]\\\"\\n                    >\\n                      Review Case\\n                    </button>\\n                  </div>\\n                );\\n              })}\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Missed Appointments & Escalations */}\\n        <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between mb-4\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Follow-up Escalations &amp; Missed Visits\\n            </h2>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'appointments\')}\\n              className=\\\"text-xs font-semibold text-[#0D9488] hover:underline\\\"\\n            >\\n              Manage \342\206\222\\n            </button>\\n          </div>\\n          <div className=\\\"space-y-3\\\">\\n            {missedAppointments.map((apt) => {\\n              const pat = data.patients.find((p) => p.id === apt.patientId);\\n              return (\\n                <div\\n                  key={apt.id}\\n                  className=\\\"rounded-xl border border-amber-200 bg-amber-50/60 p-3.5\\\"\\n                >\\n                  <div className=\\\"flex items-center gap-2 text-xs font-semibold text-amber-900\\\">\\n                    <AlertTriangle className=\\\"h-4 w-4 text-amber-600 shrink-0\\\" />\\n                    <span>Missed: {apt.title}</span>\\n                  </div>\\n                  <div className=\\\"mt-1 text-xs text-slate-700\\\">\\n                    {pat?.name} ({pat?.mrn}) \302\267 Scheduled {apt.scheduledDate}\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => onNavigate(\'protect\', apt.patientId)}\\n                    className=\\\"mt-2 text-xs font-semibold text-[#0B2540] hover:underline\\\"\\n                  >\\n                    Open patient continuity record \342\206\222\\n                  </button>\\n                </div>\\n              );\\n            })}\\n\\n            {data.interventions\\n              .filter((i) => i.status !== \'resolved\')\\n              .slice(0, 3)\\n              .map((intv) => {\\n                const pat = data.patients.find((p) => p.id === intv.patientId);\\n                return (\\n                  <div\\n                    key={intv.id}\\n                    className=\\\"rounded-xl border border-slate-200 bg-slate-50/70 p-3.5\\\"\\n                  >\\n                    <div className=\\\"text-xs font-semibold text-slate-900\\\">\\n                      Adaptive Ladder Step {intv.ladderStep} \302\267 {pat?.name}\\n                    </div>\\n                    <p className=\\\"mt-1 text-xs text-slate-600\\\">{intv.recommendedMessage}</p>\\n                  </div>\\n                );\\n              })}\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Shared Patient Cohort Table */}\\n      <section className=\\\"rounded-2xl border border-slate-200 bg-white overflow-hidden\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 px-5 py-4\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Shared Patient Registry (Prevent \302\267 Detect \302\267 Protect)\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              All three pillars read and write to unified longitudinal patient records.\\n            </p>\\n          </div>\\n          <span className=\\\"text-xs font-mono text-slate-500 tabular-nums\\\">\\n            Showing {filteredPatients.length} of {data.patients.length} patient(s)\\n          </span>\\n        </div>\\n\\n        <div className=\\\"overflow-x-auto\\\">\\n          <table className=\\\"w-full text-left text-xs\\\">\\n            <thead className=\\\"bg-slate-50 text-slate-600 border-b border-slate-200\\\">\\n              <tr>\\n                <th className=\\\"px-5 py-3 font-semibold\\\">Patient / MRN</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Clinical Status</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Latest Risk Score</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Latest Lab (HbA1c / FPG)</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Retinal Review</th>\\n                <th className=\\\"px-5 py-3 font-semibold text-right\\\">Action</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-100\\\">\\n              {filteredPatients.map((pat) => {\\n                const asm = data.assessments.find((a) => a.patientId === pat.id);\\n                const lab = data.labs.find((l) => l.patientId === pat.id);\\n                const scr = data.screenings.find((s) => s.patientId === pat.id);\\n                return (\\n                  <tr key={pat.id} className=\\\"hover:bg-slate-50/80 transition-colors\\\">\\n                    <td className=\\\"px-5 py-3.5\\\">\\n                      <div className=\\\"font-semibold text-slate-900\\\">{pat.name}</div>\\n                      <div className=\\\"font-mono text-[11px] text-slate-500\\\">\\n                        {pat.mrn} \302\267 {pat.age}y {pat.sex} \302\267 {pat.district}\\n                      </div>\\n                    </td>\\n                    <td className=\\\"px-4 py-3.5 text-slate-700\\\">\\n                      {pat.diabetesStatus === \'diagnosed_t2d\'\\n                        ? \'Diagnosed Type 2 Diabetes\'\\n                        : pat.diabetesStatus === \'prediabetes_lab\'\\n                        ? \'Prediabetes (Lab Confirmed)\'\\n                        : \'Lifestyle Prevention\'}\\n                    </td>\\n                    <td className=\\\"px-4 py-3.5 font-mono tabular-nums text-slate-800\\\">\\n                      {asm ? `${asm.experimentalScore}/100 (${asm.riskCategory})` : \'Not assessed\'}\\n                    </td>\\n                    <td className=\\\"px-4 py-3.5 font-mono tabular-nums text-slate-800\\\">\\n                      {lab\\n                        ? `${lab.hba1cPercent ?? \'\342\200\224\'}% / ${lab.fastingGlucoseMgDl ?? \'\342\200\224\'} mg/dL`\\n                        : \'Pending lab\'}\\n                    </td>\\n                    <td className=\\\"px-4 py-3.5\\\">\\n                      {scr ? (\\n                        <span\\n                          className={`font-semibold ${\\n                            scr.humanReviewStatus === \'confirmed\'\\n                              ? \'text-emerald-700\'\\n                              : \'text-amber-700\'\\n                          }`}\\n                        >\\n                          {scr.humanReviewStatus.replace(\'_\', \' \')}\\n                        </span>\\n                      ) : (\\n                        <span className=\\\"text-slate-400\\\">Not screened</span>\\n                      )}\\n                    </td>\\n                    <td className=\\\"px-5 py-3.5 text-right\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => onNavigate(\'protect\', pat.id)}\\n                        className=\\\"inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-[#0B2540] hover:bg-slate-100\\\"\\n                      >\\n                        <Stethoscope className=\\\"h-3.5 w-3.5 text-[#0D9488]\\\" />\\n                        Open Chart\\n                      </button>\\n                    </td>\\n                  </tr>\\n                );\\n              })}\\n            </tbody>\\n          </table>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DoctorDashboard with unreviewed retinal screenings, missed appointment escalations, and shared longitudinal patient cohort table\", \"Overwrite\":true, \"TargetFile\":\"/src/views/DoctorDashboard.tsx\", \"toolAction\":\"Creating DoctorDashboard view\", \"toolSummary\":\"Create src/views/DoctorDashboard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12869043348055994790"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport {\\n  BarChart3,\\n  Building2,\\n  Cpu,\\n  FileWarning,\\n  ShieldCheck,\\n  Users,\\n} from \'lucide-react\';\\nimport {\\n  Bar,\\n  BarChart,\\n  CartesianGrid,\\n  Legend,\\n  ResponsiveContainer,\\n  Tooltip,\\n  XAxis,\\n  YAxis,\\n} from \'recharts\';\\nimport type { AppNavView, BootstrapPayload } from \'../types/domain\';\\n\\ninterface AdminDashboardProps {\\n  data: BootstrapPayload;\\n  onNavigate: (view: AppNavView) => void;\\n}\\n\\nexport const AdminDashboard: React.FC<AdminDashboardProps> = ({ data, onNavigate }) => {\\n  const totalScreenings = data.screenings.length;\\n  const ungradableCount = data.screenings.filter((s) => !s.quality.gradable).length;\\n  const rejectionRate =\\n    totalScreenings > 0 ? Math.round((ungradableCount / totalScreenings) * 100) : 0;\\n\\n  const avgSimWait =\\n    data.simulations.length > 0\\n      ? Math.round(\\n          data.simulations.reduce((acc, s) => acc + s.avgWaitTimeMinutes, 0) /\\n            data.simulations.length\\n        )\\n      : 0;\\n\\n  const scenarioChartData = data.simulations.slice(0, 6).map((s) => ({\\n    name: s.name.replace(/^\\\\d+\\\\.\\\\s*/, \'\'),\\n    waitMinutes: s.avgWaitTimeMinutes,\\n    queueLength: s.avgQueueLength,\\n    utilization: s.resourceUtilizationPct,\\n  }));\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Admin Hero */}\\n      <section className=\\\"rounded-2xl border border-slate-200 bg-gradient-to-r from-[#071D33] to-[#124E78] p-6 text-white\\\">\\n        <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-medium text-teal-200\\\">\\n              District Health Programme Oversight \302\267 {data.user.facility || \'District Administration\'}\\n            </p>\\n            <h1 className=\\\"mt-1 font-display text-2xl font-bold tracking-tight\\\">\\n              District Analytics &amp; Resource Capacity\\n            </h1>\\n            <p className=\\\"mt-1 text-sm text-slate-200 max-w-2xl\\\">\\n              Monitor live application records across PHCs and compare district capacity scenarios modeled for MATLAB Simulink integration.\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onNavigate(\'simulink\')}\\n            className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#0D9488] px-4 py-2.5 text-xs font-semibold text-white hover:bg-[#14B8A6] transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            <Cpu className=\\\"h-4 w-4\\\" />\\n            Open Simulink 6-Scenario Planner\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* Data Provenance Transparency Banner */}\\n      <div className=\\\"rounded-xl border border-sky-200 bg-sky-50/70 px-4 py-3 text-xs text-sky-950 flex flex-wrap items-center justify-between gap-2\\\">\\n        <span>\\n          <strong>Data Provenance:</strong> Operational counters below combine{\' \'}\\n          <span className=\\\"font-semibold\\\">\\n            {data.patients.filter((p) => !p.isSynthetic).length} live session record(s)\\n          </span>{\' \'}\\n          and{\' \'}\\n          <span className=\\\"font-semibold\\\">\\n            {data.patients.filter((p) => p.isSynthetic).length} synthetic prototype record(s)\\n          </span>\\n          . Simulation charts use explicitly labelled illustrative queueing outputs unless a MATLAB Simulink CSV is imported.\\n        </span>\\n      </div>\\n\\n      {/* KPI Strip */}\\n      <section className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\\\">\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Registered Patients</span>\\n            <Users className=\\\"h-4 w-4 text-[#0D9488]\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {data.patients.length}\\n          </div>\\n          <div className=\\\"mt-1 text-[11px] text-slate-500\\\">Shared 3-pillar cohort</div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Assessments Done</span>\\n            <BarChart3 className=\\\"h-4 w-4 text-emerald-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {data.assessments.length}\\n          </div>\\n          <div className=\\\"mt-1 text-[11px] text-slate-500\\\">Prevent lifestyle scores</div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Retinal Screenings</span>\\n            <Building2 className=\\\"h-4 w-4 text-sky-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {totalScreenings}\\n          </div>\\n          <div className=\\\"mt-1 text-[11px] text-slate-500\\\">\\n            {data.doctorReviews.length} doctor-reviewed\\n          </div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Quality Rejection</span>\\n            <FileWarning className=\\\"h-4 w-4 text-amber-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {rejectionRate}%\\n          </div>\\n          <div className=\\\"mt-1 text-[11px] text-slate-500\\\">\\n            {ungradableCount} ungradable capture(s)\\n          </div>\\n        </div>\\n\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4\\\">\\n          <div className=\\\"flex items-center justify-between text-slate-500\\\">\\n            <span className=\\\"text-xs font-semibold\\\">Avg Sim Wait Time</span>\\n            <Cpu className=\\\"h-4 w-4 text-indigo-600\\\" />\\n          </div>\\n          <div className=\\\"mt-2 font-display text-2xl font-bold text-[#0B2540] tabular-nums\\\">\\n            {avgSimWait} min\\n          </div>\\n          <div className=\\\"mt-1 text-[11px] text-slate-500\\\">Across 6 scenarios</div>\\n        </div>\\n      </section>\\n\\n      {/* Two Charts Row */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-5\\\">\\n        {/* Facility Utilization Chart */}\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"mb-4\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              District Facility Resource Utilization\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Daily screening capacity vs. current utilization percentage across PHCs and mobile units\\n            </p>\\n          </div>\\n          <div className=\\\"h-64 w-full\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={data.districtResources} margin={{ top: 8, right: 12, left: -16, bottom: 8 }}>\\n                <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E2E8F0\\\" />\\n                <XAxis dataKey=\\\"facilityName\\\" tick={{ fontSize: 11, fill: \'#475569\' }} />\\n                <YAxis tick={{ fontSize: 11, fill: \'#475569\' }} />\\n                <Tooltip contentStyle={{ borderRadius: \'10px\', fontSize: \'12px\' }} />\\n                <Legend wrapperStyle={{ fontSize: \'11px\' }} />\\n                <Bar dataKey=\\\"dailyCapacity\\\" name=\\\"Daily Capacity (Patients)\\\" fill=\\\"#0B2540\\\" radius={[6, 6, 0, 0]} />\\n                <Bar dataKey=\\\"currentUtilizationPct\\\" name=\\\"Utilization (%)\\\" fill=\\\"#0D9488\\\" radius={[6, 6, 0, 0]} />\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </div>\\n\\n        {/* Simulink Scenario Comparison Preview */}\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n          <div className=\\\"flex items-center justify-between mb-4\\\">\\n            <div>\\n              <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                Simulink Scenario Comparison (Wait &amp; Queue)\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Illustrative analytical capacity model \342\200\224 import MATLAB CSV in Simulink Analytics\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'simulink\')}\\n              className=\\\"text-xs font-semibold text-[#0D9488] hover:underline whitespace-nowrap\\\"\\n            >\\n              Inspect All 6 \342\206\222\\n            </button>\\n          </div>\\n          <div className=\\\"h-64 w-full\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={scenarioChartData} margin={{ top: 8, right: 12, left: -16, bottom: 8 }}>\\n                <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E2E8F0\\\" />\\n                <XAxis dataKey=\\\"name\\\" tick={{ fontSize: 10, fill: \'#475569\' }} />\\n                <YAxis tick={{ fontSize: 11, fill: \'#475569\' }} />\\n                <Tooltip contentStyle={{ borderRadius: \'10px\', fontSize: \'12px\' }} />\\n                <Legend wrapperStyle={{ fontSize: \'11px\' }} />\\n                <Bar dataKey=\\\"waitMinutes\\\" name=\\\"Avg Wait (min)\\\" fill=\\\"#12598C\\\" radius={[6, 6, 0, 0]} />\\n                <Bar dataKey=\\\"queueLength\\\" name=\\\"Avg Queue\\\" fill=\\\"#D97706\\\" radius={[6, 6, 0, 0]} />\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Audit Trail Snapshot */}\\n      <section className=\\\"rounded-2xl border border-slate-200 bg-white overflow-hidden\\\">\\n        <div className=\\\"flex items-center justify-between border-b border-slate-200 px-5 py-4\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <ShieldCheck className=\\\"h-4 w-4 text-[#0D9488]\\\" />\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Recent Security &amp; Clinical Audit Trail\\n            </h2>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onNavigate(\'offline\')}\\n            className=\\\"text-xs font-semibold text-[#0D9488] hover:underline\\\"\\n          >\\n            Full Audit &amp; Sync Logs \342\206\222\\n          </button>\\n        </div>\\n        <div className=\\\"overflow-x-auto\\\">\\n          <table className=\\\"w-full text-left text-xs\\\">\\n            <thead className=\\\"bg-slate-50 text-slate-600 border-b border-slate-200\\\">\\n              <tr>\\n                <th className=\\\"px-5 py-3 font-semibold\\\">Timestamp</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Actor &amp; Role</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Action</th>\\n                <th className=\\\"px-4 py-3 font-semibold\\\">Outcome</th>\\n                <th className=\\\"px-5 py-3 font-semibold\\\">Details</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-100\\\">\\n              {data.auditLogs.slice(0, 8).map((log) => (\\n                <tr key={log.id} className=\\\"hover:bg-slate-50/70\\\">\\n                  <td className=\\\"px-5 py-3 font-mono text-[11px] text-slate-500 whitespace-nowrap tabular-nums\\\">\\n                    {new Date(log.timestamp).toLocaleString()}\\n                  </td>\\n                  <td className=\\\"px-4 py-3 text-slate-800 whitespace-nowrap\\\">\\n                    {log.userName} \302\267 <span className=\\\"capitalize text-slate-500\\\">{log.role}</span>\\n                  </td>\\n                  <td className=\\\"px-4 py-3 font-mono text-[11px] text-slate-700\\\">{log.action}</td>\\n                  <td className=\\\"px-4 py-3\\\">\\n                    <span\\n                      className={`font-semibold ${\\n                        log.outcome === \'SUCCESS\'\\n                          ? \'text-emerald-700\'\\n                          : log.outcome === \'DENIED\'\\n                          ? \'text-rose-700\'\\n                          : \'text-amber-700\'\\n                      }`}\\n                    >\\n                      {log.outcome}\\n                    </span>\\n                  </td>\\n                  <td className=\\\"px-5 py-3 text-slate-600\\\">{log.details}</td>\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create AdminDashboard with district capacity KPIs, resource utilization charts, Simulink scenario comparisons, provenance transparency, and audit trail\", \"Overwrite\":true, \"TargetFile\":\"/src/views/AdminDashboard.tsx\", \"toolAction\":\"Creating AdminDashboard view\", \"toolSummary\":\"Create src/views/AdminDashboard.tsx\"}"
      original_name: "write_to_file"
    }
