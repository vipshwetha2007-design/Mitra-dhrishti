        instruction: "import crypto from \'crypto\';\nimport fs from \'fs\';\nimport path from \'path\';\nimport {\n  buildDefaultSimulinkScenarios,\n  evaluateExperimentalLifestyleRisk,\n  interpretLaboratoryResult,\n} from \'./clinicalLogic.ts\';\nimport type {\n  AppointmentRecord,\n  AuditLogEntry,\n  DistrictResourceMetric,\n  DoctorReview,\n  FollowUpRecord,\n  HabitLog,\n  InterventionRecord,\n  LabResult,\n  LifestyleAssessment,\n  NotificationItem,\n  PatientRecord,\n  PreventionProgramme,\n  ReferralRecord,\n  RetinalScreening,\n  SimulinkScenarioResult,\n  UserAccount,\n  UserRole,\n  WeeklyLesson,\n} from \'../src/types/domain.ts\';\n\nexport interface StoredUser extends UserAccount {\n  passwordSalt?: string;\n  passwordHash?: string;\n}\n\nexport interface SessionRecord {\n  token: string;\n  userId: string;\n  role: UserRole;\n  createdAt: number;\n  expiresAt: number;\n}\n\nexport interface PersistentDatabase {\n  users: StoredUser[];\n  patients: PatientRecord[];\n  assessments: LifestyleAssessment[];\n  labs: LabResult[];\n  programmes: PreventionProgramme[];\n  habitLogs: HabitLog[];\n  interventions: InterventionRecord[];\n  screenings: RetinalScreening[];\n  doctorReviews: DoctorReview[];\n  referrals: ReferralRecord[];\n  appointments: AppointmentRecord[];\n  followUps: FollowUpRecord[];\n  notifications: NotificationItem[];\n  districtResources: DistrictResourceMetric[];\n  simulations: SimulinkScenarioResult[];\n  auditLogs: AuditLogEntry[];\n  processedIdempotencyKeys: Record<string, { syncedAt: string; resourceId: string }>;\n}\n\nconst DATA_DIR = path.resolve(process.cwd(), \'data\');\nconst STORE_PATH = path.resolve(DATA_DIR, \'mritidhristi_store.json\');\nconst SESSION_TTL_MS = 1000 * 60 * 60 * 8; // 8 hours\n\nexport function hashPassword(password: string): { salt: string; hash: string } {\n  const salt = crypto.randomBytes(16).toString(\'hex\');\n  const hash = crypto.scryptSync(password, salt, 64).toString(\'hex\');\n  return { salt, hash };\n}\n\nexport function verifyPassword(password: string, salt: string, expectedHash: string): boolean {\n  const derived = crypto.scryptSync(password, salt, 64);\n  const expected = Buffer.from(expectedHash, \'hex\');\n  if (derived.length !== expected.length) return false;\n  return crypto.timingSafeEqual(derived, expected);\n}\n\nfunction buildDefaultLessons(): WeeklyLesson[] {\n  return [\n    {\n      id: \'les-1\',\n      week: 1,\n      phase: 1,\n      title: \'Balanced South Indian Plate (Thali Proportions)\',\n      titleTa: \'\340\256\232\340\256\256\340\256\232\340\257\215\340\256\232\340\257\200\340\256\260\340\256\276\340\256\251 \340\256\244\340\257\206\340\256\251\340\257\215\340\256\251\340\256\277\340\256\250\340\257\215\340\256\244\340\256\277\340\256\257 \340\256\211\340\256\243\340\256\265\340\257\201\340\256\244\340\257\215 \340\256\244\340\256\237\340\257\215\340\256\237\340\257\201\',\n      category: \'Indian Nutrition\',\n      durationMinutes: 6,\n      summary: \'Fill half your plate with poriyal/kootu greens, one quarter with sambar/dal or sprouts, and one quarter with hand-pounded rice or millets.\',\n      completed: true,\n      completedAt: \'2026-10-02T09:00:00Z\',\n    },\n    {\n      id: \'les-2\',\n      week: 2,\n      phase: 1,\n      title: \'15-Minute Post-Meal Walking for Glucose Stability\',\n      titleTa: \'\340\256\211\340\256\243\340\256\265\340\257\201\340\256\225\340\257\215\340\256\225\340\257\201\340\256\252\340\257\215 \340\256\252\340\256\277\340\256\251\340\257\215 15 \340\256\250\340\256\277\340\256\256\340\256\277\340\256\237 \340\256\250\340\256\237\340\257\210\340\256\252\340\257\215\340\256\252\340\256\257\340\256\277\340\256\261\340\257\215\340\256\232\340\256\277\',\n      category: \'Physical Activity\',\n      durationMinutes: 5,\n      summary: \'Light brisk walking 15\342\200\22320 minutes after lunch and dinner gently lowers post-meal blood glucose spikes.\',\n      completed: true,\n      completedAt: \'2026-10-10T10:15:00Z\',\n    },\n    {\n      id: \'les-3\',\n      week: 3,\n      phase: 1,\n      title: \'Millet Swaps: Ragi, Thinai & Kambu in Daily Meals\',\n      titleTa: \'\340\256\244\340\256\277\340\256\251\340\256\232\340\256\260\340\256\277 \340\256\211\340\256\243\340\256\265\340\256\277\340\256\262\340\257\215 \340\256\232\340\256\277\340\256\261\340\257\201\340\256\244\340\256\276\340\256\251\340\256\277\340\256\257 \340\256\256\340\256\276\340\256\261\340\257\215\340\256\261\340\256\231\340\257\215\340\256\225\340\256\263\340\257\215\',\n      category: \'Indian Nutrition\',\n      durationMinutes: 7,\n      summary: \'Practical ways to blend ragi dosa, thinai upma, and vegetable dalia without losing family meal enjoyment.\',\n      completed: true,\n      completedAt: \'2026-10-18T11:30:00Z\',\n    },\n    {\n      id: \'les-4\',\n      week: 4,\n      phase: 1,\n      title: \'Restorative Sleep & Stress Cortisol Balance\',\n      titleTa: \'\340\256\250\340\256\262\340\257\215\340\256\262 \340\256\244\340\257\202\340\256\225\340\257\215\340\256\225\340\256\256\340\257\215 \340\256\256\340\256\261\340\257\215\340\256\261\340\257\201\340\256\256\340\257\215 \340\256\256\340\256\251 \340\256\205\340\256\264\340\257\201\340\256\244\340\257\215\340\256\244 \340\256\232\340\256\256\340\256\250\340\256\277\340\256\262\340\257\210\',\n      category: \'Sleep & Stress\',\n      durationMinutes: 6,\n      summary: \'Consistent 7\342\200\2238 hour sleep routines support insulin sensitivity and reduce late-night cravings.\',\n      completed: false,\n    },\n    {\n      id: \'les-5\',\n      week: 12,\n      phase: 1,\n      title: \'90-Day Checkpoint: Understanding HbA1c & Fasting Glucose\',\n      titleTa: \'90-\340\256\250\340\256\276\340\256\263\340\257\215 \340\256\232\340\257\213\340\256\244\340\256\251\340\257\210: HbA1c \340\256\256\340\256\261\340\257\215\340\256\261\340\257\201\340\256\256\340\257\215 \340\256\232\340\256\260\340\257\215\