    tool_calls {
      id: "call_7660894246683396328"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  CheckCircle2,\\n  Database,\\n  Eye,\\n  FileCheck2,\\n  Layers,\\n  ShieldAlert,\\n  Upload,\\n} from \'lucide-react\';\\nimport type { BootstrapPayload, RetinalScreening } from \'../types/domain\';\\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\\nimport {\\n  analyzeRetinalCanvasPixels,\\n  renderSyntheticFundusToCanvas,\\n  type PipelineAnalysisOutput,\\n  type RetinalPresetKey,\\n} from \'../utils/retinalPipeline\';\\n\\ninterface DetectModuleProps {\\n  data: BootstrapPayload;\\n  selectedPatientId: string;\\n  onSelectPatient: (id: string) => void;\\n  isOnline: boolean;\\n  onSubmitScreening: (payload: Omit<RetinalScreening, \'id\' | \'capturedAt\' | \'humanReviewStatus\' | \'summaryText\'>) => Promise<void>;\\n  onNavigateProtect: () => void;\\n}\\n\\nconst SEVEN_STEPS = [\\n  { num: 1, title: \'Image Quality Assessment\', stage: \'raw\' as const },\\n  { num: 2, title: \'Enhancement & CLAHE Preprocessing\', stage: \'preprocessed\' as const },\\n  { num: 3, title: \'Anatomical Structure Detection\', stage: \'anatomy\' as const },\\n  { num: 4, title: \'Lesion Detection (Illustrative)\', stage: \'lesions\' as const },\\n  { num: 5, title: \'CNN ICDR 5-Class DR Grading\', stage: \'raw\' as const },\\n  { num: 6, title: \'Grad-CAM Explainability\', stage: \'gradcam\' as const },\\n  { num: 7, title: \'Annotated Report Generation\', stage: \'gradcam\' as const },\\n];\\n\\nconst DATASET_SPECS = [\\n  {\\n    name: \'APTOS 2019 Blindness Detection\',\\n    role: \'Primary DR grading experiments (5-class ICDR 0\342\200\2234)\',\\n    splitRule: \'Stratified split with duplicate/near-duplicate hash check; never mixed into external test fold.\',\\n    metrics: \'Sensitivity, Specificity, Quadratic Weighted Kappa, Macro F1, ROC-AUC\',\\n    status: \'Loader & validation interface defined (no weights fabricated)\',\\n  },\\n  {\\n    name: \'IDRiD (Indian Diabetic Retinopathy Image Dataset)\',\\n    role: \'Indian fundus grading + pixel-level lesion segmentation (EX, HE, SE, MA)\',\\n    splitRule: \'Strict official train/test partition preserving Indian clinical imaging characteristics.\',\\n    metrics: \'AUC-PR for Hard Exudates & Haemorrhages; Microaneurysm experimental benchmark\',\\n    status: \'Lesion mask & Indian calibration interface ready\',\\n  },\\n  {\\n    name: \'DRIVE (Digital Retinal Images for Vessel Extraction)\',\\n    role: \'Retinal vessel segmentation & anatomical landmark verification\',\\n    splitRule: \'Used exclusively for Step 3 vessel/optic-disc anatomy \342\200\224 NEVER interchanged with DR grading labels.\',\\n    metrics: \'Vessel Dice / IoU, Sensitivity, Specificity\',\\n    status: \'Anatomy pipeline specification documented\',\\n  },\\n  {\\n    name: \'Messidor-2\',\\n    role: \'External validation cohort (held-out out-of-distribution generalization)\',\\n    splitRule: \'Zero training exposure; strict patient-level eye pairing to prevent leakage.\',\\n    metrics: \'Referable DR (\342\211\245 Grade 2) Sensitivity, Specificity, External AUC\',\\n    status: \'External evaluation harness ready (access-gated dataset)\',\\n  },\\n];\\n\\nexport const DetectModule: React.FC<DetectModuleProps> = ({\\n  data,\\n  selectedPatientId,\\n  onSelectPatient,\\n  isOnline,\\n  onSubmitScreening,\\n  onNavigateProtect,\\n}) => {\\n  const [subTab, setSubTab] = useState<\'pipeline\' | \'datasets\' | \'history\'>(\'pipeline\');\\n  const [preset, setPreset] = useState<\'normal_demo\' | \'moderate_npdr_demo\' | \'ungradable_blur_demo\' | \'uploaded_custom\'>(\'moderate_npdr_demo\');\\n  const [customDataUrl, setCustomDataUrl] = useState<string | undefined>(undefined);\\n  const [eye, setEye] = useState<\'Left (OS)\' | \'Right (OD)\'>(\'Left (OS)\');\\n  const [cameraSource, setCameraSource] = useState(\'Remidio FOP Non-Mydriatic Fundus Camera (Synthetic Demo)\');\\n  const [activeStep, setActiveStep] = useState(1);\\n  const [gradCamOpacity, setGradCamOpacity] = useState(0.65);\\n  const [compareSideBySide, setCompareSideBySide] = useState(true);\\n  const [analysis, setAnalysis] = useState<PipelineAnalysisOutput | null>(null);\\n  const [submitting, setSubmitting] = useState(false);\\n  const [feedback, setFeedback] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n\\n  const hiddenCanvasRef = useRef<HTMLCanvasElement | null>(null);\\n\\n  const patient =\\n    data.patients.find((p) => p.id === selectedPatientId) || data.patients[0];\\n  const isEligible = patient?.diabetesStatus === \'diagnosed_t2d\';\\n  const patientScreenings = data.screenings.filter((s) => s.patientId === patient?.id);\\n\\n  // Run genuine pixel analysis whenever preset or uploaded image changes\\n  useEffect(() => {\\n    const canvas = hiddenCanvasRef.current;\\n    if (!canvas) return;\\n    const ctx = canvas.getContext(\'2d\');\\n    if (!ctx) return;\\n\\n    if (preset === \'uploaded_custom\' && customDataUrl) {\\n      const img = new Image();\\n      img.onload = () => {\\n        canvas.width = Math.min(512, img.width);\\n        canvas.height = Math.min(512, img.height);\\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\\n        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);\\n        setAnalysis(analyzeRetinalCanvasPixels(canvas, \'uploaded_custom\'));\\n      };\\n      img.src = customDataUrl;\\n    } else {\\n      canvas.width = 384;\\n      canvas.height = 384;\\n      const demoKey: RetinalPresetKey =\\n        preset === \'uploaded_custom\' ? \'normal_demo\' : preset;\\n      renderSyntheticFundusToCanvas(canvas, demoKey, { stage: \'raw\' });\\n      setAnalysis(analyzeRetinalCanvasPixels(canvas, demoKey));\\n    }\\n  }, [preset, customDataUrl]);\\n\\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    setFeedback(null);\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    if (![\'image/png\', \'image/jpeg\', \'image/webp\'].includes(file.type)) {\\n      setFeedback({\\n        type: \'error\',\\n        text: \'Upload rejected: Only PNG, JPEG, or WebP fundus images are permitted.\',\\n      });\\n      return;\\n    }\\n    if (file.size > 4.5 * 1024 * 1024) {\\n      setFeedback({\\n        type: \'error\',\\n        text: \'Upload rejected: File exceeds 4.5 MB safety limit.\',\\n      });\\n      return;\\n    }\\n    const reader = new FileReader();\\n    reader.onload = () => {\\n      if (typeof reader.result === \'string\') {\\n        setCustomDataUrl(reader.result);\\n        setPreset(\'uploaded_custom\');\\n        setCameraSource(`Uploaded File: ${file.name}`);\\n        setActiveStep(1);\\n      }\\n    };\\n    reader.readAsDataURL(file);\\n  };\\n\\n  const handleSubmitReport = async () => {\\n    if (!patient || !analysis) return;\\n    setSubmitting(true);\\n    setFeedback(null);\\n    try {\\n      await onSubmitScreening({\\n        patientId: patient.id,\\n        eye,\\n        cameraSource,\\n        imagePreset: preset,\\n        imageDataUrl: preset === \'uploaded_custom\' ? customDataUrl : undefined,\\n        quality: analysis.quality,\\n        anatomicalStructures: analysis.anatomicalStructures,\\n        lesionFindings: analysis.lesionFindings,\\n        modelPrediction: analysis.modelPrediction,\\n        gradCam: analysis.gradCam,\\n      });\\n      setFeedback({\\n        type: \'success\',\\n        text: analysis.quality.gradable\\n          ? \'Annotated screening report saved and queued for mandatory Doctor Review in Pillar 3 (Protect).\'\\n          : \'Ungradable image rejection recorded in patient history with recapture recommendation.\',\\n      });\\n    } catch (err) {\\n      setFeedback({\\n        type: \'error\',\\n        text: err instanceof Error ? err.message : \'Unable to save retinal screening.\',\\n      });\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const currentStage = SEVEN_STEPS[activeStep - 1]?.stage ?? \'raw\';\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      <canvas ref={hiddenCanvasRef} className=\\\"hidden\\\" />\\n\\n      {/* Header */}\\n      <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-[#12598C]\\\">\\n            Pillar Two \302\267 AI-Assisted Diabetic Retinopathy Screening (7-Step Pipeline)\\n          </p>\\n          <h1 className=\\\"font-display text-2xl font-bold text-[#0B2540]\\\">\\n            DETECT \342\200\224 Retinal Screening &amp; Explainable AI\\n          </h1>\\n        </div>\\n\\n        {data.patients.length > 1 && (\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label htmlFor=\\\"detect-patient\\\" className=\\\"text-xs font-semibold text-slate-600\\\">\\n              Patient:\\n            </label>\\n            <select\\n              id=\\\"detect-patient\\\"\\n              value={patient?.id || \'\'}\\n              onChange={(e) => onSelectPatient(e.target.value)}\\n              className=\\\"rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800\\\"\\n            >\\n              {data.patients.map((p) => (\\n                <option key={p.id} value={p.id}>\\n                  {p.name} ({p.mrn}) \302\267 {p.diabetesStatus === \'diagnosed_t2d\' ? \'Diagnosed T2D\' : \'Not T2D\'}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Clinical Eligibility Notice */}\\n      {!isEligible && patient && (\\n        <div className=\\\"rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-950 flex items-start gap-2.5\\\">\\n          <AlertTriangle className=\\\"h-4 w-4 text-amber-700 shrink-0 mt-0.5\\\" />\\n          <div>\\n            <strong>Eligibility Clinical Boundary:</strong> Diabetic retinopathy screening is intended for individuals already diagnosed with diabetes. <strong>{patient.name}</strong> is currently classified as <em>{patient.diabetesStatus}</em>. Confirm clinical eligibility or laboratory diagnosis before screening.\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Sub Tabs */}\\n      <div className=\\\"flex flex-wrap gap-1.5 rounded-xl bg-slate-200/70 p-1\\\">\\n        {[\\n          { id: \'pipeline\', label: \'Acquisition & 7-Step Pipeline\', icon: Layers },\\n          { id: \'datasets\', label: \'Dataset Architecture (APTOS/IDRiD/DRIVE/Messidor-2)\', icon: Database },\\n          { id: \'history\', label: `Screening History (${patientScreenings.length})`, icon: FileCheck2 },\\n        ].map((tab) => {\\n          const Icon = tab.icon;\\n          const active = subTab === tab.id;\\n          return (\\n            <button\\n              key={tab.id}\\n              type=\\\"button\\\"\\n              onClick={() => setSubTab(tab.id as typeof subTab)}\\n              className={`inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-xs font-semibold transition-colors whitespace-nowrap ${\\n                active ? \'bg-white text-[#0B2540] shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              <Icon className=\\\"h-3.5 w-3.5 text-[#12598C]\\\" />\\n              {tab.label}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {feedback && (\\n        <div\\n          className={`rounded-xl border px-4 py-3 text-xs font-medium flex items-center justify-between gap-3 ${\\n            feedback.type === \'success\'\\n              ? \'border-emerald-200 bg-emerald-50 text-emerald-900\'\\n              : \'border-rose-200 bg-rose-50 text-rose-900\'\\n          }`}\\n        >\\n          <span>{feedback.text}</span>\\n          {feedback.type === \'success\' && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onNavigateProtect}\\n              className=\\\"shrink-0 rounded-lg bg-[#0B2540] px-3 py-1.5 text-xs font-semibold text-white\\\"\\n            >\\n              Go to Doctor Review \342\206\222\\n            </button>\\n          )}\\n        </div>\\n      )}\\n\\n      {/* TAB 1: ACQUISITION + 7-STEP PIPELINE */}\\n      {subTab === \'pipeline\' && (\\n        <div className=\\\"grid grid-cols-1 xl:grid-cols-12 gap-5 items-start\\\">\\n          {/* Left 4 cols: Image Acquisition & 7-Step Stepper */}\\n          <div className=\\\"xl:col-span-4 space-y-4\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5 space-y-3.5\\\">\\n              <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n                A. Retinal Image Acquisition\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Upload a retinal image (PNG/JPEG/WebP, max 4.5MB) or select a synthetic demonstration capture to inspect all 7 stages.\\n              </p>\\n\\n              <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                <div>\\n                  <label className=\\\"block text-[11px] font-semibold text-slate-600 mb-1\\\">Eye</label>\\n                  <select\\n                    value={eye}\\n                    onChange={(e) => setEye(e.target.value as \'Left (OS)\' | \'Right (OD)\')}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"Left (OS)\\\">Left (OS)</option>\\n                    <option value=\\\"Right (OD)\\\">Right (OD)</option>\\n                  </select>\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-[11px] font-semibold text-slate-600 mb-1\\\">Demo Sample</label>\\n                  <select\\n                    value={preset}\\n                    onChange={(e) => {\\n                      const val = e.target.value as typeof preset;\\n                      setPreset(val);\\n                      if (val !== \'uploaded_custom\') {\\n                        setCameraSource(\'Remidio FOP Non-Mydriatic Fundus Camera (Synthetic Demo)\');\\n                      }\\n                    }}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"normal_demo\\\">Synthetic: Normal (Grade 0)</option>\\n                    <option value=\\\"moderate_npdr_demo\\\">Synthetic: Moderate NPDR</option>\\n                    <option value=\\\"ungradable_blur_demo\\\">Synthetic: Blurred Ungradable</option>\\n                    {customDataUrl && <option value=\\\"uploaded_custom\\\">Uploaded Custom Image</option>}\\n                  </select>\\n                </div>\\n              </div>\\n\\n              <label className=\\\"flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 text-xs font-semibold text-[#0B2540] hover:bg-slate-100 transition-colors\\\">\\n                <Upload className=\\\"h-4 w-4 text-[#0D9488]\\\" />\\n                <span>Upload Retinal Image File</span>\\n                <input\\n                  type=\\\"file\\\"\\n                  accept=\\\"image/png,image/jpeg,image/webp\\\"\\n                  onChange={handleFileUpload}\\n                  className=\\\"hidden\\\"\\n                />\\n              </label>\\n\\n              <div>\\n                <label className=\\\"block text-[11px] font-semibold text-slate-600 mb-1\\\">\\n                  Camera / Source Metadata\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={cameraSource}\\n                  onChange={(e) => setCameraSource(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            {/* 7-Step Pipeline Stepper */}\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <h2 className=\\\"font-display text-sm font-bold text-[#0B2540] mb-3\\\">\\n                B. Seven-Step Processing Pipeline\\n              </h2>\\n              <div className=\\\"space-y-1.5\\\">\\n                {SEVEN_STEPS.map((st) => {\\n                  const active = activeStep === st.num;\\n                  const blocked =\\n                    st.num > 1 && analysis && !analysis.quality.gradable && st.num < 7;\\n                  return (\\n                    <button\\n                      key={st.num}\\n                      type=\\\"button\\\"\\n                      onClick={() => setActiveStep(st.num)}\\n                      className={`flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-xs transition-colors ${\\n                        active\\n                          ? \'bg-[#0B2540] text-white font-semibold\'\\n                          : \'text-slate-700 hover:bg-slate-100\'\\n                      }`}\\n                    >\\n                      <span\\n                        className={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full font-mono text-[11px] ${\\n                          active\\n                            ? \'bg-[#0D9488] text-white\'\\n                            : blocked\\n                            ? \'bg-rose-100 text-rose-700\'\\n                            : \'bg-slate-200 text-slate-700\'\\n                        }`}\\n                      >\\n                        {st.num}\\n                      </span>\\n                      <span className=\\\"truncate flex-1\\\">{st.title}</span>\\n                      {blocked && (\\n                        <span className=\\\"text-[10px] font-semibold text-rose-500\\\">Halted</span>\\n                      )}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Right 8 cols: Interactive Stage Canvas + Clinical Metrics & Safety Panel */}\\n          <div className=\\\"xl:col-span-8 space-y-5\\\">\\n            <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3 mb-4\\\">\\n                <div>\\n                  <div className=\\\"text-xs font-semibold text-[#12598C]\\\">\\n                    Step {activeStep} of 7 \302\267 Prototype Demonstration Mode (Illustrative Outputs Clearly Labelled)\\n                  </div>\\n                  <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n                    {SEVEN_STEPS[activeStep - 1].title}\\n                  </h2>\\n                </div>\\n\\n                {activeStep === 6 && (\\n                  <div className=\\\"flex items-center gap-3 text-xs\\\">\\n                    <label className=\\\"flex items-center gap-1.5 cursor-pointer\\\">\\n                      <input\\n                        type=\\\"checkbox\\\"\\n                        checked={compareSideBySide}\\n                        onChange={(e) => setCompareSideBySide(e.target.checked)}\\n                        className=\\\"accent-[#0D9488]\\\"\\n                      />\\n                      Side-by-side\\n                    </label>\\n                    <label className=\\\"flex items-center gap-2\\\">\\n                      <span>Heatmap</span>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={0.15}\\n                        max={0.95}\\n                        step={0.05}\\n                        value={gradCamOpacity}\\n                        onChange={(e) => setGradCamOpacity(Number(e.target.value))}\\n                        className=\\\"w-20 accent-[#0D9488]\\\"\\n                      />\\n                    </label>\\n                  </div>\\n                )}\\n              </div>\\n\\n              {/* Visualizer Area */}\\n              <div\\n                className={`grid gap-4 ${\\n                  activeStep === 6 && compareSideBySide\\n                    ? \'grid-cols-1 sm:grid-cols-2\'\\n                    : \'grid-cols-1 md:grid-cols-12 items-start\'\\n                }`}\\n              >\\n                {activeStep === 6 && compareSideBySide ? (\\n                  <>\\n                    <FundusVisualizer\\n                      preset={preset}\\n                      imageDataUrl={customDataUrl}\\n                      stage=\\\"raw\\\"\\n                      size={320}\\n                      className=\\\"aspect-square w-full max-w-[340px] mx-auto\\\"\\n                      label=\\\"Original Fundus Capture\\\"\\n                    />\\n                    <FundusVisualizer\\n                      preset={preset}\\n                      imageDataUrl={customDataUrl}\\n                      stage=\\\"gradcam\\\"\\n                      gradCamOpacity={gradCamOpacity}\\n                      hotspots={analysis?.gradCam.hotspots}\\n                      size={320}\\n                      className=\\\"aspect-square w-full max-w-[340px] mx-auto\\\"\\n                      label=\\\"Grad-CAM Explainability Overlay (Illustrative)\\\"\\n                    />\\n                  </>\\n                ) : (\\n                  <>\\n                    <div className=\\\"md:col-span-6\\\">\\n                      <FundusVisualizer\\n                        preset={preset}\\n                        imageDataUrl={customDataUrl}\\n                        stage={currentStage}\\n                        gradCamOpacity={gradCamOpacity}\\n                        hotspots={analysis?.gradCam.hotspots}\\n                        size={340}\\n                        className=\\\"aspect-square w-full max-w-[340px] mx-auto\\\"\\n                        label={`Stage ${activeStep}: ${SEVEN_STEPS[activeStep - 1].title}`}\\n                      />\\n                    </div>\\n\\n                    {/* Step-Specific Telemetry & Safety Details */}\\n                    <div className=\\\"md:col-span-6 space-y-3 text-xs\\\">\\n                      {analysis && (\\n                        <>\\n                          {/* Step 1 Quality Card */}\\n                          <div\\n                            className={`rounded-xl border p-4 ${\\n                              analysis.quality.gradable\\n                                ? \'border-emerald-200 bg-emerald-50/50\'\\n                                : \'border-rose-300 bg-rose-50\'\\n                            }`}\\n                          >\\n                            <div className=\\\"flex items-center gap-2 font-bold text-slate-900\\\">\\n                              {analysis.quality.gradable ? (\\n                                <CheckCircle2 className=\\\"h-4 w-4 text-emerald-600\\\" />\\n                              ) : (\\n                                <ShieldAlert className=\\\"h-4 w-4 text-rose-600\\\" />\\n                              )}\\n                              <span>\\n                                Step 1 Quality Gate:{\' \'}\\n                                {analysis.quality.gradable ? \'GRADABLE\' : \'UNGRADABLE \342\200\224 REJECTED\'}\\n                              </span>\\n                            </div>\\n                            <div className=\\\"mt-2 grid grid-cols-2 gap-2 font-mono text-[11px] text-slate-700 tabular-nums\\\">\\n                              <div>Sharpness: {analysis.quality.sharpnessScore}/100</div>\\n                              <div>Brightness: {analysis.quality.brightnessMean}/255</div>\\n                              <div>Clipped Exposure: {analysis.quality.exposureClipPercent}%</div>\\n                              <div>\\n                                Resolution: {analysis.quality.width}\303\227{analysis.quality.height}\\n                              </div>\\n                            </div>\\n                            {!analysis.quality.gradable && (\\n                              <div className=\\\"mt-2.5 text-rose-900 space-y-1\\\">\\n                                <div>\\n                                  <strong>Reason:</strong> {analysis.quality.rejectionReason}\\n                                </div>\\n                                <div>\\n                                  <strong>Recapture Guidance:</strong> {analysis.quality.recaptureGuidance}\\n                                </div>\\n                              </div>\\n                            )}\\n                          </div>\\n\\n                          {/* Step 3 & 4 Anatomy / Lesions */}\\n                          <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-1.5\\\">\\n                            <div className=\\\"font-bold text-[#0B2540]\\\">\\n                              Anatomy &amp; Lesion Candidates ({analysis.lesionFindings.implementationStatus})\\n                            </div>\\n                            <div className=\\\"text-slate-700\\\">\\n                              Optic Disc: {analysis.anatomicalStructures.opticDiscDetected ? \'Localized\' : \'Not resolved\'} \302\267\\n                              Macula: {analysis.anatomicalStructures.maculaCentered ? \'Centered\' : \'Off-axis\'} \302\267\\n                              Vessel Index:{\' \'}\\n                              <span className=\\\"font-mono tabular-nums\\\">\\n                                {analysis.anatomicalStructures.vesselDensityIndex}\\n                              </span>\\n                            </div>\\n                            <div className=\\\"text-slate-700\\\">\\n                              Hard Exudates:{\' \'}\\n                              <strong>{analysis.lesionFindings.hardExudatesFlag ? \'Candidate Flagged\' : \'None Flagged\'}</strong>{\' \'}\\n                              \302\267 Haemorrhages:{\' \'}\\n                              <strong>{analysis.lesionFindings.haemorrhagesFlag ? \'Candidate Flagged\' : \'None Flagged\'}</strong>\\n                            </div>\\n                            <p className=\\\"text-[11px] text-slate-500\\\">\\n                              {analysis.lesionFindings.microaneurysmsExperimentalNote}\\n                            </p>\\n                          </div>\\n\\n                          {/* Step 5 AI Prediction & Safety Withholding */}\\n                          <div\\n                            className={`rounded-xl border p-4 space-y-1.5 ${\\n                              analysis.modelPrediction.gradeWithheld\\n                                ? \'border-amber-300 bg-amber-50/80\'\\n                                : \'border-sky-200 bg-sky-50/60\'\\n                            }`}\\n                          >\\n                            <div className=\\\"font-bold text-[#0B2540]\\\">\\n                              Step 5 Screening Output &amp; Reliability Gate\\n                            </div>\\n                            <div className=\\\"text-sm font-bold text-slate-900\\\">\\n                              {analysis.modelPrediction.gradeLabel}\\n                            </div>\\n                            <div className=\\\"font-mono text-[11px] text-slate-600 tabular-nums\\\">\\n                              Confidence: {Math.round(analysis.modelPrediction.confidence * 100)}% \302\267\\n                              Uncertainty: {Math.round(analysis.modelPrediction.uncertainty * 100)}% \302\267\\n                              OOD Flag: {analysis.modelPrediction.oodFlag ? \'YES (Withheld)\' : \'No\'}\\n                            </div>\\n                            {analysis.modelPrediction.withholdReason && (\\n                              <p className=\\\"text-amber-950 font-medium\\\">\\n                                Safe Withholding Active: {analysis.modelPrediction.withholdReason}\\n                              </p>\\n                            )}\\n                            <p className=\\\"text-[11px] text-slate-600\\\">\\n                              Model: {analysis.modelPrediction.modelVersion} \302\267 Requires mandatory clinician review.\\n                            </p>\\n                          </div>\\n                        </>\\n                      )}\\n                    </div>\\n                  </>\\n                )}\\n              </div>\\n\\n              {/* Grad-CAM Limitations Notice */}\\n              {activeStep >= 6 && analysis && (\\n                <div className=\\\"mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-700\\\">\\n                  <strong>Grad-CAM Explainability Limitation:</strong> {analysis.gradCam.limitationNotice}\\n                </div>\\n              )}\\n\\n              {/* Step 7 Submit Annotated Report */}\\n              <div className=\\\"mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4\\\">\\n                <div className=\\\"text-xs text-slate-500\\\">\\n                  Submitting creates a shared annotated report linked to <strong>{patient?.name}</strong> and notifies the reviewing doctor.\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={submitting || !analysis || !isOnline}\\n                  onClick={() => void handleSubmitReport()}\\n                  className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#0D9488] px-5 py-2.5 text-xs font-semibold text-white hover:bg-[#0F766E] disabled:opacity-50\\\"\\n                >\\n                  <Eye className=\\\"h-4 w-4\\\" />\\n                  {submitting\\n                    ? \'Generating Report...\'\\n                    : isOnline\\n                    ? \'Generate & Submit Annotated Report (Step 7)\'\\n                    : \'Requires Connectivity to Submit for Doctor Review\'}\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: DATASET INTEGRATION SPECS */}\\n      {subTab === \'datasets\' && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-6 space-y-4\\\">\\n          <div>\\n            <h2 className=\\\"font-display text-lg font-bold text-[#0B2540]\\\">\\n              Dataset Integration &amp; Evaluation Governance\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-slate-600 leading-relaxed max-w-3xl\\\">\\n              Mritidhristi never treats retinal datasets as interchangeable and never fabricates training accuracy, AUC, or clinical weights. Each dataset serves a strict role with patient-level splits and leakage prevention.\\n            </p>\\n          </div>\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            {DATASET_SPECS.map((ds) => (\\n              <div key={ds.name} className=\\\"rounded-xl border border-slate-200 p-4 space-y-2 text-xs\\\">\\n                <div className=\\\"font-display text-sm font-bold text-[#0B2540]\\\">{ds.name}</div>\\n                <div className=\\\"text-slate-700\\\">\\n                  <strong>Role:</strong> {ds.role}\\n                </div>\\n                <div className=\\\"text-slate-600\\\">\\n                  <strong>Leakage &amp; Split Rule:</strong> {ds.splitRule}\\n                </div>\\n                <div className=\\\"text-slate-600\\\">\\n                  <strong>Evaluation Metrics:</strong> {ds.metrics}\\n                </div>\\n                <div className=\\\"pt-1 font-semibold text-[#0F766E]\\\">{ds.status}</div>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: SCREENING HISTORY */}\\n      {subTab === \'history\' && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n          <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n            Retinal Screening History \342\200\224 {patient?.name}\\n          </h2>\\n          {patientScreenings.length === 0 ? (\\n            <p className=\\\"text-xs text-slate-500\\\">No retinal screenings recorded for this patient yet.</p>\\n          ) : (\\n            <div className=\\\"space-y-3\\\">\\n              {patientScreenings.map((scr) => (\\n                <div\\n                  key={scr.id}\\n                  className=\\\"flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-xl border border-slate-200 p-4 text-xs\\\"\\n                >\\n                  <FundusVisualizer\\n                    preset={scr.imagePreset}\\n                    imageDataUrl={scr.imageDataUrl}\\n                    stage=\\\"gradcam\\\"\\n                    hotspots={scr.gradCam.hotspots}\\n                    size={100}\\n                    className=\\\"h-20 w-20 shrink-0\\\"\\n                  />\\n                  <div className=\\\"min-w-0 flex-1 space-y-1\\\">\\n                    <div className=\\\"font-semibold text-slate-900\\\">\\n                      {scr.eye} \302\267 {scr.modelPrediction.gradeLabel}\\n                    </div>\\n                    <div className=\\\"text-slate-500 font-mono text-[11px] tabular-nums\\\">\\n                      {new Date(scr.capturedAt).toLocaleString()} \302\267 Sharpness {scr.quality.sharpnessScore}/100 \302\267\\n                      Review: <strong className=\\\"text-slate-800\\\">{scr.humanReviewStatus}</strong>\\n                    </div>\\n                    <p className=\\\"text-slate-600\\\">{scr.summaryText}</p>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create DetectModule with retinal image upload, 3 synthetic demo presets, real canvas 7-step processing pipeline, OOD/quality safety withholding, Grad-CAM comparison, and dataset specs\", \"Overwrite\":true, \"TargetFile\":\"/src/views/DetectModule.tsx\", \"toolAction\":\"Creating DetectModule view\", \"toolSummary\":\"Create src/views/DetectModule.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_7660894246683398107"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Calendar,\\n  CheckCircle2,\\n  ClipboardCheck,\\n  Send,\\n  Stethoscope,\\n  UserCheck,\\n} from \'lucide-react\';\\nimport type {\\n  AppointmentRecord,\\n  BootstrapPayload,\\n  DoctorReview,\\n  FollowUpRecord,\\n  ReferralRecord,\\n} from \'../types/domain\';\\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\\n\\ninterface ProtectModuleProps {\\n  data: BootstrapPayload;\\n  selectedPatientId: string;\\n  onSelectPatient: (id: string) => void;\\n  isOnline: boolean;\\n  onSubmitReview: (payload: {\\n    screeningId: string;\\n    decision: DoctorReview[\'decision\'];\\n    clinicianGrade: string;\\n    triageCategory: DoctorReview[\'triageCategory\'];\\n    clinicalNotes: string;\\n    recommendedNextSteps: string;\\n  }) => Promise<void>;\\n  onCreateReferral: (payload: {\\n    patientId: string;\\n    screeningId?: string;\\n    targetFacility: string;\\n    specialty: ReferralRecord[\'specialty\'];\\n    urgency: ReferralRecord[\'urgency\'];\\n    reason: string;\\n  }) => Promise<void>;\\n  onUpdateReferral: (id: string, status: ReferralRecord[\'status\'], specialistFindings?: string) => Promise<void>;\\n  onCreateAppointment: (payload: {\\n    patientId: string;\\n    title: string;\\n    facility: string;\\n    clinicianName: string;\\n    scheduledDate: string;\\n    scheduledTime: string;\\n    type: AppointmentRecord[\'type\'];\\n    reminderNote: string;\\n  }) => Promise<void>;\\n  onUpdateAppointment: (id: string, status: AppointmentRecord[\'status\'], escalated?: boolean) => Promise<void>;\\n  onCreateFollowUp: (payload: {\\n    patientId: string;\\n    healthWorkerName: string;\\n    dueDate: string;\\n    channel: FollowUpRecord[\'channel\'];\\n    status: FollowUpRecord[\'status\'];\\n    outcomeNotes: string;\\n    nextScreeningDate?: string;\\n  }) => Promise<void>;\\n}\\n\\nexport const ProtectModule: React.FC<ProtectModuleProps> = ({\\n  data,\\n  selectedPatientId,\\n  onSelectPatient,\\n  isOnline,\\n  onSubmitReview,\\n  onCreateReferral,\\n  onUpdateReferral,\\n  onCreateAppointment,\\n  onUpdateAppointment,\\n  onCreateFollowUp,\\n}) => {\\n  const [subTab, setSubTab] = useState<\'review\' | \'referrals\' | \'appointments\' | \'continuity\'>(\'review\');\\n  const [msg, setMsg] = useState<{ type: \'success\' | \'error\'; text: string } | null>(null);\\n  const [busy, setBusy] = useState(false);\\n\\n  const patient = data.patients.find((p) => p.id === selectedPatientId) || data.patients[0];\\n  const screenings = data.screenings.filter((s) => s.patientId === patient?.id);\\n  const activeScreening = screenings.find((s) => s.humanReviewStatus === \'pending_review\') || screenings[0];\\n  const reviews = data.doctorReviews.filter((r) => r.patientId === patient?.id);\\n  const referrals = data.referrals.filter((r) => r.patientId === patient?.id);\\n  const appointments = data.appointments.filter((a) => a.patientId === patient?.id);\\n  const followUps = data.followUps.filter((f) => f.patientId === patient?.id);\\n  const latestLab = data.labs.find((l) => l.patientId === patient?.id);\\n  const latestRisk = data.assessments.find((a) => a.patientId === patient?.id);\\n\\n  // Doctor review state\\n  const [decision, setDecision] = useState<DoctorReview[\'decision\']>(\'confirmed\');\\n  const [clinicianGrade, setClinicianGrade] = useState(\'Moderate NPDR \342\200\224 Clinician Verified\');\\n  const [triageCategory, setTriageCategory] = useState<DoctorReview[\'triageCategory\']>(\'Priority (3-6 months)\');\\n  const [clinicalNotes, setClinicalNotes] = useState(\'\');\\n  const [nextSteps, setNextSteps] = useState(\'Refer for dilated ophthalmologist examination and optimize HbA1c control.\');\\n\\n  // Referral state\\n  const [refFacility, setRefFacility] = useState(\'Regional Institute of Ophthalmology, Egmore\');\\n  const [refSpecialty, setRefSpecialty] = useState<ReferralRecord[\'specialty\']>(\'Ophthalmology\');\\n  const [refUrgency, setRefUrgency] = useState<ReferralRecord[\'urgency\']>(\'Priority\');\\n  const [refReason, setRefReason] = useState(\'\');\\n\\n  // Appointment state\\n  const [aptTitle, setAptTitle] = useState(\'Follow-up Consultation & Retinal Review\');\\n  const [aptFacility, setAptFacility] = useState(\'Adyar Urban PHC / City Hospital\');\\n  const [aptClinician, setAptClinician] = useState(\'Dr. Arvind Raman\');\\n  const [aptDate, setAptDate] = useState(\'2026-12-04\');\\n  const [aptTime, setAptTime] = useState(\'10:00 AM\');\\n  const [aptType, setAptType] = useState<AppointmentRecord[\'type\']>(\'Follow-up Consultation\');\\n  const [aptReminder, setAptReminder] = useState(\'Bring previous lab reports and medication list.\');\\n\\n  // Follow-up continuity state\\n  const [fuWorker, setFuWorker] = useState(patient?.assignedHealthWorker || \'Anitha K (VHN)\');\\n  const [fuDue, setFuDue] = useState(\'2026-12-10\');\\n  const [fuChannel, setFuChannel] = useState<FollowUpRecord[\'channel\']>(\'Phone Call\');\\n  const [fuStatus, setFuStatus] = useState<FollowUpRecord[\'status\']>(\'Scheduled\');\\n  const [fuNotes, setFuNotes] = useState(\'\');\\n  const [fuNextScreen, setFuNextScreen] = useState(\'2027-05-20\');\\n\\n  const isDoctor = data.user.role === \'doctor\';\\n  const isStaff = data.user.role === \'doctor\' || data.user.role === \'admin\';\\n\\n  const handleReviewSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!activeScreening) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onSubmitReview({\\n        screeningId: activeScreening.id,\\n        decision,\\n        clinicianGrade,\\n        triageCategory,\\n        clinicalNotes,\\n        recommendedNextSteps: nextSteps,\\n      });\\n      setClinicalNotes(\'\');\\n      setMsg({ type: \'success\', text: \'Clinician review recorded and patient notified.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to submit review.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleCreateReferral = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onCreateReferral({\\n        patientId: patient.id,\\n        screeningId: activeScreening?.id,\\n        targetFacility: refFacility,\\n        specialty: refSpecialty,\\n        urgency: refUrgency,\\n        reason: refReason,\\n      });\\n      setRefReason(\'\');\\n      setMsg({ type: \'success\', text: \'Specialist referral created and logged in continuity record.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to create referral.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleCreateApt = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onCreateAppointment({\\n        patientId: patient.id,\\n        title: aptTitle,\\n        facility: aptFacility,\\n        clinicianName: aptClinician,\\n        scheduledDate: aptDate,\\n        scheduledTime: aptTime,\\n        type: aptType,\\n        reminderNote: aptReminder,\\n      });\\n      setMsg({ type: \'success\', text: \'Appointment scheduled in shared patient care plan.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to book appointment.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleCreateFollowUp = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!patient) return;\\n    setBusy(true);\\n    setMsg(null);\\n    try {\\n      await onCreateFollowUp({\\n        patientId: patient.id,\\n        healthWorkerName: fuWorker,\\n        dueDate: fuDue,\\n        channel: fuChannel,\\n        status: fuStatus,\\n        outcomeNotes: fuNotes,\\n        nextScreeningDate: fuNextScreen || undefined,\\n      });\\n      setFuNotes(\'\');\\n      setMsg({ type: \'success\', text: \'Health-worker continuity follow-up recorded.\' });\\n    } catch (err) {\\n      setMsg({ type: \'error\', text: err instanceof Error ? err.message : \'Unable to save follow-up.\' });\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      {/* Header & Shared Patient Context */}\\n      <div className=\\\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-indigo-700\\\">\\n            Pillar Three \302\267 Clinician Review, Referrals, Appointments &amp; Continuity of Care\\n          </p>\\n          <h1 className=\\\"font-display text-2xl font-bold text-[#0B2540]\\\">\\n            PROTECT \342\200\224 Doctor-Led Clinical Coordination\\n          </h1>\\n        </div>\\n        {data.patients.length > 1 && (\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label htmlFor=\\\"protect-patient\\\" className=\\\"text-xs font-semibold text-slate-600\\\">\\n              Patient Chart:\\n            </label>\\n            <select\\n              id=\\\"protect-patient\\\"\\n              value={patient?.id || \'\'}\\n              onChange={(e) => onSelectPatient(e.target.value)}\\n              className=\\\"rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-800\\\"\\n            >\\n              {data.patients.map((p) => (\\n                <option key={p.id} value={p.id}>\\n                  {p.name} ({p.mrn})\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Unified Patient Longitudinal Summary Strip */}\\n      {patient && (\\n        <div className=\\\"rounded-2xl border border-slate-200 bg-white p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs\\\">\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Patient &amp; MRN</div>\\n            <div className=\\\"mt-0.5 font-display text-sm font-bold text-[#0B2540]\\\">{patient.name}</div>\\n            <div className=\\\"font-mono text-[11px] text-slate-500\\\">\\n              {patient.mrn} \302\267 {patient.age}y {patient.sex} \302\267 {patient.district}\\n            </div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Prevent Risk Score</div>\\n            <div className=\\\"mt-0.5 font-mono text-sm font-bold text-slate-900 tabular-nums\\\">\\n              {latestRisk ? `${latestRisk.experimentalScore}/100 (${latestRisk.riskCategory})` : \'Not assessed\'}\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Experimental lifestyle screen</div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Latest Clinical Lab</div>\\n            <div className=\\\"mt-0.5 font-mono text-sm font-bold text-slate-900 tabular-nums\\\">\\n              {latestLab\\n                ? `HbA1c ${latestLab.hba1cPercent ?? \'\342\200\224\'}% \302\267 FPG ${latestLab.fastingGlucoseMgDl ?? \'\342\200\224\'}`\\n                : \'No lab recorded\'}\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">\\n              {patient.diabetesStatus === \'diagnosed_t2d\' ? \'Diagnosed T2D\' : patient.diabetesStatus}\\n            </div>\\n          </div>\\n          <div>\\n            <div className=\\\"text-slate-500\\\">Care Team Ownership</div>\\n            <div className=\\\"mt-0.5 text-sm font-bold text-[#0F766E]\\\">\\n              {patient.assignedHealthWorker}\\n            </div>\\n            <div className=\\\"text-[11px] text-slate-500\\\">Dr. Arvind Raman (MO)</div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {!isOnline && (\\n        <div className=\\\"rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs text-amber-950 flex items-center gap-2\\\">\\n          <AlertTriangle className=\\\"h-4 w-4 text-amber-700 shrink-0\\\" />\\n          <span>\\n            <strong>Online-Only Clinical Governance:</strong> Remote doctor review sign-off, specialist referral updates, and external hospital appointment confirmations require live connectivity and are paused while offline.\\n          </span>\\n        </div>\\n      )}\\n\\n      {/* Sub Tabs */}\\n      <div className=\\\"flex flex-wrap gap-1.5 rounded-xl bg-slate-200/70 p-1\\\">\\n        {[\\n          { id: \'review\', label: \'Doctor Clinical Review\', icon: Stethoscope },\\n          { id: \'referrals\', label: `Referrals (${referrals.length})`, icon: Send },\\n          { id: \'appointments\', label: `Appointments (${appointments.length})`, icon: Calendar },\\n          { id: \'continuity\', label: `Continuity & Follow-ups (${followUps.length})`, icon: UserCheck },\\n        ].map((tab) => {\\n          const Icon = tab.icon;\\n          const active = subTab === tab.id;\\n          return (\\n            <button\\n              key={tab.id}\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setSubTab(tab.id as typeof subTab);\\n                setMsg(null);\\n              }}\\n              className={`inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-xs font-semibold transition-colors whitespace-nowrap ${\\n                active ? \'bg-white text-[#0B2540] shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\\n              }`}\\n            >\\n              <Icon className=\\\"h-3.5 w-3.5 text-indigo-700\\\" />\\n              {tab.label}\\n            </button>\\n          );\\n        })}\\n      </div>\\n\\n      {msg && (\\n        <div\\n          className={`rounded-xl border px-4 py-3 text-xs font-medium ${\\n            msg.type === \'success\'\\n              ? \'border-emerald-200 bg-emerald-50 text-emerald-900\'\\n              : \'border-rose-200 bg-rose-50 text-rose-900\'\\n          }`}\\n        >\\n          {msg.text}\\n        </div>\\n      )}\\n\\n      {/* TAB 1: DOCTOR CLINICAL REVIEW */}\\n      {subTab === \'review\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5 items-start\\\">\\n          <div className=\\\"lg:col-span-6 rounded-2xl border border-slate-200 bg-white p-5 space-y-4\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Retinal Screening &amp; Grad-CAM Inspection\\n            </h2>\\n            {activeScreening ? (\\n              <>\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <FundusVisualizer\\n                    preset={activeScreening.imagePreset}\\n                    imageDataUrl={activeScreening.imageDataUrl}\\n                    stage=\\\"raw\\\"\\n                    size={240}\\n                    className=\\\"aspect-square w-full\\\"\\n                    label={`Original (${activeScreening.eye})`}\\n                  />\\n                  <FundusVisualizer\\n                    preset={activeScreening.imagePreset}\\n                    imageDataUrl={activeScreening.imageDataUrl}\\n                    stage=\\\"gradcam\\\"\\n                    hotspots={activeScreening.gradCam.hotspots}\\n                    size={240}\\n                    className=\\\"aspect-square w-full\\\"\\n                    label=\\\"Grad-CAM Assist\\\"\\n                  />\\n                </div>\\n                <div className=\\\"rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-xs space-y-1\\\">\\n                  <div className=\\\"font-bold text-slate-900\\\">\\n                    AI Screening Assist: {activeScreening.modelPrediction.gradeLabel}\\n                  </div>\\n                  <div className=\\\"font-mono text-[11px] text-slate-600 tabular-nums\\\">\\n                    Quality: {activeScreening.quality.gradable ? \'Gradable\' : \'Ungradable\'} \302\267\\n                    Sharpness: {activeScreening.quality.sharpnessScore}/100 \302\267\\n                    Status: {activeScreening.humanReviewStatus}\\n                  </div>\\n                  <p className=\\\"text-slate-600\\\">{activeScreening.summaryText}</p>\\n                </div>\\n              </>\\n            ) : (\\n              <p className=\\\"text-xs text-slate-500\\\">No retinal screening available for this patient yet.</p>\\n            )}\\n\\n            {/* Past Reviews */}\\n            <div className=\\\"pt-2 border-t border-slate-100 space-y-2\\\">\\n              <div className=\\\"text-xs font-bold text-[#0B2540]\\\">Clinician Review History</div>\\n              {reviews.length === 0 ? (\\n                <p className=\\\"text-xs text-slate-500\\\">Awaiting first doctor clinical review.</p>\\n              ) : (\\n                reviews.map((rev) => (\\n                  <div key={rev.id} className=\\\"rounded-xl border border-emerald-200 bg-emerald-50/40 p-3 text-xs space-y-1\\\">\\n                    <div className=\\\"flex items-center justify-between\\\">\\n                      <span className=\\\"font-bold text-slate-900\\\">{rev.clinicianGrade}</span>\\n                      <span className=\\\"font-semibold text-[#0F766E]\\\">{rev.triageCategory}</span>\\n                    </div>\\n                    <p className=\\\"text-slate-700\\\">{rev.clinicalNotes}</p>\\n                    <div className=\\\"text-[11px] text-slate-500\\\">\\n                      Signed by {rev.doctorName} \302\267 {new Date(rev.reviewedAt).toLocaleString()}\\n                    </div>\\n                  </div>\\n                ))\\n              )}\\n            </div>\\n          </div>\\n\\n          {/* Clinical Decision Form (Doctor Only) */}\\n          <div className=\\\"lg:col-span-6 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Clinician Confirmation &amp; Triage Protocol\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-slate-500\\\">\\n              Triage follows clinician-approved ophthalmology protocols \342\200\224 never solely AI confidence or lifestyle score.\\n            </p>\\n\\n            {!isDoctor ? (\\n              <div className=\\\"mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs text-amber-950\\\">\\n                <strong>RBAC Protection Active:</strong> Clinical confirmation and triage sign-off are restricted to authenticated <strong>Doctor</strong> accounts. Switch to <em>Dr. Arvind Raman</em> via the top-right account menu to submit a review.\\n              </div>\\n            ) : !activeScreening ? (\\n              <p className=\\\"mt-4 text-xs text-slate-500\\\">Capture or upload a retinal screening in Detect first.</p>\\n            ) : (\\n              <form onSubmit={handleReviewSubmit} className=\\\"mt-4 space-y-3.5\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinical Decision on AI-Assisted Finding\\n                  </label>\\n                  <select\\n                    value={decision}\\n                    onChange={(e) => setDecision(e.target.value as DoctorReview[\'decision\'])}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"confirmed\\\">Confirm AI-Assisted Finding</option>\\n                    <option value=\\\"rejected_modified\\\">Reject / Override with Clinician Assessment</option>\\n                    <option value=\\\"recapture_requested\\\">Reject Image \342\200\224 Request Fundus Recapture</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinician Grade / Finding\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={clinicianGrade}\\n                    onChange={(e) => setClinicianGrade(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinician-Approved Triage Category\\n                  </label>\\n                  <select\\n                    value={triageCategory}\\n                    onChange={(e) => setTriageCategory(e.target.value as DoctorReview[\'triageCategory\'])}\\n                    className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium\\\"\\n                  >\\n                    <option value=\\\"Routine (12 months)\\\">Routine (12 months)</option>\\n                    <option value=\\\"Priority (3-6 months)\\\">Priority (3\342\200\2236 months)</option>\\n                    <option value=\\\"Urgent Ophthalmology (< 2 weeks)\\\">Urgent Ophthalmology (&lt; 2 weeks)</option>\\n                    <option value=\\\"Immediate Recapture\\\">Immediate Recapture</option>\\n                  </select>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Clinical Notes\\n                  </label>\\n                  <textarea\\n                    required\\n                    rows={3}\\n                    value={clinicalNotes}\\n                    onChange={(e) => setClinicalNotes(e.target.value)}\\n                    placeholder=\\\"Document optic disc, macula, exudates, haemorrhages, and glycaemic context...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Recommended Next Steps\\n                  </label>\\n                  <textarea\\n                    required\\n                    rows={2}\\n                    value={nextSteps}\\n                    onChange={(e) => setNextSteps(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 text-xs\\\"\\n                  />\\n                </div>\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy || !isOnline}\\n                  className=\\\"inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#0B2540] py-2.5 text-xs font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  <ClipboardCheck className=\\\"h-4 w-4\\\" />\\n                  {busy ? \'Signing Review...\' : \'Sign & Save Clinical Review\'}\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: REFERRAL MANAGEMENT */}\\n      {subTab === \'referrals\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Referral Records ({patient?.name})\\n            </h2>\\n            {referrals.length === 0 ? (\\n              <p className=\\\"text-xs text-slate-500\\\">No specialist referrals issued for this patient.</p>\\n            ) : (\\n              referrals.map((ref) => (\\n                <div key={ref.id} className=\\\"rounded-xl border border-slate-200 p-4 text-xs space-y-2\\\">\\n                  <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                    <span className=\\\"font-bold text-slate-900\\\">\\n                      {ref.urgency} \302\267 {ref.specialty} \342\206\222 {ref.targetFacility}\\n                    </span>\\n                    <span className=\\\"font-mono font-semibold text-[#0F766E]\\\">{ref.status}</span>\\n                  </div>\\n                  <p className=\\\"text-slate-600\\\">{ref.reason}</p>\\n                  {ref.specialistFindings && (\\n                    <div className=\\\"rounded-lg bg-emerald-50 border border-emerald-200 p-2.5 text-emerald-950\\\">\\n                      <strong>Specialist Feedback:</strong> {ref.specialistFindings}\\n                    </div>\\n                  )}\\n                  {isStaff && isOnline && ref.status !== \'Completed\' && (\\n                    <div className=\\\"flex flex-wrap gap-2 pt-1\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateReferral(ref.id, \'Accepted\')}\\n                        className=\\\"rounded-lg border border-slate-200 px-3 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-50\\\"\\n                      >\\n                        Mark Accepted\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() =>\\n                          void onUpdateReferral(\\n                            ref.id,\\n                            \'Completed\',\\n                            \'Dilated fundus examination & OCT completed; follow-up plan updated in PHC chart.\'\\n                          )\\n                        }\\n                        className=\\\"rounded-lg bg-[#0D9488] px-3 py-1 text-[11px] font-semibold text-white hover:bg-[#0F766E]\\\"\\n                      >\\n                        Record Specialist Findings &amp; Complete\\n                      </button>\\n                    </div>\\n                  )}\\n                </div>\\n              ))\\n            )}\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">Issue New Referral</h3>\\n            {!isStaff ? (\\n              <p className=\\\"mt-2 text-xs text-slate-500\\\">\\n                Referrals are generated by authorised Doctors or Health Administrators.\\n              </p>\\n            ) : (\\n              <form onSubmit={handleCreateReferral} className=\\\"mt-4 space-y-3 text-xs\\\">\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Target Healthcare Facility</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={refFacility}\\n                    onChange={(e) => setRefFacility(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Specialty</label>\\n                    <select\\n                      value={refSpecialty}\\n                      onChange={(e) => setRefSpecialty(e.target.value as ReferralRecord[\'specialty\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Ophthalmology\\\">Ophthalmology</option>\\n                      <option value=\\\"Diabetology\\\">Diabetology</option>\\n                      <option value=\\\"Primary Health Centre\\\">Primary Health Centre</option>\\n                    </select>\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Urgency</label>\\n                    <select\\n                      value={refUrgency}\\n                      onChange={(e) => setRefUrgency(e.target.value as ReferralRecord[\'urgency\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Routine\\\">Routine</option>\\n                      <option value=\\\"Priority\\\">Priority</option>\\n                      <option value=\\\"Urgent\\\">Urgent</option>\\n                    </select>\\n                  </div>\\n                </div>\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Clinical Referral Reason</label>\\n                  <textarea\\n                    required\\n                    rows={3}\\n                    value={refReason}\\n                    onChange={(e) => setRefReason(e.target.value)}\\n                    placeholder=\\\"Specify clinical findings, HbA1c, and requested specialist evaluation...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy || !isOnline}\\n                  className=\\\"w-full rounded-xl bg-[#0B2540] py-2.5 font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  Generate Referral Record\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: APPOINTMENTS */}\\n      {subTab === \'appointments\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Scheduled Appointments ({patient?.name})\\n            </h2>\\n            {appointments.map((apt) => (\\n              <div key={apt.id} className=\\\"rounded-xl border border-slate-200 p-4 text-xs space-y-2\\\">\\n                <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                  <span className=\\\"font-bold text-slate-900\\\">{apt.title}</span>\\n                  <span\\n                    className={`font-semibold ${\\n                      apt.status === \'Confirmed\' || apt.status === \'Attended\'\\n                        ? \'text-emerald-700\'\\n                        : apt.status === \'Missed\'\\n                        ? \'text-rose-700\'\\n                        : \'text-amber-700\'\\n                    }`}\\n                  >\\n                    {apt.status}\\n                  </span>\\n                </div>\\n                <div className=\\\"text-slate-600 font-mono text-[11px] tabular-nums\\\">\\n                  {apt.scheduledDate} at {apt.scheduledTime} \302\267 {apt.facility} \302\267 {apt.clinicianName}\\n                </div>\\n                <div className=\\\"flex flex-wrap gap-2 pt-1\\\">\\n                  {isStaff && isOnline && (\\n                    <>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateAppointment(apt.id, \'Confirmed\')}\\n                        className=\\\"rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-800\\\"\\n                      >\\n                        Confirm\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateAppointment(apt.id, \'Attended\')}\\n                        className=\\\"rounded-lg border border-sky-200 bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-800\\\"\\n                      >\\n                        Mark Attended\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => void onUpdateAppointment(apt.id, \'Missed\', true)}\\n                        className=\\\"rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-semibold text-rose-800\\\"\\n                      >\\n                        Mark Missed &amp; Escalate\\n                      </button>\\n                    </>\\n                  )}\\n                  {isOnline && apt.status !== \'Cancelled\' && apt.status !== \'Attended\' && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => void onUpdateAppointment(apt.id, \'Cancelled\')}\\n                      className=\\\"rounded-lg border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:bg-slate-50\\\"\\n                    >\\n                      Cancel\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n\\n          <form\\n            onSubmit={handleCreateApt}\\n            className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5 space-y-3 text-xs\\\"\\n          >\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Schedule Appointment\\n            </h3>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Visit Title</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={aptTitle}\\n                onChange={(e) => setAptTitle(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n              />\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n              <div>\\n                <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Date</label>\\n                <input\\n                  type=\\\"date\\\"\\n                  required\\n                  value={aptDate}\\n                  onChange={(e) => setAptDate(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Time</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={aptTime}\\n                  onChange={(e) => setAptTime(e.target.value)}\\n                  className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                />\\n              </div>\\n            </div>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Appointment Type</label>\\n              <select\\n                value={aptType}\\n                onChange={(e) => setAptType(e.target.value as AppointmentRecord[\'type\'])}\\n                className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n              >\\n                <option value=\\\"Follow-up Consultation\\\">Follow-up Consultation</option>\\n                <option value=\\\"Retinal Screening\\\">Retinal Screening</option>\\n                <option value=\\\"Ophthalmology Referral\\\">Ophthalmology Referral</option>\\n                <option value=\\\"Lab Testing (HbA1c/FPG)\\\">Lab Testing (HbA1c/FPG)</option>\\n              </select>\\n            </div>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Facility</label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={aptFacility}\\n                onChange={(e) => setAptFacility(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Reminder Note</label>\\n              <input\\n                type=\\\"text\\\"\\n                value={aptReminder}\\n                onChange={(e) => setAptReminder(e.target.value)}\\n                className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n              />\\n            </div>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={busy || !isOnline}\\n              className=\\\"w-full rounded-xl bg-[#0D9488] py-2.5 font-semibold text-white hover:bg-[#0F766E] disabled:opacity-50\\\"\\n            >\\n              Book Appointment\\n            </button>\\n          </form>\\n        </div>\\n      )}\\n\\n      {/* TAB 4: CONTINUITY OF CARE & HEALTH-WORKER OWNERSHIP */}\\n      {subTab === \'continuity\' && (\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-5\\\">\\n          <div className=\\\"lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-5 space-y-3\\\">\\n            <h2 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Continuity of Care &amp; Follow-up Timeline\\n            </h2>\\n            {followUps.length === 0 ? (\\n              <p className=\\\"text-xs text-slate-500\\\">No health-worker follow-up records yet.</p>\\n            ) : (\\n              followUps.map((fu) => (\\n                <div key={fu.id} className=\\\"rounded-xl border border-slate-200 p-4 text-xs space-y-1\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"font-bold text-slate-900\\\">\\n                      {fu.healthWorkerName} \302\267 {fu.channel}\\n                    </span>\\n                    <span\\n                      className={`font-semibold ${\\n                        fu.status === \'Escalated\' ? \'text-rose-700\' : \'text-[#0F766E]\'\\n                      }`}\\n                    >\\n                      {fu.status}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"font-mono text-[11px] text-slate-500 tabular-nums\\\">\\n                    Due: {fu.dueDate} {fu.nextScreeningDate ? `\302\267 Next Retinal Screening: ${fu.nextScreeningDate}` : \'\'}\\n                  </div>\\n                  <p className=\\\"text-slate-700\\\">{fu.outcomeNotes}</p>\\n                </div>\\n              ))\\n            )}\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-5\\\">\\n            <h3 className=\\\"font-display text-base font-bold text-[#0B2540]\\\">\\n              Assign Health-Worker Follow-Up\\n            </h3>\\n            {!isStaff ? (\\n              <p className=\\\"mt-2 text-xs text-slate-500\\\">\\n                Follow-up tasks are assigned by Doctors and Health Programme Administrators.\\n              </p>\\n            ) : (\\n              <form onSubmit={handleCreateFollowUp} className=\\\"mt-4 space-y-3 text-xs\\\">\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Health Worker Owner</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={fuWorker}\\n                    onChange={(e) => setFuWorker(e.target.value)}\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Due Date</label>\\n                    <input\\n                      type=\\\"date\\\"\\n                      required\\n                      value={fuDue}\\n                      onChange={(e) => setFuDue(e.target.value)}\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Channel</label>\\n                    <select\\n                      value={fuChannel}\\n                      onChange={(e) => setFuChannel(e.target.value as FollowUpRecord[\'channel\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Phone Call\\\">Phone Call</option>\\n                      <option value=\\\"In-Person PHC\\\">In-Person PHC</option>\\n                      <option value=\\\"Home Visit\\\">Home Visit</option>\\n                    </select>\\n                  </div>\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Status</label>\\n                    <select\\n                      value={fuStatus}\\n                      onChange={(e) => setFuStatus(e.target.value as FollowUpRecord[\'status\'])}\\n                      className=\\\"w-full rounded-lg border border-slate-300 bg-white px-3 py-2\\\"\\n                    >\\n                      <option value=\\\"Scheduled\\\">Scheduled</option>\\n                      <option value=\\\"Completed\\\">Completed</option>\\n                      <option value=\\\"Escalated\\\">Escalated</option>\\n                    </select>\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Next Retinal Screening</label>\\n                    <input\\n                      type=\\\"date\\\"\\n                      value={fuNextScreen}\\n                      onChange={(e) => setFuNextScreen(e.target.value)}\\n                      className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2 font-mono\\\"\\n                    />\\n                  </div>\\n                </div>\\n                <div>\\n                  <label className=\\\"block font-semibold text-slate-700 mb-1\\\">Follow-Up Notes</label>\\n                  <textarea\\n                    required\\n                    rows={3}\\n                    value={fuNotes}\\n                    onChange={(e) => setFuNotes(e.target.value)}\\n                    placeholder=\\\"Record outreach instructions, missed-visit escalation, or specialist feedback...\\\"\\n                    className=\\\"w-full rounded-lg border border-slate-300 px-3 py-2\\\"\\n                  />\\n                </div>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={busy || !isOnline}\\n                  className=\\\"inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#0B2540] py-2.5 font-semibold text-white hover:bg-[#113556] disabled:opacity-50\\\"\\n                >\\n                  <CheckCircle2 className=\\\"h-4 w-4\\\" />\\n                  Save Continuity Follow-Up\\n                </button>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ProtectModule with shared patient longitudinal chart, doctor retinal review & triage, referral tracking, appointments, and continuity-of-care ownership\", \"Overwrite\":true, \"TargetFile\":\"/src/views/ProtectModule.tsx\", \"toolAction\":\"Creating ProtectModule view\", \"toolSummary\":\"Create src/views/ProtectModule.tsx\"}"
      original_name: "write_to_file"
    }
