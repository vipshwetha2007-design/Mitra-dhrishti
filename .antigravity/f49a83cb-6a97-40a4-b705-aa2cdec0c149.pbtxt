    end_line: 59
    content: "import React, { useState } from \'react\';\nimport {\n  AlertTriangle,\n  Calendar,\n  CheckCircle2,\n  ClipboardCheck,\n  Send,\n  Stethoscope,\n  UserCheck,\n} from \'lucide-react\';\nimport type {\n  AppointmentRecord,\n  BootstrapPayload,\n  DoctorReview,\n  FollowUpRecord,\n  ReferralRecord,\n} from \'../types/domain\';\nimport { FundusVisualizer } from \'../components/FundusVisualizer\';\n\ninterface ProtectModuleProps {\n  data: BootstrapPayload;\n  selectedPatientId: string;\n  onSelectPatient: (id: string) => void;\n  isOnline: boolean;\n  onSubmitReview: (payload: {\n    screeningId: string;\n    decision: DoctorReview[\'decision\'];\n    clinicianGrade: string;\n    triageCategory: DoctorReview[\'triageCategory\'];\n    clinicalNotes: string;\n    recommendedNextSteps: string;\n  }) => Promise<void>;\n  onCreateReferral: (payload: {\n    patientId: string;\n    screeningId?: string;\n    targetFacility: string;\n    specialty: ReferralRecord[\'specialty\'];\n    urgency: ReferralRecord[\'urgency\'];\n    reason: string;\n  }) => Promise<void>;\n  onUpdateReferral: (\n    id: string,\n    status: ReferralRecord[\'status\'],\n    specialistFindings?: string\n  ) => Promise<void>;\n  onCreateAppointment: (payload: {\n    patientId: string;\n    title: string;\n    facility: string;\n    clinicianName: string;\n    scheduledDate: string;\n    scheduledTime: string;\n    type: AppointmentRecord[\'type\'];\n    reminderNote: string;\n  }) => Promise<void>;\n  onUpdateAppointment: (\n    id: string,\n    status: AppointmentRecord[\'status\'],\n    escalated?: boolean\n  ) => Promise<void>;"
    num_lines: 901
