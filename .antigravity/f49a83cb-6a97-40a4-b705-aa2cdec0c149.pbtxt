    command_line: "node -e \'\nasync function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }\nasync function main(){\n  let ok = false;\n  for (let i=0;i<15;i++){\n    try {\n      const r = await fetch(\"http://localhost:3000/api/health\");\n      if (r.ok){ ok = true; console.log(\"HEALTH:\", await r.json()); break; }\n    } catch {}\n    await sleep(500);\n  }\n  if (!ok) { console.error(\"Server failed to respond on port 3000\"); process.exit(1); }\n\n  const pAuth = await fetch(\"http://localhost:3000/api/auth/demo-session\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({role:\"patient\"})\n  }).then(r=>r.json());\n  const pBoot = await fetch(\"http://localhost:3000/api/bootstrap\", {\n    headers:{Authorization:\"Bearer \"+pAuth.token}\n  }).then(r=>r.json());\n  console.log(\"PATIENT_SCOPE_COUNT:\", pBoot.patients.length, \"ROLE:\", pBoot.user.role);\n\n  const rbacDeny = await fetch(\"http://localhost:3000/api/audit-logs\", {\n    headers:{Authorization:\"Bearer \"+pAuth.token}\n  });\n  console.log(\"PATIENT_AUDIT_LOGS_STATUS:\", rbacDeny.status);\n\n  const dAuth = await fetch(\"http://localhost:3000/api/auth/demo-session\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({role:\"doctor\"})\n  }).then(r=>r.json());\n  const dBoot = await fetch(\"http://localhost:3000/api/bootstrap\", {\n    headers:{Authorization:\"Bearer \"+dAuth.token}\n  }).then(r=>r.json());\n  console.log(\"DOCTOR_SCOPE_COUNT:\", dBoot.patients.length);\n\n  const dAudit = await fetch(\"http://localhost:3000/api/audit-logs\", {\n    headers:{Authorization:\"Bearer \"+dAuth.token}\n  });\n  const logs = await dAudit.json();\n  console.log(\"DOCTOR_AUDIT_STATUS:\", dAudit.status, \"HAS_RBAC_DENY_LOG:\", logs.some(l=>l.action===\"RBAC_ACCESS_DENIED\"));\n\n  const key = \"verify-idem-\" + Date.now();\n  const payload = {\n    actions: [{\n      idempotencyKey: key,\n      type: \"HABIT_LOG\",\n      createdAt: new Date().toISOString(),\n      payload: {\n        patientId: \"pat-1\",\n        date: \"2026-11-22\",\n        healthyIndianDiet: true,\n        stepsAchieved: 7600,\n        sleepHours: 7.5\n      }\n    }]\n  };\n  const sync1 = await fetch(\"http://localhost:3000/api/sync/batch\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\", Authorization:\"Bearer \"+pAuth.token},\n    body: JSON.stringify(payload)\n  }).then(r=>r.json());\n  const sync2 = await fetch(\"http://localhost:3000/api/sync/batch\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\", Authorization:\"Bearer \"+pAuth.token},\n    body: JSON.stringify(payload)\n  }).then(r=>r.json());\n  console.log(\"SYNC_FIRST:\", sync1.results[0].status, \"SYNC_REPLAY:\", sync2.results[0].status);\n\n  const html = await fetch(\"http://localhost:3000/\").then(r=>r.text());\n  console.log(\"HTML_TITLE_OK:\", html.includes(\"Mritidhristi\"));\n}\nmain().catch(e=>{console.error(e); process.exit(1);});\n\' && ls -la package-lock.json bun.lock 2>/dev/null || true"
    proposed_command_line: "node -e \'\nasync function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }\nasync function main(){\n  let ok = false;\n  for (let i=0;i<15;i++){\n    try {\n      const r = await fetch(\"http://localhost:3000/api/health\");\n      if (r.ok){ ok = true; console.log(\"HEALTH:\", await r.json()); break; }\n    } catch {}\n    await sleep(500);\n  }\n  if (!ok) { console.error(\"Server failed to respond on port 3000\"); process.exit(1); }\n\n  const pAuth = await fetch(\"http://localhost:3000/api/auth/demo-session\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({role:\"patient\"})\n  }).then(r=>r.json());\n  const pBoot = await fetch(\"http://localhost:3000/api/bootstrap\", {\n    headers:{Authorization:\"Bearer \"+pAuth.token}\n  }).then(r=>r.json());\n  console.log(\"PATIENT_SCOPE_COUNT:\", pBoot.patients.length, \"ROLE:\", pBoot.user.role);\n\n  const rbacDeny = await fetch(\"http://localhost:3000/api/audit-logs\", {\n    headers:{Authorization:\"Bearer \"+pAuth.token}\n  });\n  console.log(\"PATIENT_AUDIT_LOGS_STATUS:\", rbacDeny.status);\n\n  const dAuth = await fetch(\"http://localhost:3000/api/auth/demo-session\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify({role:\"doctor\"})\n  }).then(r=>r.json());\n  const dBoot = await fetch(\"http://localhost:3000/api/bootstrap\", {\n    headers:{Authorization:\"Bearer \"+dAuth.token}\n  }).then(r=>r.json());\n  console.log(\"DOCTOR_SCOPE_COUNT:\", dBoot.patients.length);\n\n  const dAudit = await fetch(\"http://localhost:3000/api/audit-logs\", {\n    headers:{Authorization:\"Bearer \"+dAuth.token}\n  });\n  const logs = await dAudit.json();\n  console.log(\"DOCTOR_AUDIT_STATUS:\", dAudit.status, \"HAS_RBAC_DENY_LOG:\", logs.some(l=>l.action===\"RBAC_ACCESS_DENIED\"));\n\n  const key = \"verify-idem-\" + Date.now();\n  const payload = {\n    actions: [{\n      idempotencyKey: key,\n      type: \"HABIT_LOG\",\n      createdAt: new Date().toISOString(),\n      payload: {\n        patientId: \"pat-1\",\n        date: \"2026-11-22\",\n        healthyIndianDiet: true,\n        stepsAchieved: 7600,\n        sleepHours: 7.5\n      }\n    }]\n  };\n  const sync1 = await fetch(\"http://localhost:3000/api/sync/batch\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\", Authorization:\"Bearer \"+pAuth.token},\n    body: JSON.stringify(payload)\n  }).then(r=>r.json());\n  const sync2 = await fetch(\"http://localhost:3000/api/sync/batch\", {\n    method:\"POST\", headers:{\"Content-Type\":\"application/json\", Authorization:\"Bearer \"+pAuth.token},\n    body: JSON.stringify(payload)\n  }).then(r=>r.json());\n  console.log(\"SYNC_FIRST:\", sync1.results[0].status, \"SYNC_REPLAY:\", sync2.results[0].status);\n\n  const html = await fetch(\"http://localhost:3000/\").then(r=>r.text());\n  console.log(\"HTML_TITLE_OK:\", html.includes(\"Mritidhristi\"));\n}\nmain().catch(e=>{console.error(e); process.exit(1);});\n\' && ls -la package-lock.json bun.lock 2>/dev/null || true"
