      thinking_signature: "\022\371\021\n\366\021\001i\024}\023\364%\347\355\241\235U\vx\201l\235s\275\234\276\376q\370?1^\340|\317\177*Qe!R\372\017:\311\214\316\002\365rA\324fH\245\304>\236\301\322\002\020b\027\252\246\264\334|\252,p@\272\311P%%\001w\370]\222.\307\327_m\364jU\220\244\307n\031\243\037\270z\364\315.\025\022i\221\204\367\206\306\327\203>\3768 \2715\210\226\361q\330\000Nie\262\356I\323\275\312\033\025\032]m\361\373\241\307\223n\374F\376<\0254!\0311\025\304\226\367OZ\200\220_N\233\247\205\323\030\227\3679as\234:Q}\017l\033I\253PJ`>#\001\256\244\005{v\t\336^\220\\\335\365\313![\374>1\321\267\271u\220\262YeSQ\023Y\035N*\0036\211\r\024k\223\263u\224-8g\226\337S\342\026u\227\f4\371$\037\373\035\027\001|\017\214\277]\220S_h\001\367*1\236\207\337g\017\234j\217g)\337\3150\321\251\200\375J`2)\371!\357S\320\355\352\344\313\340d\361\273\374:\307\r\332\017e\321]\303\224q\242\031\316\037G\346:\341&\357\342)5\227\250\332\aR\372 \221h\250\030lD9\346\265\233~\002\255%>\217\307h\305\272d=Lr0\361OO\321\336\361n\001\003\f\244R\000\257\317TM.\242\350\374\252\t\263M\356;\305\335Z\202\213,\004 \232\t\f\217[\277\333\177\332\r\210\\\364\337\216\343\221\n\2626!/(\2758\210\344E\371\265\271\224OL\303\242sDk\371\202\333G\271\025Iv\204g\037\v\247\207#\333/2\212\037\332bk\245\265\265\214l\226\v\3020\367\277\001\253P\360\250\021*\331\035\310\252\370\001x\230D)\237\350\324\205\325\227e\276{ew\334\276$\264JH\237\a8X\356o\000\200<\243\207SaC\351\244%#\'\313=\rxN\301rY\\s0\"\276T\336G^\026\222*M\024\206\252\242\v|\377B\363o\211l\256\036\350\274\200\3177\275\326G\360\375\3730Z\f\006\023\217x\346|u\212\001\206\020\243\222\001@mgQ:Q\025-6\316\237!n\351x\330*\213k\237QVQ\030\251\205\212\215\210\325*\254\376U\323\200\275/\2456\214\353\313z\354C\211\320\252\223\271\220\210\r+\a\371\333\3278\230\272\f\330\177my\274A\017\312?\336\005\2563\v\274\022,\325\210\200\231\256\242f\355d\361\265\342\254\000\035\303\216S\271*\330y\247\241\316\354\274\002\244,L\006-a\021p\251!\216;\030\362V\302L\035\242\3